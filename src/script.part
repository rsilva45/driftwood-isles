// The floating window loads the game in a frame with ?popout=1; this tab then pauses and stops
// saving so the two copies never overwrite each other, and reloads when the window closes.
const POPOUT = new URLSearchParams(location.search).has('popout');
let POPPED = false, pipWin = null;

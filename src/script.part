<script>
"use strict";
/* =====================================================================
   Driftwood Isles
   Two modes share one 320x180 pixel canvas:
   - travel: a top-down, procedurally generated archipelago you sail
   - fish:   the side-view cross-section, built from the water depth
             under the boat wherever you stop
   ===================================================================== */
const W = 320, H = 180, SURF = 60, FT = 4, TS = 4;
let LAKE_FT = 30, ABYSS = false, ZONE = 0, BIOME = 4, HOT = false, BED_Y = SURF + 120, WORLD_H = BED_Y + 24, CAM_MAX = 0;

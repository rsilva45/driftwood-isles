];
const NET_ESCAPE = [0, 0, .15, .4, .7, .9]; // chance a fish of each rarity tears free
const DYN = {
  stick: 220, sink: 9, // coins per stick, sinking speed in ft per second
  fuse:   [{v:2, price:0}, {v:3, price:450},  {v:4.5, price:1000}, {v:6, price:2000}],   // seconds
  radius: [{v:18, price:0},{v:26, price:550}, {v:34, price:1200},  {v:44, price:2400}],  // pixels (4 px = 1 ft)
  bag:    [{v:3, price:0}, {v:5, price:350},  {v:8, price:800},    {v:12, price:1600}],  // sticks carried
};
// deepest the stick can get before its fuse runs out; the player picks any depth above that
const dynBoomDepth = (lv = S.dyn.fuse) => Math.max(2, DYN.sink*(DYN.fuse[lv].v - .6));
// Firearms. Each has its own art, magazine, ammo and upgrade path. Ranges are in feet of water.

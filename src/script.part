      {name:'Polished Revolver',  dmg:1, reload:1.5, cool:.32, range:50, price:1200, desc:'Oiled and balanced. Reloads faster and fires quicker.'},
      {name:"Gunsmith's Special", dmg:2, reload:1.1, cool:.28, range:50, price:2600, desc:'Heavier rounds. Each shot counts double against monsters.'},
      {name:'Peacemaker',         dmg:2, reload:.7,  cool:.18, range:50, price:5200, desc:'The finest six-shooter on the water. Fast hands, fast reload.'},
    ]},
  shotgun:{label:'Shotgun', key:'5', mag:4, auto:true, speed:800, pierce:false, ammoName:'Shotgun shells', ammoPrice:25, ammoMax:60, packs:[4,20],
    blurb:'Fires a cone of pellets that spreads with distance. Pellets give out around 30 ft.',
    tiers:[
      {name:'Old Scattergun',  pellets:5,  spread:24, dmg:.4,  reload:2.6, cool:.7,  range:30, price:900,  desc:'Wide, wild and loud. Great for schools of small fish.'},
      {name:'Pump Shotgun',    pellets:7,  spread:18, dmg:.4,  reload:2.1, cool:.6,  range:30, price:1800, desc:'More pellets in a tighter cone.'},
      {name:'Choked Shotgun',  pellets:9,  spread:12, dmg:.45, reload:1.7, cool:.55, range:32, price:3400, desc:'A choked barrel keeps the pellets together.'},
      {name:'Riot Gun',        pellets:12, spread:7,  dmg:.5,  reload:1.3, cool:.5,  range:35, price:6000, desc:'A wall of lead in a narrow cone.'},
    ]},
  sniper:{label:'Sniper rifle', key:'6', mag:1, auto:false, speed:1500, pellets:1, pierce:true, ammoName:'Rifle rounds', ammoPrice:60, ammoMax:40, packs:[2,10],
    blurb:'One shot, reloaded by hand. Rounds pierce through every target in their path and reach far deeper than any other gun.',
    tiers:[
      {name:'Hunting Rifle',   dmg:2, reload:2.4, cool:.3, range:120, price:1500, desc:'Reaches 120 ft and punches straight through fish.'},
      {name:'Marksman Rifle',  dmg:2, reload:1.9, cool:.3, range:180, price:3000, desc:'Heavier rounds that keep their speed to 180 ft.'},
      {name:'Deepwater Rifle', dmg:3, reload:1.4, cool:.3, range:260, price:5500, desc:'Built for deep sea. Good to 260 ft.'},
      {name:'Abyss Piercer',   dmg:3, reload:.9,  cool:.3, range:400, price:9000, desc:'Nothing in the water is out of reach. 400 ft.'},
    ]},
};
WEAPONS.lightning = {label:'Lightning gun', key:'7', mag:1, auto:true, bolt:true, speed:0, pierce:false,
  ammoName:'Power cells', ammoPrice:80, ammoMax:30, packs:[2,10],
  ammo2Name:'Delayed power cells', ammo2Price:140, ammo2Max:15, packs2:[1,5],
  blurb:'Fires one powerful bolt of lightning that jumps from fish to fish. Delayed cells fire a charge deep into the water that bursts into a storm of lightning.',
  tiers:[ // shots: how many bolts one power cell powers. chains: jumps per bolt. jump: how far a bolt can jump (px). burst: delayed-cell kill radius (px)
    {name:'Spark Caster',  dmg:1, shots:1, chains:2, jump:26, burst:14, reload:2.0, cool:1.0, range:60,  price:2500,  desc:'A crackling prototype. One bolt per cell, two jumps.'},
    {name:'Storm Caster',  dmg:1, shots:2, chains:3, jump:32, burst:17, reload:1.7, cool:.85, range:80,  price:4800,  desc:'Better coils: two bolts from every cell and a longer reach.'},
    {name:'Tempest Rod',   dmg:2, shots:2, chains:5, jump:38, burst:20, reload:1.4, cool:.7,  range:110, price:8000,  desc:'Bolts hit harder and leap between five fish.'},
    {name:'Thunderhead',   dmg:2, shots:3, chains:7, jump:46, burst:24, reload:1.0, cool:.55, range:150, price:12500, desc:'A storm in your hands. Three bolts per cell, seven jumps.'},
  ]};
const WEAPON_IDS = Object.keys(WEAPONS);
const magOf = id => wTier(id).shots || WEAPONS[id].mag;   // rounds a full load holds (the lightning gun: bolts per cell)
const isGun = t => !!WEAPONS[t];
const GUN_K = 2;                       // weapon art is drawn at half size on a finer overlay
const WS = id => S.weapons[id];        // saved state: level, spare ammo, loaded rounds
const wTier = id => WEAPONS[id].tiers[Math.max(0, WS(id).lvl)];
const dynMaxDepth = () => Math.min(dynBoomDepth(), LAKE_FT - 1);
function aimDepth(){ return T.hover ? clamp((T.hover.y + camY - SURF)/FT, .5, dynMaxDepth()) : Math.min(10, dynMaxDepth()); }

/* ================== Save ================== */
function defaults(){ return {coins:25, inv:[], rod:0, bait:0, boat:0, owned:{rod:[0],bait:[0],boat:[0]}, custom:[], caught:{}, sound:true, shake:!REDUCED, world:null, net:-1, dyn:{count:0, fuse:0, radius:0, bag:0}, weapons:defaultWeapons(), clock:8*60, light:-1, seen:{}}; }
function defaultWeapons(){ return {revolver:{lvl:-1, ammo:0, mag:0}, shotgun:{lvl:-1, ammo:0, mag:0}, sniper:{lvl:-1, ammo:0, mag:0}, lightning:{lvl:-1, ammo:0, mag:0, ammo2:0, alt:false}}; }
function load(){
  try{
    const raw = localStorage.getItem(SAVE_KEY);
    if(!raw) return defaults();
    const d = Object.assign(defaults(), JSON.parse(raw));
    d.owned = Object.assign({rod:[0],bait:[0],boat:[0]}, d.owned || {});
    d.dyn = Object.assign({count:0, fuse:0, radius:0, bag:0}, d.dyn || {}); d.light = clamp(Number.isFinite(d.light) ? d.light|0 : -1, -1, LIGHTS.length-1); if(typeof d.net !== 'number') d.net = -1;
    // older saves kept the revolver in gun/ammo/cyl
    const wd = defaultWeapons(); d.weapons = Object.assign(wd, d.weapons || {});
    if(typeof d.gun === 'number' && d.gun >= 0 && d.weapons.revolver.lvl < 0) d.weapons.revolver = {lvl:d.gun, ammo:d.ammo|0, mag:d.cyl|0};
    delete d.gun; delete d.ammo; delete d.cyl;
    for(const id of Object.keys(wd)){ const w = d.weapons[id] = Object.assign({}, wd[id], d.weapons[id]); w.lvl = clamp(w.lvl|0, -1, 3); w.ammo = Math.max(0, w.ammo|0); w.mag = Math.max(0, w.mag|0); if('ammo2' in wd[id]){ w.ammo2 = Math.max(0, w.ammo2|0); w.alt = !!w.alt; } }
    d.clock = Number.isFinite(d.clock) ? ((d.clock % 1440) + 1440) % 1440 : 8*60;
    if(!d.seen || typeof d.seen !== 'object') d.seen = {};
    d.rod = clamp(d.rod|0, 0, RODS.length-1); d.bait = clamp(d.bait|0, 0, BAITS.length-1); d.boat = clamp(d.boat|0, 0, BOATS.length-1);
    return d;
  }catch(e){ return defaults(); }
}
function save(){
  if(POPPED) return true;   // the pop-out window owns the save while it's open
  try{ localStorage.setItem(SAVE_KEY, JSON.stringify(S)); lastSavedAt = Date.now(); queueFileSync(); return true; }
  catch(e){ toast("Couldn't save: browser storage is full. Delete a custom fish or use smaller images."); return false; }
}

/* ================== Save file on the player's computer ==================
   Progress always saves to this browser. A save file is a second copy that survives
   clearing browser data or switching browsers. Where the browser allows it, the game
   keeps that file updated while you play. */
var lastSavedAt = 0, fileHandle = null, fileLive = false, fileSyncT = null, fileSavedAt = 0;
const canPickFiles = typeof window.showSaveFilePicker === 'function';
function idb(){ return new Promise((res, rej) => { const r = indexedDB.open('driftwood-isles', 1); r.onupgradeneeded = () => r.result.createObjectStore('kv'); r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); }); }
async function idbSet(k, v){ const db = await idb(); return new Promise((res, rej) => { const tx = db.transaction('kv', 'readwrite'); tx.objectStore('kv').put(v, k); tx.oncomplete = res; tx.onerror = () => rej(tx.error); }); }
async function idbGet(k){ const db = await idb(); return new Promise((res, rej) => { const q = db.transaction('kv').objectStore('kv').get(k); q.onsuccess = () => res(q.result); q.onerror = () => rej(q.error); }); }
function queueFileSync(){ if(!fileHandle || !fileLive) return; clearTimeout(fileSyncT); fileSyncT = setTimeout(writeSaveFile, 1500); }
async function writeSaveFile(){
  if(!fileHandle) return false;
  try{ const w = await fileHandle.createWritable(); await w.write(JSON.stringify(S)); await w.close(); fileSavedAt = Date.now(); renderSaveStatus(); return true; }
  catch(e){ fileLive = false; renderSaveStatus(`Couldn't write to ${fileHandle.name}. Click "Save to a file" to pick it again.`); return false; }
}
async function saveToFile(){
  if(window.__game && WORLD) saveWorld(); else save();
  if(canPickFiles){
    try{
      fileHandle = await window.showSaveFilePicker({suggestedName:'driftwood-isles-save.json', types:[{description:'Driftwood Isles save', accept:{'application/json':['.json']}}]});
      fileLive = true; await writeSaveFile();
      try{ await idbSet('saveFile', fileHandle); }catch(e){}
      toast(`Saved to ${fileHandle.name}. It will stay updated while you play.`);
    }catch(e){ if(e && e.name !== 'AbortError') downloadSave(); }
  } else downloadSave();
  renderSaveStatus();
}
function downloadSave(){
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([JSON.stringify(S)], {type:'application/json'}));
  a.download = `driftwood-isles-save-${new Date().toISOString().slice(0,10)}.json`; a.click();
  fileSavedAt = Date.now(); toast('Save file downloaded. Load it from Settings any time.');
}
async function reconnectFile(){
  if(!fileHandle) return;
  try{ const perm = await fileHandle.requestPermission({mode:'readwrite'}); if(perm === 'granted'){ fileLive = true; await writeSaveFile(); toast(`Reconnected. ${fileHandle.name} is being kept up to date.`); } }
  catch(e){}
  renderSaveStatus();
}
async function restoreFileHandle(){
  if(!canPickFiles) return;
  try{ const h = await idbGet('saveFile'); if(!h) return; fileHandle = h; fileLive = (await h.queryPermission({mode:'readwrite'})) === 'granted'; renderSaveStatus(); }catch(e){}
}
let pendingLoad = null;
function readSaveFile(file){
  const fr = new FileReader();
  fr.onload = () => {
    try{
      const d = JSON.parse(fr.result);
      if(typeof d !== 'object' || typeof d.coins !== 'number' || !Array.isArray(d.inv)) throw new Error('shape');
      pendingLoad = fr.result;
      renderSaveStatus(`Ready to load ${file.name}: ${d.coins.toLocaleString('en-US')} coins, ${d.inv.length} fish in the hold${d.world ? `, ${d.world.size} map` : ''}.`, true);
    }catch(e){ pendingLoad = null; renderSaveStatus(`${file.name} isn't a Driftwood Isles save file. Pick the .json file you saved from this game.`); }
  };
  fr.readAsText(file);
}
function applyPendingLoad(){
  if(!pendingLoad) return;
  try{ localStorage.setItem(SAVE_KEY, pendingLoad); }catch(e){ renderSaveStatus("Couldn't load: browser storage is full."); return; }
  location.reload();
}
const timeLabel = t => new Date(t).toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit'});
function renderSaveStatus(msg, offerLoad){
  const el = document.getElementById('saveStatus'); if(!el) return;
  const lines = [];
  if(msg) lines.push(msg);
  else {
    lines.push(lastSavedAt ? `Saved in this browser at ${timeLabel(lastSavedAt)}.` : 'Progress saves in this browser automatically.');
    if(fileHandle && fileLive) lines.push(`Also keeping ${fileHandle.name} up to date${fileSavedAt ? `, last written at ${timeLabel(fileSavedAt)}` : ''}.`);
    else if(fileHandle) lines.push(`${fileHandle.name} isn't being updated right now. Click "Reconnect save file" to resume.`);
    else if(fileSavedAt) lines.push(`Last save file made at ${timeLabel(fileSavedAt)}.`);
  }
  el.textContent = lines.join(' ');
  document.getElementById('reconnectFile').hidden = !(fileHandle && !fileLive);
  document.getElementById('confirmLoad').hidden = !offerLoad;
}

/* ================== Helpers ================== */
const $ = id => document.getElementById(id);
const rand = (a,b) => a + Math.random()*(b-a);
function clamp(v,a,b){ return Math.max(a, Math.min(b, v)); }
const lerp = (a,b,t) => a + (b-a)*t;
const ease = t => t<.5 ? 2*t*t : 1 - Math.pow(-2*t+2, 2)/2;
const smooth = (a,b,x) => { const t = clamp((x-a)/(b-a),0,1); return t*t*(3-2*t); };
function hexToRgb(h){ h=h.replace('#',''); if(h.length===3) h=h.split('').map(c=>c+c).join(''); const n=parseInt(h,16); return [n>>16&255, n>>8&255, n&255]; }
function shade(h,f){ const [r,g,b]=hexToRgb(h); const m=v=>Math.max(0,Math.min(255,Math.round(f<0? v*(1+f) : v+(255-v)*f))); return '#'+[m(r),m(g),m(b)].map(v=>v.toString(16).padStart(2,'0')).join(''); }
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt = n => n.toLocaleString('en-US');
const hash = s => { let h=0; for(const c of String(s)) h=(h*31 + c.charCodeAt(0))|0; return Math.abs(h); };
const hash2 = (x,y) => { let h = (x*374761393 + y*668265263)|0; h = (h^(h>>>13))*1274126177|0; return (h^(h>>>16))>>>0; };
function mulberry32(a){ return function(){ a|=0; a=a+0x6D2B79F5|0; let t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
function lerpColor(stops, d){ for(let i=0;i<stops.length-1;i++){ const [a,ca]=stops[i], [b,cb]=stops[i+1]; if(d<=b){ const k=clamp((d-a)/(b-a||1),0,1), A=hexToRgb(ca), B=hexToRgb(cb); return A.map((v,j)=>Math.round(lerp(v,B[j],k))); } } return hexToRgb(stops[stops.length-1][1]); }
function toB64(u8){ let s=''; for(let i=0;i<u8.length;i+=8192) s += String.fromCharCode.apply(null, u8.subarray(i, i+8192)); return btoa(s); }
function fromB64(b, n){ const s=atob(b), u=new Uint8Array(n); for(let i=0;i<Math.min(n,s.length);i++) u[i]=s.charCodeAt(i); return u; }

let S = load();
const invWeight = () => S.inv.reduce((a,f)=>a+f.w, 0);
const boat = () => BOATS[S.boat], rod = () => RODS[S.rod], bait = () => BAITS[S.bait];

/* ================== Perlin noise (standalone) ================== */
function makeNoise(seed){
  const rnd = mulberry32(seed), perm = [...Array(256).keys()];
  for(let i=255;i>0;i--){ const j=Math.floor(rnd()*(i+1)); [perm[i],perm[j]]=[perm[j],perm[i]]; }
  const p = new Uint8Array(512); for(let i=0;i<512;i++) p[i]=perm[i&255];
  const G2 = [[1,0],[-1,0],[0,1],[0,-1],[.7071,.7071],[-.7071,.7071],[.7071,-.7071],[-.7071,-.7071]];
  const fade = t => t*t*t*(t*(t*6-15)+10);
  const dot = (h,x,y) => { const g=G2[h&7]; return g[0]*x + g[1]*y; };
  return (x,y) => {
    const xi=Math.floor(x), yi=Math.floor(y), X=xi&255, Y=yi&255, xf=x-xi, yf=y-yi, u=fade(xf), v=fade(yf);
    const aa=p[p[X]+Y], ab=p[p[X]+Y+1], ba=p[p[X+1]+Y], bb=p[p[X+1]+Y+1];
    return lerp(lerp(dot(aa,xf,yf), dot(ba,xf-1,yf), u), lerp(dot(ab,xf,yf-1), dot(bb,xf-1,yf-1), u), v) / .7071;
  };
}
function fbm(n, x, y, oct){ let s=0, a=1, f=1, t=0; for(let i=0;i<oct;i++){ s += n(x*f, y*f)*a; t += a; a *= .5; f *= 2.03; } return s/t*.5 + .5; }

/* ================== World generation ================== */
// Depth grows with distance from the starting island, in tiles
const DEPTH_CURVE = [[0,20],[.2,34],[.4,100],[.62,220],[.86,380],[1.6,450]];
const depthAt = t => { const r = t; for(let i=0;i<DEPTH_CURVE.length-1;i++){ const [a,da]=DEPTH_CURVE[i], [b,db]=DEPTH_CURVE[i+1]; if(r<=b) return lerp(da,db,(r-a)/(b-a)); } return 450; };
const MAP_WATER = [[0,'#63d2cf'],[30,'#3aa9bf'],[60,'#2a86ad'],[120,'#1f6499'],[220,'#16457b'],[350,'#0d2a56'],[460,'#081a3a']];
const BANDS = [25,35,50,75,100,150,200,275,350,420];
const bandOf = d => { let i=0; while(i<BANDS.length && d>BANDS[i]) i++; return i; };
const ABYSS_D = 9999;

let WORLD = null;
// Biome regions: the starting shallows sit in the middle and seven large wedges fan out around them,
// clockwise from the frozen north. Each wedge shapes its own depth and how many islands it has.
const SECTORS = ['frozen','kelp','open','deep','volcanic','reef','mangrove'];
const SECTOR_RULES = { // depth floor and cap in ft, how much land (negative = more islands)
  shallows:{lo:8,   hi:38,   land:0},
  mangrove:{lo:8,   hi:28,   land:-.11},
  reef:    {lo:8,   hi:46,   land:-.02},
  kelp:    {lo:30,  hi:130,  land:0},
  open:    {lo:30,  hi:9999, land:.02},
  deep:    {lo:150, hi:9999, land:.12},
  volcanic:{lo:40,  hi:9999, land:-.02},
  frozen:  {lo:8,   hi:9999, land:0},
};
function regionAt(x, y, N, nW, nR2){
  const cx = N/2, cy = N/2, dx = x-cx, dy = y-cy, r = Math.hypot(dx, dy);
  const core = N*.13 + (fbm(nR2, x/12, y/12, 3) - .5)*N*.07; // the starting shallows
  if(r < core) return {b:'shallows', w:null, wk:0};
  const warp = (fbm(nW, x/22, y/22, 3) - .5)*1.6;
  let a = Math.atan2(dy, dx) + Math.PI/2 + warp; a = ((a % (Math.PI*2)) + Math.PI*2) % (Math.PI*2); // 0 = north, clockwise
  const n = SECTORS.length, f = a/(Math.PI*2)*n, i = Math.floor(f) % n, fr = f - Math.floor(f);
  // near a border, blend the depth with the neighbor so the sea floor doesn't jump
  const edge = .18; let w = null, wk = 0;
  if(fr < edge){ w = SECTORS[(i+n-1)%n]; wk = .5*(1 - fr/edge); }
  else if(fr > 1-edge){ w = SECTORS[(i+1)%n]; wk = .5*(1 - (1-fr)/edge); }
  // and blend toward the shallows just outside the core
  const ck = clamp(1 - (r - core)/(N*.05), 0, 1);
  return {b:SECTORS[i], w, wk, ck};
}
function genWorld(size, seed){
  const N = MAP_N[size], noise = makeNoise(seed), noise2 = makeNoise(seed ^ 0x5bd1e995), rnd = mulberry32(seed ^ 0x27d4eb2d);
  const nW = makeNoise(seed ^ 0x1f3a9b), nR2 = makeNoise(seed ^ 0x2b77d4);
  const cx = N/2, cy = N/2, MAXD = MAX_DEPTH[size];
  const land = new Uint8Array(N*N), depth = new Float32Array(N*N), biome = new Uint8Array(N*N), cold = new Uint8Array(N*N);
  const fit = (d, b) => { const R = SECTOR_RULES[b]; return clamp(d, Math.min(R.lo, MAXD*.6), Math.min(R.hi, MAXD)); };
  for(let y=0;y<N;y++) for(let x=0;x<N;x++){
    const i = y*N+x, r = Math.hypot(x-cx, y-cy), reg = regionAt(x, y, N, nW, nR2), R = SECTOR_RULES[reg.b];
    const landBias = reg.w ? lerp(R.land, SECTOR_RULES[reg.w].land, reg.wk) : R.land;
    let e = fbm(noise, x/22, y/22, 4);
    e += .5*Math.max(0, 1 - r/8);                 // starting island
    e -= .16*Math.max(0, 1 - Math.abs(r-14)/6);  // open water around it
    const edge = Math.min(x, y, N-1-x, N-1-y); if(edge < 5) e -= (5-edge)*.12;
    const th = .62 + .09*Math.min(1, r/80) + (r > 20 ? landBias : 0);
    if(e > th) land[i] = e > th+.24 ? 4 : e > th+.15 ? 3 : e > th+.06 ? 2 : 1;
    let d = Math.min(MAXD, depthAt(r/(N/2))*(.88 + .24*fbm(noise2, x/14, y/14, 3)));
    // each region keeps its sea floor in its own range, blended at the borders
    let dd = fit(d, reg.b);
    if(reg.w) dd = lerp(dd, fit(d, reg.w), reg.wk);
    if(reg.ck) dd = lerp(dd, fit(d, 'shallows'), reg.ck*.8);
    d = dd;
    const k = clamp((th - e)/.18, 0, 1);
    d = Math.max(8, d*(.35 + .65*k));
    if(reg.b==='deep') d = Math.max(d, Math.min(120, MAXD*.5)*(.4 + .6*k)); // deep water drops away fast from its few islands
    if(size==='large' && reg.b==='deep' && r > N*.4 && k > .55) d = ABYSS_D;
    depth[i] = land[i] ? 0 : d;
    biome[i] = d >= ABYSS_D ? B.abyss : B[reg.b];
    cold[i] = reg.b==='frozen' ? 1 : 0;
  }
  // Harbor: walk east from the island center to the first water tile
  let hx = Math.floor(cx), hy = Math.floor(cy);
  while(hx < N-2 && land[hy*N+hx+1]) hx++;
  const harbor = {x:hx, y:hy, wx:(hx+.5)*TS, wy:(hy+.5)*TS};
  const spawn = {x:(hx+3.5)*TS, y:(hy+.5)*TS};
  // Hot spots spread from the shallows out to the far edges
  const K = SPOTS_N[size], spots = [], maxR = N*.62;
  for(let k=0;k<K;k++){
    for(let tries=0; tries<300; tries++){
      const r = lerp(12, maxR, (k + rnd())/K), a = rnd()*Math.PI*2;
      const x = Math.round(cx + Math.cos(a)*r), y = Math.round(cy + Math.sin(a)*r);
      if(x<4||y<4||x>N-5||y>N-5) continue;
      if(land[y*N+x]) continue;
      if(spots.some(s => Math.hypot(s.x-x, s.y-y) < 9)) continue;
      spots.push({x, y, wx:(x+.5)*TS, wy:(y+.5)*TS, ph:rnd()*5, found:false}); break;
    }
  }
  const w = {size, seed, N, land, depth, biome, cold, harbor, spawn, spots, fog:new Uint8Array(N*N)};
  renderMap(w);
  w.fogC = document.createElement('canvas'); w.fogC.width=N; w.fogC.height=N;
  w.fogG = w.fogC.getContext('2d'); w.fogImg = w.fogG.createImageData(N, N);
  for(let i=0;i<N*N;i++){ w.fogImg.data[i*4]=8; w.fogImg.data[i*4+1]=14; w.fogImg.data[i*4+2]=26; w.fogImg.data[i*4+3]=255; }
  w.fogDirty = true;
  return w;
}
function renderMap(w){
  const N = w.N, PW = N*TS, c = document.createElement('canvas'); c.width = PW; c.height = PW;
  const g = c.getContext('2d'), img = g.createImageData(PW, PW), D = img.data;
  const LAND = {1:[hexToRgb('#e6d199'),hexToRgb('#d4bc82')], 2:[hexToRgb('#77b25c'),hexToRgb('#679f4f')], 3:[hexToRgb('#3f7a46'),hexToRgb('#2d5d36')], 4:[hexToRgb('#8d8a7c'),hexToRgb('#a5a293')]};
  const SAND = LAND[1][0], TREE = [36,74,44], FOAM = [168,236,234];
  const bandColor = []; for(let b=0;b<=BANDS.length;b++){ const lo = b ? BANDS[b-1] : 15, hi = BANDS[b] ?? 460; bandColor.push(lerpColor(MAP_WATER, (lo+hi)/2)); }
  // each biome tints the depth colors toward its own shade of blue
  const bioBand = BIOMES.map(bi => { const t = hexToRgb(bi.map); return bandColor.map((c, b) => { const k = bi.k*(bi.id==='deep' || bi.id==='frozen' ? 1 : 1 - b/(BANDS.length+3)); return c.map((v,j) => Math.round(lerp(v, t[j], k))); }); });
  const SNOW = [236,244,248], SNOW2 = [214,228,236];
  const band = new Int8Array(N*N); for(let i=0;i<N*N;i++) band[i] = w.land[i] ? -1 : w.depth[i] >= ABYSS_D ? 99 : bandOf(w.depth[i]);
  const DX = [0,1,0,-1], DY = [-1,0,1,0];
  for(let ty=0; ty<N; ty++) for(let tx=0; tx<N; tx++){
    const i = ty*N+tx, L = w.land[i], b = band[i];
    // neighbor info for this tile, computed once
    let coast = false; const nLand = [false,false,false,false], nShallower = [false,false,false,false], nBio = [false,false,false,false], bi = w.biome[i];
    for(let k=0;k<4;k++){ const nx=tx+DX[k], ny=ty+DY[k]; if(nx<0||ny<0||nx>=N||ny>=N) continue; const n=ny*N+nx;
      if(w.land[n]) nLand[k] = true; else { coast = true; if(band[n] < b) nShallower[k] = true; if(w.biome[n] !== w.biome[i]) nBio[k] = true; } }
    const anyLand = nLand[0]||nLand[1]||nLand[2]||nLand[3];
    for(let py=0; py<TS; py++) for(let ppx=0; ppx<TS; ppx++){
      const X = tx*TS+ppx, Y = ty*TS+py, o = (Y*PW + X)*4, h = hash2(X,Y);
      let r, gg, bb;
      if(L){
        let col = LAND[L][h%5===0 ? 1 : 0];
        if(L===3 && h%7===0) col = TREE;
        if(coast && L>1 && h%3===0) col = SAND;
        if(w.cold[i]) col = L===4 || h%6===0 ? SNOW2 : (L===3 && h%7===0) ? [60,92,84] : SNOW; // snow on frozen islands
        else if(bi===B.volcanic) col = L===1 ? (h%4 ? [92,82,84] : [70,62,66]) : h%23===0 ? [230,96,46] : (L===4 || h%3===0) ? [58,52,58] : [76,70,74]; // ash and basalt
        else if(bi===B.mangrove && L>1) col = h%3===0 ? [30,64,38] : h%3===1 ? TREE : [58,104,58]; // dense mangrove canopy
        r=col[0]; gg=col[1]; bb=col[2];
      } else if(b===99){ const dark = h%17===0; r = dark?8:2; gg = dark?10:4; bb = dark?18:9; }
      else {
        const col = bioBand[bi][b]; r=col[0]; gg=col[1]; bb=col[2];
        // a few marks so each biome reads at a glance
        if(bi===B.reef && h%31===0){ const cc = [[255,140,120],[255,200,110],[200,130,220]][h%3]; r=cc[0]; gg=cc[1]; bb=cc[2]; }
        else if(bi===B.kelp && h%14===0){ r=34; gg=96; bb=72; }
        else if(bi===B.mangrove && h%10===0){ r=46; gg=92; bb=60; }
        else if(bi===B.volcanic && h%29===0){ r=210; gg=86; bb=50; }
        else if(bi===B.volcanic && h%7===0){ r=58; gg=52; bb=64; }
        else if(bi===B.frozen && hash2(tx*3+7, ty*5+1)%19===0 && ppx<3 && py<2){ r=248; gg=252; bb=255; } // drifting ice
        const edge = [py===0, ppx===TS-1, py===TS-1, ppx===0];
        for(let k=0;k<4;k++) if(edge[k] && nShallower[k]){ r=Math.min(255,r+26); gg=Math.min(255,gg+26); bb=Math.min(255,bb+26); }
        for(let k=0;k<4;k++) if(edge[k] && nBio[k] && h%2===0){ r=Math.max(0,r-22); gg=Math.max(0,gg-22); bb=Math.max(0,bb-18); }
        if(anyLand){ for(let k=0;k<4;k++) if(nLand[k] && (edge[k] || h%4===0)){ r=FOAM[0]; gg=FOAM[1]; bb=FOAM[2]; } }
        if(h%11===0){ r=Math.min(255,r+8); gg=Math.min(255,gg+8); bb=Math.min(255,bb+8); }
      }
      D[o]=r; D[o+1]=gg; D[o+2]=bb; D[o+3]=255;
    }
  }
  g.putImageData(img, 0, 0);
  w.mapC = c;
}
// Fog is saved run-length encoded: it is mostly long runs of 0 or 255
function fogEncode(u8){ const out=[]; let i=0; while(i<u8.length){ const v=u8[i]; let n=1; while(i+n<u8.length && u8[i+n]===v && n<255) n++; out.push(v,n); i+=n; } return toB64(Uint8Array.from(out)); }
function fogDecode(b64, n){ const src=fromB64(b64, atob(b64).length), u=new Uint8Array(n); let o=0; for(let i=0;i+1<src.length && o<n;i+=2){ u.fill(src[i], o, Math.min(n, o+src[i+1])); o+=src[i+1]; } return u; }
function loadWorld(){
  const sw = S.world; if(!sw) { WORLD = null; return; }
  WORLD = genWorld(sw.size, sw.seed);
  if(sw.n !== WORLD.N){ // saved before maps got bigger: same seed, redrawn at the new size
    sw.n = WORLD.N; delete sw.fog; delete sw.fogRle; sw.found = []; delete sw.bx; delete sw.by;
    setTimeout(()=>toast('Your map was redrawn at the new, larger size.'), 600);
  }
  if(sw.fogRle){ const f = fogDecode(sw.fogRle, WORLD.N*WORLD.N); WORLD.fog.set(f); for(let i=0;i<f.length;i++) WORLD.fogImg.data[i*4+3] = 255 - f[i]; }
  (sw.found||[]).forEach(i => { if(WORLD.spots[i]) WORLD.spots[i].found = true; });
  T.x = sw.bx ?? WORLD.spawn.x; T.y = sw.by ?? WORLD.spawn.y; T.ang = sw.ang ?? 0; T.spd = 0;
  if(!isWaterPx(T.x, T.y)){ T.x = WORLD.spawn.x; T.y = WORLD.spawn.y; }
  revealAround(true);
}
function saveWorld(){
  if(!WORLD || !S.world) return;
  S.world.fogRle = fogEncode(WORLD.fog); S.world.n = WORLD.N; delete S.world.fog; S.world.bx = Math.round(T.x*10)/10; S.world.by = Math.round(T.y*10)/10; S.world.ang = +T.ang.toFixed(3);
  S.world.found = WORLD.spots.map((s,i)=>s.found?i:-1).filter(i=>i>=0);
  save();
}
function newWorld(size){
  S.world = {size, seed:(Math.random()*2**31)|0, n:MAP_N[size]};
  WORLD = genWorld(size, S.world.seed);
  T.x = WORLD.spawn.x; T.y = WORLD.spawn.y; T.ang = 0; T.spd = 0;
  revealAround(true); saveWorld();
  G.mode = 'travel'; document.body.dataset.mode = 'travel';
  toast(`New ${size} map charted. The harbor is right beside you.`);
}
const tileAt = (px,py) => { if(!WORLD) return -1; const x=Math.floor(px/TS), y=Math.floor(py/TS); return (x<0||y<0||x>=WORLD.N||y>=WORLD.N) ? -1 : y*WORLD.N+x; };
const isWaterPx = (px,py) => { const i = tileAt(px,py); return i>=0 && !WORLD.land[i]; };
function zoneOf(d){ return d>=ABYSS_D ? 4 : d<40 ? 0 : d<110 ? 1 : d<250 ? 2 : 3; }
function waterHere(){
  const i = tileAt(T.x, T.y); if(i<0) return null;
  const d = WORLD.depth[i];
  const spot = WORLD.spots.find(s => Math.hypot(s.wx-T.x, s.wy-T.y) < 5*TS) || null;
  return {depth:d, abyss:d>=ABYSS_D, zone:zoneOf(d), biome:WORLD.biome[i], spot};
}
const depthLabel = d => d>=ABYSS_D ? '??? ft' : `${Math.round(d)} ft`;

/* ================== Sprite generation (fish) ================== */
function genSprite(d){
  const L = d.len, Ht = d.ht, pad = 3, cw = L + pad*2, ch = Ht + pad*2;
  const col = {main:hexToRgb(d.c[0]), back:hexToRgb(d.c[1]), belly:hexToRgb(d.c[2]), acc:hexToRgb(d.acc||d.c[1]), fin:hexToRgb(shade(d.c[1],-.15)), out:[12,22,38]};
  const frames = []; let lanternPt = null;
  for(const wag of [0, 1, -1]){
    const m = new Uint8Array(cw*ch);
    const cx = pad + L*.58, cy = ch/2, rx = L*.42, ry = Ht/2;
    for(let y=0;y<ch;y++) for(let x=0;x<cw;x++){ const nx=(x+.5-cx)/rx, ny=(y+.5-cy)/ry; if(nx*nx+ny*ny<=1) m[y*cw+x]=1; }
    const tl = Math.max(2, Math.round(L*.24)), tb = Math.floor(cx-rx)+1;
    for(let i=0;i<=tl;i++){ const x=tb-i; if(x<0) break; const half=.6+i*(ry*.95)/tl, yc=cy+wag*(i/tl)*1.6;
      for(let y=0;y<ch;y++){ const dy=Math.abs(y+.5-yc); if(dy<=half && !(i>tl*.6 && dy<half*.3) && !m[y*cw+x]) m[y*cw+x]=2; } }
    const ds = Math.round(cx-rx*.35), de = Math.round(cx+rx*.15), top = Math.round(cy-ry)-1;
    for(let x=ds;x<=de;x++){ if(top>=0 && !m[top*cw+x]) m[top*cw+x]=2; if(!d.lowFin && x>ds+1 && x<de-1 && top-1>=0) m[(top-1)*cw+x]=2; }
    const vx = Math.round(cx-rx*.1), vy = Math.round(cy+ry); if(vy<ch && !m[vy*cw+vx]) m[vy*cw+vx]=2;
    const img = new ImageData(cw, ch);
    const put = (x,y,c,a=255) => { if(x<0||y<0||x>=cw||y>=ch) return; const i=(y*cw+x)*4; img.data[i]=c[0]; img.data[i+1]=c[1]; img.data[i+2]=c[2]; img.data[i+3]=a; };
    const filled = (x,y) => x>=0 && y>=0 && x<cw && y<ch && m[y*cw+x];
    for(let y=0;y<ch;y++) for(let x=0;x<cw;x++){
      const v = m[y*cw+x];
      if(v===1){ const ny=(y+.5-cy)/ry; let c = ny<-.3 ? col.back : ny>.35 ? col.belly : col.main;
        if(d.pattern==='stripes' && (x-pad)%4===1 && ny<.45 && ny>-.8) c=col.acc;
        if(d.pattern==='spots' && (x*7+y*13)%9===0 && ny<.4) c=col.acc;
        if(d.pattern==='band' && Math.abs(ny)<.22) c=col.acc;
        put(x,y,c);
      } else if(v===2) put(x,y,col.fin);
      else if(filled(x-1,y)||filled(x+1,y)||filled(x,y-1)||filled(x,y+1)) put(x,y,col.out,215);
    }
    const ex = Math.round(cx+rx*.62), ey = Math.round(cy-ry*.25);
    if(L>=14) put(ex-1,ey,[240,240,240]);
    put(ex,ey,[14,14,22]);
    if(L>=16){ const gx=Math.round(cx+rx*.35); for(let y=Math.round(cy-ry*.4); y<=Math.round(cy+ry*.3); y++) put(gx,y,col.back); }
    if(d.whiskers){ const wx=Math.round(cx+rx)-1, wy=Math.round(cy+ry*.15); put(wx+1,wy,col.out); put(wx+2,wy+1,col.out); put(wx+2,wy+2,col.out); put(wx,wy+1,col.out); put(wx+1,wy+2,col.out); }
    if(d.lantern){ const sx=Math.round(cx+rx*.35), t=Math.round(cy-ry); put(sx,t-1,col.back); put(sx+1,t-2,col.back); put(sx+2,t-2,col.back); put(sx+3,t-1,[200,255,245]); lanternPt={x:sx+3-cw/2, y:t-1-ch/2}; }
    const cv = document.createElement('canvas'); cv.width=cw; cv.height=ch; cv.getContext('2d').putImageData(img,0,0);
    frames.push(cv);
  }
  return {frames, w:cw, h:ch, seq:[0,1,0,2], facesLeft:false, smooth:false, lantern:lanternPt};
}
function genPile(d){ return genSprite(Object.assign({}, d, {len:clamp(Math.round(d.len*.5),6,14), ht:clamp(Math.round(d.ht*.55),3,6), whiskers:false, lantern:false})); }

let RT = [], byId = {};
function buildRuntime(def){
  const r = Object.assign({}, def);
  if(def.custom && def.frames && def.frames.length){
    const imgs = def.frames.map(src => { const i = new Image(); i.src = src; return i; });
    r.sprite = {frames:imgs, w:def.size, h:null, seq: imgs.length===1?[0]: imgs.length===2?[0,1]:[0,1,2,1], facesLeft:!!def.facesLeft, smooth:true};
    r.pile = {frames:[imgs[0]], w:clamp(Math.round(def.size*.5),6,14), h:null, seq:[0], facesLeft:!!def.facesLeft, smooth:true};
  } else {
    const gd = def.custom ? {len:def.size, ht:Math.max(4,Math.round(def.size*.45)), c:[def.color||'#4fc3a1', shade(def.color||'#4fc3a1',-.38), shade(def.color||'#4fc3a1',.5)], pattern:'none'} : def;
    r.sprite = genSprite(gd); r.pile = genPile(gd);
  }
  r.dot = hexToRgb(def.custom ? (def.color || '#4fc3a1') : def.c[0]);
  r.iconURL = def.icon || (def.frames && def.frames[0]) || r.sprite.frames[0].toDataURL();
  return r;
}
function rebuildRegistry(){ RT = [...SPECIES, ...S.custom].map(buildRuntime); byId = {}; RT.forEach(r => byId[r.id] = r); addSpecialItems(); for(const it of S.inv){ const sp = byId[it.sid]; if(sp && !sp.custom) it.name = sp.name; } }
rebuildRegistry();
const GENERIC_DEF = {len:16, ht:7, c:['#8aa0b0','#4d6070','#d0dbe2'], pattern:'none'};
const GENERIC_ICON = genSprite(GENERIC_DEF).frames[0].toDataURL();
const GENERIC_PILE = genPile(GENERIC_DEF);

/* ================== Item icons (16x16 pixel sprites) ================== */
function makeIcon(draw){
  const c = document.createElement('canvas'); c.width = 16; c.height = 16;
  const g = c.getContext('2d'), solid = new Uint8Array(256);
  const P = (x, y, col, isSolid = true) => { if(x<0||y<0||x>15||y>15) return; g.fillStyle = col; g.fillRect(x, y, 1, 1); solid[y*16+x] = isSolid ? 2 : 1; };
  draw(P);
  const img = g.getImageData(0,0,16,16), D = img.data, at = (x,y) => x>=0&&y>=0&&x<16&&y<16 && solid[y*16+x]===2;
  for(let y=0;y<16;y++) for(let x=0;x<16;x++){ if(solid[y*16+x]) continue; if(at(x-1,y)||at(x+1,y)||at(x,y-1)||at(x,y+1)){ const o=(y*16+x)*4; D[o]=11; D[o+1]=26; D[o+2]=36; D[o+3]=255; } }
  g.putImageData(img, 0, 0);
  return c.toDataURL();
}
const ICONS = {
  light: makeIcon(P => { // a ship's searchlight with a beam
    for(let y=5;y<=11;y++) for(let x=3;x<=8;x++) P(x, y, x===3 ? '#5a6570' : y===5 ? '#cfd6db' : '#8a96a0');
    for(let y=6;y<=10;y++){ P(9, y, '#fff4c0'); P(10, y, '#ffe48a'); }
    for(let i=0;i<4;i++){ P(11+i, 7-i, '#fff4c0', false); P(11+i, 8, '#ffe48a', false); P(11+i, 9+i, '#fff4c0', false); }
    P(5,12,'#5a6570'); P(6,12,'#5a6570'); for(let x=3;x<=8;x++) P(x,13,'#3d4650');
  }),
  rod: makeIcon(P => {
    for(let i=0;i<10;i++){ const x=3+i, y=12-i; P(x, y, i<4 ? '#7a5530' : '#a8703f'); if(i<3) P(x+1, y, '#7a5530'); }
    for(let dx=0;dx<3;dx++) for(let dy=0;dy<3;dy++) P(2+dx, 10+dy, '#9aa6b0'); P(3,11,'#5a6570');
    for(let y=3;y<=11;y++) P(13, y, '#cfe3e8', false);
    P(13,12,'#dfe8ee'); P(13,13,'#dfe8ee'); P(12,13,'#dfe8ee'); P(11,12,'#dfe8ee'); P(12,14,'#e88a9a'); P(11,14,'#e88a9a');
  }),
  net: makeIcon(P => {
    for(let y=5;y<=12;y++) for(let x=2;x<=13;x++){ const sag = y===12 && (x<4||x>11); if(!sag && ((x+y)%3===0 || (x-y+30)%3===0)) P(x, y, '#d9cfa8', false); }
    for(let x=1;x<=14;x++) P(x, 4, '#e8dfbd');
    for(const x of [2,7,12]){ P(x,3,'#ff6a3d'); P(x+1,3,'#ff6a3d'); P(x,2,'#ff9a6d'); P(x+1,2,'#ff9a6d'); }
    for(const x of [3,8,12]){ P(x,13,'#6c7782'); P(x,14,'#5a6570'); }
  }),
  dyn: makeIcon(P => {
    for(let y=6;y<=14;y++) for(let x=5;x<=8;x++) P(x, y, x===5 ? '#f07a5a' : x===8 ? '#8f2a1f' : '#d8452f');
    for(let x=5;x<=8;x++){ P(x,7,'#5b2a14'); P(x,13,'#5b2a14'); P(x,10,'#efe3c8'); }
    P(7,5,'#6b6b6b'); P(7,4,'#6b6b6b'); P(8,3,'#6b6b6b'); P(9,2,'#6b6b6b');
    P(10,1,'#ffd25e'); P(11,1,'#ff8a3d'); P(10,0,'#ff8a3d'); P(9,1,'#ff8a3d'); P(10,2,'#ff8a3d'); P(12,0,'#fff4d2',false); P(12,3,'#fff4d2',false);
  }),
  fuse: makeIcon(P => {
    let end = [7,9];
    for(let a=0; a<Math.PI*3.4; a+=.18){ const r = 1+a*.5, x = Math.round(8+Math.cos(a)*r), y = Math.round(9+Math.sin(a)*r); P(x, y, a > Math.PI*2.6 ? '#b39a6a' : '#8a7a5a'); end = [x,y]; }
    const [ex,ey] = end; P(ex,ey-1,'#ffd25e'); P(ex+1,ey-1,'#ff8a3d'); P(ex-1,ey-1,'#ff8a3d'); P(ex,ey-2,'#ff8a3d'); P(ex+1,ey-3,'#fff4d2',false);
  }),
  blast: makeIcon(P => {
    for(let y=0;y<16;y++) for(let x=0;x<16;x++){ const dx=x-7.5, dy=y-7.5, d=Math.hypot(dx,dy), a=Math.atan2(dy,dx), ray=Math.abs(Math.cos(a*4))>.8;
      if(d<2.4) P(x,y,'#fff4d2'); else if(d<4.2) P(x,y,'#ffd25e'); else if(ray && d<7.6) P(x,y, d<5.8 ? '#ff8a3d' : '#d8452f'); }
  }),
  bag: makeIcon(P => {
    for(const x0 of [5,9]) for(let y=2;y<=6;y++){ P(x0,y,'#d8452f'); P(x0+1,y,'#8f2a1f'); }
    P(5,1,'#6b6b6b'); P(10,1,'#6b6b6b'); P(4,0,'#ffd25e'); P(11,0,'#ffd25e');
    for(let y=6;y<=14;y++) for(let x=2;x<=13;x++){ if(y===14 && (x===2||x===13)) continue; P(x, y, x===2 || y===6 ? '#b07a44' : '#8a5a34'); }
    for(let x=2;x<=13;x++) P(x, 9, '#6b4422'); P(7,10,'#ffd25e'); P(8,10,'#ffd25e'); P(7,11,'#c99a2e'); P(8,11,'#c99a2e');
  }),
};

/* ================== Top-down boat sprites (32 headings per tier) ================== */
const TOP_BOATS = BOATS.map((b, ti) => {
  const L = [12,14,16,19][ti], Wd = [6,6,7,8][ti], SZ = L + 6;
  const rim = hexToRgb(shade(b.hull,.3)), hull = hexToRgb(b.hull), deck = [201,160,106], cabin = [232,224,204];
  const halfW = u => Wd/2 * (u < L*.1 ? 1 : Math.max(0, 1 - Math.pow((u - L*.1)/(L*.4), 1.8)));
  const out = [];
  for(let a=0; a<32; a++){
    const ang = a/32*Math.PI*2, ca = Math.cos(ang), sa = Math.sin(ang);
    const c = document.createElement('canvas'); c.width = SZ; c.height = SZ;
    const g = c.getContext('2d'), img = g.createImageData(SZ, SZ);
    for(let y=0;y<SZ;y++) for(let x=0;x<SZ;x++){
      const dx = x+.5-SZ/2, dy = y+.5-SZ/2, u = dx*ca + dy*sa, v = -dx*sa + dy*ca, hw = halfW(u);
      let col = null;
      if(u >= -L/2 && u <= L/2 && Math.abs(v) <= hw){
        const edge = Math.abs(v) > hw - 1.1 || u < -L/2 + 1.1;
        col = edge ? rim : deck;
        if(!edge && ti>=2 && u < -L*.18 && u > -L/2+1.5 && Math.abs(v) < hw-1.4) col = cabin;
        if(!edge && Math.abs(u - L*.05) < .6) col = hull;
      } else if(u >= -L/2-1 && u <= L/2+1 && Math.abs(v) <= hw+1 && hw > 0){
        col = [10,30,45]; // outline
      }
      if(col){ const o=(y*SZ+x)*4; img.data[o]=col[0]; img.data[o+1]=col[1]; img.data[o+2]=col[2]; img.data[o+3]= col[0]===10 ? 120 : 255; }
    }
    g.putImageData(img,0,0); out.push(c);
  }
  return {L, Wd, SZ, frames:out, halfW};
});

/* ================== Canvas setup ================== */
const cvs = $('game'); let ctx = cvs.getContext('2d');   // let: the lighting pass briefly draws through an offscreen context
ctx.imageSmoothingEnabled = false;
const mini = $('mini'), mctx = mini.getContext('2d');
const px = (x,y,w,h,c) => { ctx.fillStyle=c; ctx.fillRect(Math.round(x),Math.round(y),w,h); };
function mk(w,h){ const c=document.createElement('canvas'); c.width=w; c.height=h; const g=c.getContext('2d'); g.imageSmoothingEnabled=false; return [c,g]; }
const GLYPH = {'0':'111101101101111','1':'010110010010111','2':'111001111100111','3':'111001111001111','4':'101101111001001','5':'111100111001111','6':'111100111101111','7':'111001001001001','8':'111101111101111','9':'111101111001111','F':'111100110100100','T':'111010010010010','!':'010010010000010','?':'111001011000010'};
function pText(s,x,y,c,sc=1){ ctx.fillStyle=c; let cx=x; for(const ch of s){ const g=GLYPH[ch]; if(g) for(let i=0;i<15;i++) if(g[i]==='1') ctx.fillRect(cx+(i%3)*sc, y+Math.floor(i/3)*sc, sc, sc); cx+=4*sc; } }
function bandFill(g, x, y, w, h, stops, bands){
  const cols = stops.map(s=>hexToRgb(s[1]));
  const colorAt = t => { for(let i=0;i<stops.length-1;i++){ const a=stops[i][0], b=stops[i+1][0]; if(t<=b){ const k=(t-a)/(b-a||1); return cols[i].map((v,j)=>Math.round(lerp(v,cols[i+1][j],k))); } } return cols[cols.length-1]; };
  for(let r=0;r<h;r++){
    const t=r/h, band=Math.floor(t*bands)/bands, next=Math.min(1,(Math.floor(t*bands)+1)/bands);
    const c1=colorAt(band), c2=colorAt(next), edge=(t*bands)%1>.82;
    if(!edge){ g.fillStyle=`rgb(${c1[0]},${c1[1]},${c1[2]})`; g.fillRect(x, y+r, w, 1); continue; }
    for(let cx=0; cx<w; cx++){ const c = ((cx + r) % 2 === 0) ? c2 : c1; g.fillStyle=`rgb(${c[0]},${c[1]},${c[2]})`; g.fillRect(x+cx, y+r, 1, 1); }
  }
}

/* ================== Day and night ==================
   One full day takes 15 real minutes.
   S.clock is the time of day in game minutes (0 to 1439). */
const DAY_REAL_SEC = 15*60, GAME_MIN_PER_SEC = 1440/DAY_REAL_SEC;
const PERIODS = [ // in order through the day; each starts at hour h
  {id:'dawn',      name:'Dawn',      h:5},
  {id:'morning',   name:'Morning',   h:7},
  {id:'midday',    name:'Midday',    h:11},
  {id:'afternoon', name:'Afternoon', h:14},
  {id:'dusk',      name:'Dusk',      h:17},
  {id:'evening',   name:'Evening',   h:19},
  {id:'night',     name:'Night',     h:22},
];
const PERIOD_BY_ID = Object.fromEntries(PERIODS.map(p => [p.id, p]));
const hourNow = () => S.clock/60;
function periodAt(min){ const h = min/60; let p = PERIODS[PERIODS.length-1]; for(const q of PERIODS) if(h >= q.h) p = q; return p; }
const periodNow = () => periodAt(S.clock);
function clockLabel(min){ const m = Math.floor(min) % 1440, h = Math.floor(m/60), mm = m % 60; return `${(h+11)%12+1}:${String(mm).padStart(2,'0')} ${h<12?'AM':'PM'}`; }
function lerpKeys(keys, h){ // keys: [[hour, [r,g,b]], ...] covering 0 to 24
  for(let i=1;i<keys.length;i++) if(h <= keys[i][0]){ const [h0,a] = keys[i-1], [h1,b] = keys[i], t = (h-h0)/Math.max(.001,h1-h0); return a.map((v,k) => Math.round(v + (b[k]-v)*t)); }
  return keys[keys.length-1][1];
}
// The whole scene is multiplied by this color: white at midday, deep blue at night
const LIGHT_KEYS = [[0,[58,70,138]],[4.4,[62,74,142]],[5.4,[176,142,178]],[6.4,[255,196,186]],[8,[252,242,232]],[11,[255,255,255]],[14.5,[255,250,238]],[16.8,[255,214,170]],[18,[240,156,132]],[19.2,[150,118,170]],[20.6,[88,94,160]],[22,[58,70,138]],[24,[58,70,138]]];
const lightNow = () => lerpKeys(LIGHT_KEYS, hourNow());
const darkNow = () => { const c = lightNow(); return clamp(1 - (c[0]*.3 + c[1]*.5 + c[2]*.2)/255, 0, 1); };
const nightK = () => clamp((darkNow() - .15)/.5, 0, 1); // 0 in daylight, 1 deep in the night
function applyDayTint(){
  const c = lightNow(); if(c[0] > 252 && c[1] > 252 && c[2] > 252) return;
  ctx.save(); ctx.setTransform(1,0,0,1,0,0); ctx.globalCompositeOperation = 'multiply';
  ctx.fillStyle = `rgb(${c})`; ctx.fillRect(0,0,W,H); ctx.restore();
}
function updateClock(dt){
  if(!WORLD || anyDialog()) return;
  const before = periodNow().id;
  S.clock = (S.clock + dt*GAME_MIN_PER_SEC) % 1440;
  const p = periodNow();
  if(p.id !== before) toast(PERIOD_TOAST[p.id]);
}
const PERIOD_TOAST = {dawn:'Dawn breaks over the isles.', morning:'Morning. The water is warming up.', midday:'Midday. The sun is high.', afternoon:'Afternoon.', dusk:'Dusk settles in.', evening:'Evening. The light is fading.', night:'Night has fallen. Strange fish rise in the dark.'};

// Side-view skies, one per part of the day, crossfaded as time passes. Colors are picked
// to look right after the day tint is multiplied over them.
const SKY_PAL = {
  night:     {sky:['#26357a','#34488c','#43599c','#5468a6'], hills:['#2e3a6c','#20284e']},
  dawn:      {sky:['#46559a','#9c80bc','#f4a8b0','#ffd6aa'], hills:['#8a76aa','#5e548a']},
  morning:   {sky:['#5aa6e2','#8cc6ee','#c6e4f4','#f6eedc'], hills:['#7fa6b6','#5c8496']},
  midday:    {sky:['#3f9ee2','#6cbaf0','#a8daf6','#e2f4fa'], hills:['#78aaa2','#4f8a82']},
  afternoon: {sky:['#4a98d6','#7cb6e2','#c2dae8','#f8e4c2'], hills:['#86a2aa','#64828e']},
  dusk:      {sky:['#2b3f7e','#7a6fb0','#f2a47a','#ffd59a'], hills:['#8f7cb4','#5c5690']},
  evening:   {sky:['#25346e','#4c4c90','#90649c','#c8808e'], hills:['#4c447a','#302e5c']},
};
const SKY_KEYS = [[0,'night'],[4.4,'night'],[5.8,'dawn'],[8,'morning'],[12,'midday'],[15.5,'afternoon'],[18,'dusk'],[19.7,'evening'],[21.5,'night'],[24,'night']];
const SKIES = {};
for(const [id, pal] of Object.entries(SKY_PAL)){
  const [c, g] = mk(W, SURF+4);
  bandFill(g, 0, 0, W, SURF+4, [[0,pal.sky[0]],[.45,pal.sky[1]],[.8,pal.sky[2]],[1,pal.sky[3]]], 10);
  const [hc, hg] = mk(W, SURF+4);
  let seed=7; const rnd=()=>{seed=(seed*16807)%2147483647; return seed/2147483647;};
  const layer=(base,amp,col,freq)=>{ hg.fillStyle=col; for(let x=0;x<W;x++){ const h = Math.sin(x*freq)*amp*.6 + Math.sin(x*freq*2.7+1.3)*amp*.3 + rnd()*1.2; const top=Math.round(base-Math.max(0,h+amp*.4)); hg.fillRect(x,top,1,SURF+4-top); } };
  layer(SURF-8, 12, pal.hills[0], .027);
  layer(SURF-2, 7, pal.hills[1], .045);
  SKIES[id] = {sky:c, hills:hc};
}
function skyBlend(){ const h = hourNow(); for(let i=1;i<SKY_KEYS.length;i++) if(h <= SKY_KEYS[i][0]){ const [h0,a] = SKY_KEYS[i-1], [h1,b] = SKY_KEYS[i]; return [a, b, (h-h0)/Math.max(.001,h1-h0)]; } return ['night','night',0]; }
const STARS = Array.from({length:70}, (_,i) => ({x:(i*97.13 + Math.sin(i*12.9)*40 + 400) % W, y:2 + ((i*53.7) % 34), ph:i*1.7, big:i%11===0}));
// Sun from 6:00 to 18:30 and moon from 19:00 to 6:30, each on an arc across the sky
function sunPos(){ const u = (hourNow()-6)/12.5; if(u < -.04 || u > 1.04) return null; return {x:18 + u*284, y:SURF - 4 - Math.sin(Math.PI*clamp(u,0,1))*44, u}; }
function moonPos(){ const u = (((hourNow()-19)+24)%24)/11.5; if(u > 1.04) return null; return {x:20 + u*280, y:SURF - 8 - Math.sin(Math.PI*clamp(u,0,1))*40, u}; }
function drawSky(){
  const [a, b, t] = skyBlend();
  ctx.drawImage(SKIES[a].sky, 0, 0);
  if(b !== a && t > 0){ ctx.globalAlpha = t; ctx.drawImage(SKIES[b].sky, 0, 0); ctx.globalAlpha = 1; }
  const sun = sunPos();
  if(sun){
    ctx.save(); ctx.globalCompositeOperation='lighter';
    const g = ctx.createRadialGradient(sun.x,sun.y,3,sun.x,sun.y,50); g.addColorStop(0,'rgba(255,225,160,.55)'); g.addColorStop(1,'rgba(255,170,120,0)'); ctx.fillStyle=g; ctx.fillRect(sun.x-50,sun.y-50,100,Math.max(0,Math.min(100, SURF+4-(sun.y-50)))); ctx.restore();
    const sx = Math.round(sun.x), sy = Math.round(sun.y);
    for(let y=-8;y<=8;y++){ const w=Math.round(Math.sqrt(64-y*y)); px(sx-w, sy+y, w*2, 1, y>3 ? '#ffe2a8' : '#fff4d2'); }
  }
  ctx.drawImage(SKIES[a].hills, 0, 0);
  if(b !== a && t > 0){ ctx.globalAlpha = t; ctx.drawImage(SKIES[b].hills, 0, 0); ctx.globalAlpha = 1; }
}
// Drawn after the tint so they shine through the dark
function drawNightSky(){
  const n = nightK(); if(n <= 0) return;
  ctx.save(); ctx.globalCompositeOperation='lighter';
  for(const s of STARS){ const a = n*(.45 + .4*Math.sin(time*1.3 + s.ph)); if(a <= .05) continue; ctx.fillStyle = `rgba(235,240,255,${a})`; ctx.fillRect(Math.round(s.x), Math.round(s.y), 1, 1); if(s.big && a > .5){ ctx.fillStyle = `rgba(235,240,255,${a*.4})`; ctx.fillRect(Math.round(s.x)-1, Math.round(s.y), 3, 1); ctx.fillRect(Math.round(s.x), Math.round(s.y)-1, 1, 3); } }
  const m = moonPos();
  if(m && m.y < SURF - 14){
    const mx = Math.round(m.x), my = Math.round(m.y);
    const g = ctx.createRadialGradient(mx,my,2,mx,my,26); g.addColorStop(0,`rgba(200,215,255,${.35*n})`); g.addColorStop(1,'rgba(200,215,255,0)'); ctx.fillStyle=g; ctx.fillRect(mx-26,my-26,52,52);
    for(let y=-5;y<=5;y++){ const w=Math.round(Math.sqrt(25-y*y)); ctx.fillStyle = `rgba(240,240,225,${.9*n})`; ctx.fillRect(mx-w, my+y, w*2, 1); }
    ctx.fillStyle = `rgba(150,160,190,${.5*n})`; ctx.fillRect(mx-2, my-2, 2, 2); ctx.fillRect(mx+1, my+1, 2, 1);
  }
  ctx.restore();
}
// A warm glow around a lantern, drawn after the tint; brightest at night
function lanternGlow(x, y, r, k){
  if(k <= .02) return;
  ctx.save(); ctx.globalCompositeOperation='lighter';
  const g = ctx.createRadialGradient(x,y,1,x,y,r); g.addColorStop(0,`rgba(255,210,130,${.5*k})`); g.addColorStop(.35,`rgba(255,170,90,${.18*k})`); g.addColorStop(1,'rgba(255,150,80,0)');
  ctx.fillStyle = g; ctx.fillRect(x-r, y-r, r*2, r*2); ctx.restore();
}
const [vigC, vigG] = mk(W, H);
(function(){ const g=vigG.createRadialGradient(W/2,H/2,H*.35,W/2,H/2,H*.95); g.addColorStop(0,'rgba(0,0,0,0)'); g.addColorStop(1,'rgba(0,0,10,.42)'); vigG.fillStyle=g; vigG.fillRect(0,0,W,H); })();
function cloudSprite(w,h,seed){
  const [c,g]=mk(w,h+2); const blobs=[]; let s=seed;
  const r=()=>{s=(s*9301+49297)%233280; return s/233280;};
  for(let i=0;i<5;i++) blobs.push([w*(.15+.7*r()), h*(.45+.3*r()), h*(.3+.25*r())]);
  for(let y=0;y<h;y++) for(let x=0;x<w;x++){ let inside=false; for(const [bx,by,br] of blobs){ const dx=(x-bx)/(br*1.6), dy=(y-by)/br; if(dx*dx+dy*dy<=1) inside=true; } if(y>h*.78) inside=inside && (x>w*.08 && x<w*.92);
    if(inside){ g.fillStyle = y>h*.62 ? '#d6dce8' : y<h*.3 ? '#ffffff' : '#eef1f6'; g.fillRect(x,y,1,1);} }
  return c;
}
const clouds = [[20,8,44,12,3],[120,18,32,9,11],[200,6,52,14,21],[290,20,30,9,5]].map(([x,y,w,h,s])=>({x,y,img:cloudSprite(w,h,s),v:rand(2,4)}));

/* ================== Side view: build the water column for this spot ================== */
const WATER_SIDE = [[0,'#46b3c2'],[6,'#2386a3'],[25,'#165682'],[60,'#0d2e56'],[120,'#071a36'],[250,'#030b18'],[400,'#010409']];
const ABYSS_SIDE = [[0,'#3a9aae'],[6,'#1d6f8e'],[25,'#0f3e66'],[60,'#081d3c'],[120,'#030a18'],[200,'#010204']];
let waterC, bedC, rockC, tintC, plankton = [], kelpBack = [], kelpFront = [];
function setLake(info){
  ABYSS = info.abyss; LAKE_FT = ABYSS ? 600 : Math.max(12, Math.round(info.depth)); ZONE = info.zone; HOT = !!info.spot;
  BIOME = ABYSS ? B.abyss : (info.biome ?? B.open);
  BED_Y = SURF + LAKE_FT*FT; WORLD_H = BED_Y + 24; CAM_MAX = Math.max(0, WORLD_H - H);
  const bio = BIOMES[BIOME], wh = Math.max(WORLD_H, H+10) - SURF + 60;
  // each biome shifts the water toward its own color; the effect fades with depth (less so in frozen water)
  const stops = ABYSS ? ABYSS_SIDE : WATER_SIDE.map(([d, c]) => { const k = bio.sk*(BIOME===B.frozen ? 1 - Math.min(.6, d/400) : 1 - Math.min(1, d/160)), A = hexToRgb(c), T = hexToRgb(bio.side);
    return [d, '#' + A.map((v,j) => Math.round(lerp(v, T[j], k)).toString(16).padStart(2,'0')).join('')]; });
  let g; [waterC, g] = mk(W, wh);
  for(let r=0; r<wh; r++){
    const band = Math.floor(r/8), c1 = lerpColor(stops, (band*8+4)/FT), c2 = lerpColor(stops, (band*8+12)/FT), edge = r%8 >= 6;
    if(!edge){ g.fillStyle=`rgb(${c1})`; g.fillRect(0,r,W,1); }
    else for(let x=0;x<W;x++){ g.fillStyle = `rgb(${(x+r)%2 ? c2 : c1})`; g.fillRect(x,r,1,1); }
  }
  // Lakebed: sandy in the shallows, dark silt deeper down
  const shallow = LAKE_FT < 60;
  [bedC, g] = mk(W, 90);
  const BEDS = {sand:['#c2ab78','#8c7a56','#a39066','#9b9383','#7b7466'], silt:['#4a4558','#262632','#34323f','#3d3d50','#2b2c3c'], mud:['#6e6440','#3e3624','#55502e','#4a4630','#353020'],
    rock:['#5e6258','#33362f','#474a40','#6a6e64','#45483f'], basalt:['#3a2e30','#1a1618','#c0402a','#2e2a2e','#1e1a1e'], gravel:['#a8b8c2','#6a7a84','#c8d4dc','#8a9aa4','#6e7c86']};
  let style = bio.bed; if(style==='sand' && !shallow) style = 'silt';
  const [top, body, speck, rockHi, rockLo] = BEDS[style];
  for(let x=0;x<W;x++){ const t=Math.round(6+Math.sin(x*.07)*2+Math.sin(x*.21)*1); g.fillStyle=body; g.fillRect(x,t,1,90); g.fillStyle=top; g.fillRect(x,t,1,1); if(x%7===0){ g.fillStyle=speck; g.fillRect(x,t+3,1,1);} }
  for(const [rx,r] of [[26,5],[90,3],[140,6],[196,4],[250,7],[300,4]]) for(let y=-r;y<=0;y++) for(let x=-r*1.4;x<=r*1.4;x++){ if((x*x)/(r*r*1.96)+(y*y)/(r*r)<=1){ g.fillStyle = y<-r*.5 ? rockHi : rockLo; g.fillRect(Math.round(rx+x), 8+y, 1, 1);} }
  if(style==='sand' && BIOME===B.shallows) for(let x=0;x<W;x++){ const t=Math.round(6+Math.sin(x*.07)*2+Math.sin(x*.21)*1); if((x+Math.round(Math.sin(x*.3)*2))%9<3){ g.fillStyle='#d6c08a'; g.fillRect(x,t+2,1,1);} } // ripples
  if(style==='basalt') for(let x=0;x<W;x+=1){ const t=Math.round(6+Math.sin(x*.07)*2+Math.sin(x*.21)*1); if(hash2(x,3)%13===0){ g.fillStyle='#ff7a3a'; g.fillRect(x,t+1,1,2+hash2(x,5)%4); } } // glowing cracks
  // Rock spires in deep water
  rockC = null;
  if(LAKE_FT >= 80){
    [rockC, g] = mk(W, WORLD_H);
    let seed = 3 + Math.round(LAKE_FT); const rnd=()=>{seed=(seed*16807)%2147483647; return seed/2147483647;};
    g.fillStyle = 'rgba(2,10,24,.55)';
    const span = WORLD_H - SURF;
    for(let i=0;i<7;i++){ const cx=rnd()*W, w=14+rnd()*30, topY=SURF + span*(.35+.4*rnd());
      for(let y=Math.round(topY); y<WORLD_H; y++){ const t=(y-topY)/(WORLD_H-topY), half=w*(.25+.75*Math.sqrt(t))*(1+Math.sin(y*.13+i)*.06); g.fillRect(Math.round(cx-half), y, Math.round(half*2), 1); } }
    for(let y=SURF+120; y<WORLD_H; y++){ const t=(y-SURF-120)/(WORLD_H-SURF-120); const l=Math.round(t*34 + Math.sin(y*.09)*4), r=Math.round(t*28 + Math.sin(y*.07+2)*4); g.fillRect(0,y,Math.max(0,l),1); g.fillRect(W-Math.max(0,r),y,Math.max(0,r),1); }
  }
  [tintC, g] = mk(W, WORLD_H);
  const tg = g.createLinearGradient(0, SURF, 0, WORLD_H);
  tg.addColorStop(0,'rgba(3,10,28,0)'); tg.addColorStop(Math.min(1, 120/(WORLD_H-SURF)), 'rgba(3,10,28,.18)'); tg.addColorStop(1, ABYSS ? 'rgba(0,0,0,.8)' : `rgba(2,6,16,${Math.min(.6, .15 + LAKE_FT/600)})`);
  g.fillStyle = tg; g.fillRect(0, SURF, W, WORLD_H-SURF);
  if(BIOME===B.mangrove){ g.fillStyle = 'rgba(46,62,30,.28)'; g.fillRect(0, SURF, W, WORLD_H-SURF); } // murky, tannin-stained water
  if(BIOME===B.volcanic){ const vg = g.createLinearGradient(0, Math.max(SURF, BED_Y-160), 0, BED_Y+10); vg.addColorStop(0,'rgba(60,10,10,0)'); vg.addColorStop(1,'rgba(90,20,14,.35)'); g.fillStyle = vg; g.fillRect(0, SURF, W, WORLD_H-SURF); }
  const pMul = BIOME===B.mangrove ? 2.4 : BIOME===B.deep || BIOME===B.frozen ? 1.6 : BIOME===B.volcanic ? 1.4 : 1;
  const fall = BIOME===B.deep || BIOME===B.abyss ? 1 : BIOME===B.frozen ? .6 : BIOME===B.volcanic ? -.8 : 0; // marine snow sinks, ice drifts, ash rises
  const pCol = {[B.mangrove]:'170,200,140', [B.deep]:'225,232,240', [B.frozen]:'240,250,255', [B.volcanic]:'150,140,140', [B.abyss]:'225,232,240'}[BIOME] || '210,240,230';
  plankton = Array.from({length:clamp(Math.round(LAKE_FT*1.2*pMul),40,420)},()=>({x:rand(0,W), y:rand(SURF+6,BED_Y), v:rand(1,4), a:rand(.15,.45)*(BIOME===B.mangrove?1.3:1), ph:rand(0,6), fall:fall*rand(2,5), c:pCol}));
  const kh = Math.min(90, LAKE_FT*FT);
  kelpBack = []; kelpFront = [];
  if(BIOME===B.kelp){ // a tall forest of giant kelp, reaching most of the way to the surface
    const full = LAKE_FT*FT;
    kelpBack = Array.from({length:15},(_,i)=>({x:6+i*22+rand(-6,6), h:full*rand(.55,.95), ph:rand(0,6), giant:true}));
    kelpFront = Array.from({length:5},(_,i)=>({x:10+i*72+rand(-10,10), h:full*rand(.5,.9), ph:rand(0,6), giant:true}));
  } else if(BIOME===B.shallows || BIOME===B.reef || BIOME===B.open && LAKE_FT<200){ // seagrass and the odd short kelp
    const n = BIOME===B.open ? 5 : 10;
    kelpBack = Array.from({length:n},(_,i)=>({x:10+i*(300/n)+rand(-8,8), h:(BIOME===B.open ? kh*rand(.25,.55) : rand(8,22)), ph:rand(0,6), grass:BIOME!==B.open}));
    kelpFront = BIOME===B.open ? [{x:20,h:kh*.45,ph:1},{x:304,h:kh*.5,ph:4}] : [{x:22,h:12,ph:1,grass:true},{x:180,h:16,ph:2.4,grass:true},{x:300,h:10,ph:4,grass:true}];
  }
  buildScenery();
  // Fresh fishing state for this spot
  fishes = []; parts = []; G.state = 'idle'; G.hooked = null; G.bite.fish = null; G.landed = null; G.relAnim = null; camY = 0;
  G.net = null; G.dyn = null; G.flyers = []; G.pending.clear(); G.flashA = 0; if(!toolReady(G.tool)) G.tool = 'rod';
  M = null; swRollT = rand(5, 12);
  G.bullets = []; G.gun.reload = null; G.gun.view = 0; G.gun.pending = 0; G.bolts = []; G.orbs = []; G.zapDmg = 0;
  for(let i=0;i<fishTarget();i++) spawnFish(null, true);
}
const fishTarget = () => Math.round(clamp(12 + LAKE_FT/6, 14, 44) * (HOT ? 1.5 : 1));

/* ================== Game state ================== */
const BOAT_X = 78;
let fishes = [], parts = [], time = 0, shake = 0, holding = false, holdFromWaiting = false, camY = 0;
const G = {
  mode:'travel', trans:null, gun:{aim:20, cd:0, shotT:9, reload:null, view:0, pending:0}, bullets:[], tool:'rod', net:null, dyn:null, flyers:[], pending:new Set(), flashA:0, haulT:0, haul:null,
  state:'idle', power:0, pdir:1, rodA:-.95,
  lure:{x:0, y:0, depth:0, maxDepth:0}, cast:{t:0, dur:.6, sx:0, sy:0, ex:0, arc:40}, ret:{t:0, sx:0, sy:0},
  bite:{fish:null, t:0}, hooked:null, landed:null, landAnim:null, relAnim:null,
  reel:{}, rig:{}
};
const T = {x:0, y:0, ang:0, spd:0, keys:{}, wake:[], wakeT:0, saveT:0, fogT:0, ptr:null, bumpT:0, hover:null};
const surfY = x => SURF + Math.sin(x*.065 + time*1.6)*1.2 + Math.sin(x*.16 - time*2.3)*.6;
const depthToY = (d, x) => surfY(x) + d*FT;
const lureCap = () => Math.min(rod().depth, LAKE_FT - .6);
const isWet = () => ['sinking','waiting','bite','reeling'].includes(G.state);

// Deeper zones and hot spots shift the odds toward rarer fish, and custom fish favor the deep
function pickSpecies(pool){
  pool = pool || RT;
  const b = bait().boost, Z = ZONE + (HOT ? 1 : 0); let tot = 0;
  const ws = pool.map(sp => { const w = RAR_WEIGHT[sp.rarity]*Math.pow(1+b, sp.rarity)*Math.pow(1+.55*Z, sp.rarity)*(sp.custom ? 1.5 + Z*1.2 : 1); tot+=w; return w; });
  let r = Math.random()*tot;
  for(let i=0;i<pool.length;i++){ r -= ws[i]; if(r<=0) return pool[i]; }
  return pool[0];
}
// Fish only appear in their own biomes, and time-of-day fish only in their window
const fitsNow = sp => (!sp.time || sp.time === periodNow().id) && (!sp.biomes || sp.biomes.includes(BIOMES[BIOME].id));
function pickForDepth(d){
  const fit = RT.filter(sp => sp.dmin < LAKE_FT-1 && fitsNow(sp));
  const pool = fit.filter(sp => sp.dmin-4 <= d && sp.dmax+4 >= d);
  return pickSpecies(pool.length ? pool : (fit.length ? fit : RT.slice(0,1)));
}
function spawnFish(sp, inView, depth){
  if(!sp){ const d = depth ?? 1 + (LAKE_FT-3)*Math.pow(Math.random(), 1.3); sp = pickForDepth(d); depth = clamp(d, sp.dmin, sp.dmax); }
  depth = clamp(depth ?? rand(sp.dmin, sp.dmax), .8, LAKE_FT-1);
  const dir = Math.random()<.5 ? 1 : -1;
  const x = inView ? rand(BOAT_X+30, W-16) : (dir>0 ? -24 : W+24);
  const f = {def:sp, x, depth, y:0, dir, speed:5+sp.speed*2.6, ph:rand(0,6.28), ft:rand(0,3), mode:'roam', cd:rand(.3,1.5), turnT:rand(3,9), leapCd:1.5};
  f.y = depthToY(depth, x);
  fishes.push(f); return f;
}

/* ================== Audio ================== */
let AC = null;
function ac(){ if(!AC){ try{ AC = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} } return AC; }
function tone(f,d,type='square',v=.05,to){ const a=ac(); if(!a) return; const o=a.createOscillator(), g=a.createGain(), t=a.currentTime; o.type=type; o.frequency.setValueAtTime(f,t); if(to) o.frequency.exponentialRampToValueAtTime(to,t+d); g.gain.setValueAtTime(v,t); g.gain.exponentialRampToValueAtTime(.0001,t+d); o.connect(g).connect(a.destination); o.start(t); o.stop(t+d+.02); }
function noise(d,v,freq){ const a=ac(); if(!a) return; const n=Math.floor(a.sampleRate*d), b=a.createBuffer(1,n,a.sampleRate), ch=b.getChannelData(0); for(let i=0;i<n;i++) ch[i]=(Math.random()*2-1)*(1-i/n); const s=a.createBufferSource(); s.buffer=b; const fl=a.createBiquadFilter(); fl.type='lowpass'; fl.frequency.value=freq; const g=a.createGain(); g.gain.value=v; s.connect(fl).connect(g).connect(a.destination); s.start(); }
const SFX = {
  cast:()=>tone(420,.18,'triangle',.05,900),
  splash:()=>noise(.3,.18,900),
  bigsplash:()=>{ noise(.45,.26,700); tone(180,.25,'sine',.06,60); },
  bite:()=>{ tone(880,.07,'square',.05); setTimeout(()=>tone(1180,.09,'square',.05),70); },
  hook:()=>tone(260,.16,'sawtooth',.05,720),
  tick:()=>tone(1500,.02,'square',.015),
  snap:()=>{ noise(.18,.25,3200); tone(620,.32,'sawtooth',.05,70); },
  miss:()=>tone(330,.28,'triangle',.05,140),
  leap:()=>tone(500,.22,'triangle',.05,1100),
  flop:()=>{ noise(.08,.12,600); setTimeout(()=>noise(.06,.09,700),110); },
  catch:()=>[523,659,784,1047].forEach((f,i)=>setTimeout(()=>tone(f,.13,'square',.045),i*80)),
  coin:()=>{ tone(988,.06,'square',.04); setTimeout(()=>tone(1319,.14,'square',.04),60); },
  thrash:()=>noise(.12,.08,1400),
  anchor:()=>{ noise(.5,.16,450); tone(150,.35,'sine',.06,70); },
  sail:()=>{ tone(330,.12,'triangle',.04,440); setTimeout(()=>tone(440,.16,'triangle',.04,660),100); },
  bump:()=>noise(.12,.14,300),
  found:()=>[660,880,990].forEach((f,i)=>setTimeout(()=>tone(f,.1,'triangle',.045),i*90)),
};
SFX.boom = () => { noise(1.1,.55,420); noise(.35,.3,2600); tone(120,.8,'sine',.14,28); };
SFX.fuse = () => noise(.05,.035,5000);
SFX.shot = () => { noise(.16,.4,3200); tone(150,.14,'square',.07,55); };
SFX.blast = () => { noise(.3,.5,2200); tone(110,.2,'square',.08,40); };
SFX.rifle = () => { noise(.22,.45,4200); tone(220,.2,'sawtooth',.07,50); setTimeout(()=>noise(.4,.06,900), 60); };
SFX.bolt = () => { tone(700,.04,'square',.04); setTimeout(()=>tone(420,.05,'square',.04),80); };
SFX.dry = () => tone(900,.03,'square',.03);
SFX.click = () => tone(1300,.025,'square',.03);
SFX.cock = () => { tone(520,.04,'square',.04); setTimeout(()=>tone(820,.04,'square',.035),60); };
SFX.tink = () => tone(2600,.05,'triangle',.02);
SFX.thunk = () => noise(.08,.16,700);
SFX.growl = () => { tone(95,.7,'sawtooth',.06,48); noise(.6,.08,300); };
SFX.whack = () => { noise(.12,.3,900); tone(160,.18,'square',.07,70); };
SFX.claw = () => { noise(.2,.2,3500); tone(700,.12,'sawtooth',.04,200); };
SFX.zap = () => { noise(.35,.32,6000); tone(1800,.3,'sawtooth',.05,90); setTimeout(()=>noise(.25,.12,2500), 50); };
SFX.zapboom = () => { noise(.7,.45,5000); tone(900,.6,'sawtooth',.07,40); noise(.8,.3,500); };
SFX.hum = () => tone(240,.5,'sine',.04,520);
SFX.jump = () => tone(300,.12,'square',.03,620);
SFX.net = () => { noise(.3,.14,650); tone(220,.15,'triangle',.03,160); };
let lastTick = 0;
function sfx(n){ if(!S.sound) return; const a=ac(); if(!a) return; if(a.state==='suspended') a.resume(); SFX[n] && SFX[n](); }
function buzz(ms){ if(navigator.vibrate) try{ navigator.vibrate(ms); }catch(e){} }
function doShake(v){ if(S.shake) shake = Math.max(shake, v); }

/* ================== Splash effects & particles (side view) ================== */
function splashFX(x, size=1){
  const y = surfY(x);
  parts.push({t:'crown', x, life:.42+size*.08, max:.42+size*.08, size});
  for(let i=0;i<1+size;i++) parts.push({t:'ripple', x, r:2+i*3, v:14+size*6, life:.9+i*.25, max:.9+i*.25});
  const n = 6 + size*7;
  for(let i=0;i<n;i++) parts.push({t:'drop', x:x+rand(-2-size,2+size), y:y-1, vx:rand(-24,24)*(.6+size*.35), vy:-rand(28,52)*(.6+size*.3), life:rand(.5,1), c: Math.random()<.5?'#e6fbfc':'#8fd6e2'});
  for(let i=0;i<n/2;i++) parts.push({t:'bub', x:x+rand(-4,4), y:y+rand(3,8+size*4), vx:0, vy:rand(-18,-8), life:rand(.8,1.6), ph:rand(0,6)});
}
function bubbles(x,y,n=3){ for(let i=0;i<n;i++) parts.push({t:'bub', x:x+rand(-2,2), y:y+rand(-2,2), vx:0, vy:rand(-22,-10), life:rand(1,2.5), ph:rand(0,6)}); }
function updateParts(dt){
  for(const p of parts){
    p.life -= dt;
    if(p.t==='drop'){ p.vy += 200*dt; p.x += p.vx*dt; p.y += p.vy*dt; if(p.vy>0 && p.y>surfY(p.x)){ p.life=0; if(Math.random()<.25) parts.push({t:'ripple', x:p.x, r:1, v:8, life:.4, max:.4}); } }
    else if(p.t==='bub'){ p.y += p.vy*dt; p.x += Math.sin(time*4+p.ph)*.25; if(p.y < surfY(p.x)+1) p.life=0; }
    else if(p.t==='spark'){ p.x += p.vx*dt; p.y += p.vy*dt; p.vy += 60*dt; }
    else if(p.t==='ripple'){ p.r += p.v*dt; }
    else if(p.t==='debris'){ p.x += p.vx*dt; p.y += p.vy*dt; p.vx *= .94; p.vy = p.vy*.94 + 10*dt; }
  }
  parts = parts.filter(p=>p.life>0);
  if(Math.random()<dt*2.5){ const y = Math.min(BED_Y-2, camY+H+4); parts.push({t:'bub', x:rand(0,W), y, vx:0, vy:rand(-14,-6), life:8, ph:rand(0,6)}); }
  if(parts.length>500) parts.splice(0, parts.length-500);
}
function drawSplashes(){
  for(const p of parts){
    if(p.t==='ripple'){
      const a = Math.max(0, p.life/p.max)*.8, sy = surfY(p.x);
      ctx.fillStyle = `rgba(220,248,250,${a})`;
      for(let k=0;k<16;k++){ const ang = k/16*Math.PI*2; ctx.fillRect(Math.round(p.x+Math.cos(ang)*p.r), Math.round(sy+Math.sin(ang)*p.r*.22), 1, 1); }
    } else if(p.t==='shock'){
      const k = 1 - p.life/p.max, r = p.R*Math.min(1, .25 + k*1.1), a = (1-k);
      ctx.fillStyle = `rgba(255,244,210,${a})`;
      for(let q=0;q<40;q++){ const an = q/40*Math.PI*2; ctx.fillRect(Math.round(p.x+Math.cos(an)*r), Math.round(p.y+Math.sin(an)*r), 1, 1); }
      ctx.fillStyle = `rgba(255,138,61,${a*.8})`;
      for(let q=0;q<28;q++){ const an = q/28*Math.PI*2 + .1; ctx.fillRect(Math.round(p.x+Math.cos(an)*(r-2)), Math.round(p.y+Math.sin(an)*(r-2)), 1, 1); }
    } else if(p.t==='glow'){
      const k = p.life/p.max; ctx.save(); ctx.globalCompositeOperation='lighter';
      const g = ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.R*1.2); g.addColorStop(0,`rgba(255,240,190,${k})`); g.addColorStop(.4,`rgba(255,150,60,${k*.7})`); g.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle = g; ctx.fillRect(p.x-p.R*1.2, p.y-p.R*1.2, p.R*2.4, p.R*2.4); ctx.restore();
    } else if(p.t==='crown'){
      const k = 1 - p.life/p.max, h = Math.sin(Math.min(1,k*1.15)*Math.PI)*(5+p.size*5), sy = Math.round(surfY(p.x)), n = 1+p.size;
      for(let i=-n;i<=n;i++){
        const ch = Math.round(h*(1-Math.abs(i)/(n+1)) + (i%2?1:0)), x = Math.round(p.x + i*2*(1+k*.8));
        if(ch<=0) continue;
        ctx.fillStyle='rgba(170,230,238,.75)'; ctx.fillRect(x, sy-ch, 2, ch);
        ctx.fillStyle='rgba(245,253,255,.95)'; ctx.fillRect(x, sy-ch, 2, 1);
      }
      ctx.fillStyle='rgba(245,253,255,.6)'; ctx.fillRect(Math.round(p.x-n*2-2), sy, n*4+6, 1);
    }
  }
}

/* ================== Input ================== */
const anyDialog = () => !!document.querySelector('dialog[open]');
const fishInput = () => G.mode==='fish' && !G.trans && !anyDialog();
const swActive = () => !!(M && !['dying','leave'].includes(M.state));
let swCastWarnT = 0;
function press(){
  if(!fishInput()) return;
  ac();
  if(M && M.strikeOpen){ strikeSaltwight(); return; }
  holding = true; holdFromWaiting = false;
  switch(G.state){
    case 'idle':
      if(swActive() && !isGun(G.tool)){ holding = false; if(time - swCastWarnT > 3){ swCastWarnT = time; if(S.seen.swwarn) toast("Not with the Saltwight here."); } return; }
      if(G.tool==='net'){ if(S.net<0) return; if(S.inv.length >= boat().cap){ toast('Your hold is full. Sail back to the harbor to sell first.'); holding=false; return; } G.state='charging'; G.chargeTool='net'; G.power=0; G.pdir=1; return; }
      if(G.tool==='dyn'){ holding=false; throwDyn(); return; }
      if(isGun(G.tool)){ holding=false; fireGun(); return; }
      if(S.inv.length >= boat().cap){ toast('Your hold is full. Sail back to the harbor to sell, or upgrade your boat.'); holding=false; return; }
      G.state='charging'; G.chargeTool='rod'; G.power=0; G.pdir=1; break;
    case 'sinking': G.state='waiting'; markSeen('sink'); break;
    case 'waiting': holdFromWaiting = true; break;
    case 'bite': hook(); break;
    case 'net': holding=false; if(G.net && G.net.phase!=='up'){ G.net.phase='up'; sfx('net'); markSeen('net2'); } break;
  }
}
function release(){ holding = false; holdFromWaiting = false; if(G.state==='charging'){ if(swActive()){ G.state = 'idle'; G.power = 0; return; } if(G.chargeTool==='net') castNet(); else castLine(); } }
/* Ghost joystick (touch screens, sailing only): put a thumb down anywhere that isn't a button
   and a stick appears under it. Drag to steer; the further you drag, the faster you sail. */
const IS_TOUCH_EARLY = matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 0;
const joyEl = $('joy'), joyKnob = joyEl.querySelector('i'), JOY_R = 54;
function joyStart(e){
  if(e.pointerType!=='touch' || (G.mode!=='travel' && G.mode!=='land') || G.trans || anyDialog() || T.joy) return;
  if(G.mode==='land' && e.clientX >= innerWidth*.45) return;
  if(e.target.closest('button, a, input, select, label, dialog, .chip, #mini, .pad, #tools, #actions')) return;
  e.preventDefault(); ac();
  T.joy = {id:e.pointerId, x0:e.clientX, y0:e.clientY, dx:0, dy:0};
  joyEl.style.left = e.clientX + 'px'; joyEl.style.top = e.clientY + 'px'; joyKnob.style.transform = 'translate(-50%,-50%)';
  joyEl.hidden = false; requestAnimationFrame(() => joyEl.classList.add('on'));
}
function joyMove(e){
  const J = T.joy; if(!J || e.pointerId !== J.id) return;
  let dx = e.clientX - J.x0, dy = e.clientY - J.y0; const d = Math.hypot(dx, dy);
  if(d > JOY_R){ // drag past the edge and the stick follows your thumb
    const k = (d - JOY_R)/d; J.x0 += dx*k; J.y0 += dy*k; dx -= dx*k; dy -= dy*k;
    joyEl.style.left = J.x0 + 'px'; joyEl.style.top = J.y0 + 'px';
  }
  J.dx = dx; J.dy = dy; joyKnob.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
}
function joyEnd(e){ const J = T.joy; if(!J || (e && e.pointerId !== J.id)) return; T.joy = null; joyEl.classList.remove('on'); setTimeout(() => { if(!T.joy) joyEl.hidden = true; }, 160); }
window.addEventListener('pointerdown', joyStart, {passive:false});
window.addEventListener('pointermove', joyMove);
window.addEventListener('pointerup', joyEnd); window.addEventListener('pointercancel', joyEnd);
function canvasPoint(e){ const r = cvs.getBoundingClientRect(); return {x:(e.clientX-r.left)/r.width*W, y:(e.clientY-r.top)/r.height*H}; }
cvs.addEventListener('pointerdown', e => {
  if(e.button!==0 && e.pointerType==='mouse') return;
  e.preventDefault(); cvs.setPointerCapture?.(e.pointerId); ac();
  if(G.mode==='travel'){ if(e.pointerType==='touch' && IS_TOUCH_EARLY) return; if(!anyDialog() && !G.trans) T.ptr = canvasPoint(e); return; }
  if(G.mode==='land'){ if(e.pointerType==='touch' && e.clientX < innerWidth*.45) return; if(!anyDialog() && !G.trans){ T.hover = canvasPoint(e); landFire(); } return; }
  T.hover = canvasPoint(e);
  press();
});
cvs.addEventListener('pointermove', e => { T.hover = canvasPoint(e); if(T.ptr) T.ptr = canvasPoint(e); });
window.addEventListener('pointerup', () => { T.ptr = null; release(); });
window.addEventListener('pointercancel', () => { T.ptr = null; release(); });
cvs.addEventListener('contextmenu', e => e.preventDefault());
cvs.addEventListener('wheel', e => {
  e.preventDefault(); if(!fishInput()) return;
  const dy = e.deltaY;
  if(G.state==='reeling'){
    G.reel.wheel = Math.min(1.6, G.reel.wheel + clamp(Math.abs(dy)/400, .04, .3));
    if(performance.now()-lastTick>60){ lastTick=performance.now(); sfx('tick'); }
  } else nudge(Math.sign(dy));
}, {passive:false});
// move the lure or the dynamite one step deeper (+1) or shallower (-1)
function nudge(sign){
  if(!sign) return;
  if(isGun(G.tool) && G.state==='idle'){ G.gun.view = clamp(G.gun.view + sign*30, 0, gunViewMax()); return; }
  if(G.state==='dyn' && G.dyn && G.dyn.phase!=='boom'){
    G.dyn.target = clamp(G.dyn.target + sign*2, .5, dynMaxDepth());
  } else if(G.state==='waiting' || G.state==='sinking'){
    if(G.state==='sinking') G.state='waiting';
    G.lure.depth = clamp(G.lure.depth + sign*(rod().depth>100 ? 4 : rod().depth>40 ? 2 : 1), .5, lureCap());
  } else return;
  if(performance.now()-lastTick>60){ lastTick=performance.now(); sfx('tick'); }
}
const KEYMAP = {KeyW:'up', ArrowUp:'up', KeyS:'down', ArrowDown:'down', KeyA:'left', ArrowLeft:'left', KeyD:'right', ArrowRight:'right'};
window.addEventListener('keydown', e => {
  const tag = (e.target.tagName||'').toLowerCase();
  if(tag==='input'||tag==='select'||tag==='textarea') return;
  if(anyDialog()) return; // dialogs handle their own keys, including Esc
  if(KEYMAP[e.code]){ T.keys[KEYMAP[e.code]] = true; if(e.code.startsWith('Arrow')) e.preventDefault(); }
  if(G.mode==='land'){
    if(e.code==='Space' || e.code==='KeyW' || e.code==='ArrowUp'){ e.preventDefault(); if(!e.repeat){ heroJump(); HERO.jumpHeld = true; } return; }
    if(e.repeat) return;
    const k = e.key.toLowerCase();
    if(k==='escape' || k==='e') returnToSail();
    else if(k==='q') openDlg('wheelDlg');
    else if(k==='r' && isGun(G.tool)) startReload();
    else if(k==='t' && isGun(G.tool) && WEAPONS[G.tool].bolt) toggleAmmo();
    else if(k >= '1' && k <= '9' && k.length===1){ const t = wheelTools()[+k-1]; if(t) selectTool(t); }
    else if(k==='i') toggleDlg('invDlg'); else if(k==='g' || k==='`') toggleDlg('adminDlg');
    return;
  }
  if(G.mode==='travel' && !e.repeat && (e.key==='l' || e.key==='L' || ((e.key==='e' || e.key==='E') && !nearHarbor())) && nearShore()){ tryGoAshore(); return; }
  if(e.code==='Space'){
    e.preventDefault(); if(e.repeat) return;
    if(G.mode==='travel') tryStartFishing(); else press();
    return;
  }
  if(e.repeat) return;
  const k = e.key.toLowerCase();
  if(G.mode==='fish' && k >= '1' && k <= '9' && k.length===1){ const t = wheelTools()[+k-1]; if(t) selectTool(t); return; }
  if(k==='t' && G.mode==='fish' && isGun(G.tool) && WEAPONS[G.tool].bolt && G.state==='idle'){ toggleAmmo(); return; }
  if(k==='q' && G.mode==='fish'){ openDlg('wheelDlg'); return; }
  if(k==='r' && G.mode==='fish' && isGun(G.tool) && G.state==='idle'){ startReload(); return; }
  if(k==='escape' && G.mode==='fish') returnToSail();
  else if(k==='e' && G.mode==='travel') tryEnterHarbor();
  else if(k==='p'){ if(G.mode==='travel' && nearHarbor()) openDlg('shopDlg'); else toast('Sail up to the harbor and press E to shop.'); }
  else if(k==='i') toggleDlg('invDlg');
  else if(k==='g' || k==='`') toggleDlg('adminDlg');
  else if(k==='r' && G.mode==='fish' && (G.state==='waiting'||G.state==='sinking'||G.state==='bite')) startRetrieve();
  else if(k==='m'){ S.sound=!S.sound; save(); $('optSound').checked=S.sound; toast(S.sound?'Sound on':'Sound off'); }
});
window.addEventListener('keyup', e => { if(KEYMAP[e.code]) T.keys[KEYMAP[e.code]] = false; if(e.code==='Space' || e.code==='KeyW' || e.code==='ArrowUp') HERO.jumpHeld = false; if(e.code==='Space') release(); });
window.addEventListener('blur', ()=>{ holding=false; T.keys={}; T.ptr=null; joyEnd(); });
addEventListener('visibilitychange', ()=>{ if(document.hidden) saveWorld(); });
addEventListener('beforeunload', () => { if(!POPPED) saveWorld(); });

/* ================== Travel mode ================== */
const nearHarbor = () => WORLD && Math.hypot(T.x - WORLD.harbor.wx, T.y - WORLD.harbor.wy) < 6*TS;
const stopped = () => Math.abs(T.spd) < 3;
function tryEnterHarbor(){ if(nearHarbor()) openDlg('shopDlg'); }
function tryStartFishing(){
  if(G.trans || !WORLD) return;
  if(!stopped()){ toast('Let go of the throttle and slow to a stop before casting.'); return; }
  const info = waterHere(); if(!info) return;
  G.trans = {t:0, dur:1.1, to:'fish', info, switched:false};
  sfx('anchor');
}
function returnToSail(){
  if(G.trans) return;
  if(G.mode==='land'){ G.trans = {t:0, dur:1, to:'travel', switched:false}; sfx('sail'); return; }
  if(G.mode!=='fish') return;
  if(['reeling','landing','landed'].includes(G.state)){ toast('Land this fish or let it go before you sail.'); return; }
  if(G.state==='net' || G.state==='dyn'){ toast('Wait for the net or the blast to finish before you sail.'); return; }
  G.trans = {t:0, dur:1, to:'travel', switched:false};
  sfx('sail');
}
function updateTrans(dt){
  const tr = G.trans; tr.t += dt;
  if(!tr.switched && tr.t >= tr.dur/2){
    tr.switched = true;
    if(tr.to==='land'){ enterIsland(tr.isl); G.mode='land'; }
    else if(tr.to==='fish'){
      setLake(tr.info); G.mode='fish'; camY = 40;
      const zl = BIOMES[BIOME].name;
      if(tr.info.spot) toast(`Hot spot! ${zl}.`); else if(!S.seen['bio:'+BIOME]) toast(`${zl}, ${depthLabel(tr.info.depth)} deep.`);
      markSeen('bio:'+BIOME);
    } else { if(M) toast('You left the Saltwight behind.'); M = null; if(G.mode==='land'){ ISL = null; LB = []; LO = []; G.bolts = []; } G.mode='travel'; G.state='idle'; holding=false; saveWorld(); }
    document.body.dataset.mode = G.mode;
  }
  if(tr.t >= tr.dur) G.trans = null;
}
function revealAround(force){
  const w = WORLD, R = boat().vision, tx = T.x/TS, ty = T.y/TS, N = w.N; let changed = false;
  for(let y=Math.floor(ty-R-3); y<=Math.ceil(ty+R+3); y++) for(let x=Math.floor(tx-R-3); x<=Math.ceil(tx+R+3); x++){
    if(x<0||y<0||x>=N||y>=N) continue;
    const i = y*N+x, d = Math.hypot(x+.5-tx, y+.5-ty), v = Math.round(clamp((R+2.5-d)/3, 0, 1)*255);
    if(v > w.fog[i]){ w.fog[i] = v; w.fogImg.data[i*4+3] = 255 - v; changed = true; }
  }
  if(changed || force){ w.fogDirty = true; T.fogChanged = true; }
  for(const s of w.spots){ if(!s.found && w.fog[s.y*N+s.x] > 170){ s.found = true; sfx('found'); toast('You found a fishing hot spot. Fish gather here, and rarer ones bite more.'); } }
}
function updateTravel(dt){
  const b = boat(), k = T.keys;
  let turn = (k.left?-1:0) + (k.right?1:0), thr = (k.up?1:0) - (k.down?1:0);
  if(T.ptr && !G.trans){ // touch or mouse: steer toward the pointer
    const cam = travelCam(1), wx = cam.x + T.ptr.x, wy = cam.y + T.ptr.y;
    const want = Math.atan2(wy - T.y, wx - T.x); let d = want - T.ang; d = Math.atan2(Math.sin(d), Math.cos(d));
    turn = clamp(d*3, -1, 1); thr = Math.hypot(wx-T.x, wy-T.y) > 14 ? 1 : 0;
  }
  let cap = 1;
  if(T.joy && !G.trans){
    const J = T.joy, m = Math.hypot(J.dx, J.dy)/JOY_R;
    if(m > .18){ const want = Math.atan2(J.dy, J.dx); let d = want - T.ang; d = Math.atan2(Math.sin(d), Math.cos(d)); turn = clamp(d*3, -1, 1); thr = Math.abs(d) > 2.4 && T.spd < 4 ? 0 : 1; cap = clamp((m - .18)/.7, .3, 1); }
    else { turn = 0; thr = 0; }
  }
  if(G.mode==='fish' && T.joy) joyEnd();
  if(G.trans || anyDialog()){ turn = 0; thr = 0; }
  T.ang += turn*2.6*dt*(.45 + .55*Math.min(1, Math.abs(T.spd)/b.speed + .25));
  if(thr>0) T.spd += 38*dt; else if(thr<0) T.spd -= 55*dt; else T.spd *= Math.pow(.3, dt);
  T.spd = clamp(T.spd, -b.speed*.4, b.speed); if(T.spd > b.speed*cap) T.spd = Math.max(b.speed*cap, T.spd - 60*dt); if(!thr && Math.abs(T.spd) < .4) T.spd = 0;
  const ca = Math.cos(T.ang), sa = Math.sin(T.ang);
  const nx = T.x + ca*T.spd*dt, ny = T.y + sa*T.spd*dt, bow = Math.sign(T.spd||1)*5;
  const ok = (x,y) => isWaterPx(x,y) && isWaterPx(x+ca*bow, y+sa*bow);
  if(ok(nx,ny)){ T.x = nx; T.y = ny; }
  else if(ok(nx,T.y)){ T.x = nx; T.spd *= .96; }
  else if(ok(T.x,ny)){ T.y = ny; T.spd *= .96; }
  else { if(Math.abs(T.spd) > 8 && T.bumpT <= 0){ sfx('bump'); doShake(2); T.bumpT = .5; } T.spd *= -.25; }
  T.bumpT -= dt;
  if(Math.abs(T.spd) > 10 && !S.seen.sail) markSeen('sail');
  revealAround();
  // Wake: two trails off the stern plus a little bow spray
  T.wakeT -= dt;
  const sp = Math.abs(T.spd), L = TOP_BOATS[S.boat].L;
  if(sp > 4 && T.wakeT <= 0){
    T.wakeT = .035;
    const sx = T.x - ca*L/2, sy = T.y - sa*L/2;
    for(const side of [-1,1]) T.wake.push({x:sx - sa*side*2, y:sy + ca*side*2, vx:-sa*side*sp*.22 - ca*4, vy:ca*side*sp*.22 - sa*4, life:1.3, max:1.3});
    if(sp > b.speed*.6) T.wake.push({x:T.x + ca*L/2 + rand(-1,1), y:T.y + sa*L/2 + rand(-1,1), vx:rand(-6,6), vy:rand(-6,6), life:.4, max:.4, spray:true});
  }
  for(const p of T.wake){ p.life -= dt; p.x += p.vx*dt; p.y += p.vy*dt; p.vx *= .97; p.vy *= .97; }
  T.wake = T.wake.filter(p => p.life > 0);
  T.saveT -= dt; if(T.saveT <= 0){ T.saveT = 4; if(T.fogChanged){ T.fogChanged = false; saveWorld(); } }
}
function travelCam(zoom){
  const vw = W/zoom, vh = H/zoom, max = WORLD.N*TS;
  let x = T.x - vw/2, y = T.y - vh/2;
  if(zoom===1){ x = clamp(x, 0, max - vw); y = clamp(y, 0, max - vh); x = Math.round(x); y = Math.round(y); }
  return {x, y, vw, vh};
}
function renderTravel(zoom){
  const w = WORLD, cam = travelCam(zoom);
  ctx.setTransform(1,0,0,1,0,0); ctx.fillStyle = '#081222'; ctx.fillRect(0,0,W,H);
  ctx.setTransform(zoom,0,0,zoom,-cam.x*zoom,-cam.y*zoom);
  const max = w.N*TS, sx = Math.max(0, Math.floor(cam.x)), sy = Math.max(0, Math.floor(cam.y));
  const sw = Math.min(max - sx, Math.ceil(cam.vw)+2), sh = Math.min(max - sy, Math.ceil(cam.vh)+2);
  ctx.drawImage(w.mapC, sx, sy, sw, sh, sx, sy, sw, sh);
  // Glints on open water
  const t0x = Math.floor(sx/TS), t0y = Math.floor(sy/TS), t1x = Math.ceil((sx+sw)/TS), t1y = Math.ceil((sy+sh)/TS);
  for(let ty=t0y; ty<t1y; ty++) for(let tx=t0x; tx<t1x; tx++){
    const h = hash2(tx, ty); if(h % 19) continue;
    const i = ty*w.N+tx; if(i<0 || i>=w.land.length || w.land[i] || w.depth[i] >= ABYSS_D) continue;
    const a = Math.sin(time*1.8 + (h%628)/100); if(a < .4) continue;
    ctx.fillStyle = `rgba(220,250,250,${(a-.4)*.9})`; ctx.fillRect(tx*TS + (h>>5)%3, ty*TS + (h>>8)%3, 2, 1);
  }
  // Hot spots: ripples and a fish that jumps now and then
  for(const s of w.spots){
    if(s.wx < cam.x-30 || s.wx > cam.x+cam.vw+30 || s.wy < cam.y-30 || s.wy > cam.y+cam.vh+30) continue;
    for(let k=0;k<3;k++){ const r = (time*9 + k*6 + s.ph*3) % 18, a = (1 - r/18)*.8; ctx.fillStyle = `rgba(200,250,255,${a})`;
      for(let q=0;q<14;q++){ const an = q/14*Math.PI*2; ctx.fillRect(Math.round(s.wx + Math.cos(an)*r), Math.round(s.wy + Math.sin(an)*r*.8), 1, 1); } }
    const ph = (time + s.ph) % 3.2;
    if(ph < .6){ const p = ph/.6, fx = s.wx + (p-.5)*10, fy = s.wy - Math.sin(Math.PI*p)*6;
      ctx.fillStyle = 'rgba(12,30,44,.85)'; ctx.fillRect(Math.round(fx)-1, Math.round(fy), 3, 2); ctx.fillRect(Math.round(fx)-2 + (p<.5?0:4), Math.round(fy)-1, 1, 1);
      if(p > .9 || p < .1){ ctx.fillStyle='rgba(235,253,255,.9)'; ctx.fillRect(Math.round(fx)-2, Math.round(s.wy)+1, 5, 1); } }
    if(s.found && Math.floor(time*2)%2){ ctx.fillStyle = 'rgba(127,240,224,.7)'; ctx.fillRect(Math.round(s.wx), Math.round(s.wy), 1, 1); }
  }
  drawHarbor(w.harbor);
  // Wake under the boat
  for(const p of T.wake){ const a = p.life/p.max; ctx.fillStyle = p.spray ? `rgba(255,255,255,${a})` : `rgba(225,248,250,${a*.75})`; ctx.fillRect(Math.round(p.x), Math.round(p.y), a>.6 && !p.spray ? 2 : 1, 1); }
  drawTopBoat();
  // Time of day: tint the map, then let the lighthouse and the boat's lantern shine
  applyDayTint();
  drawTravelBeam(zoom, cam, sx, sy, sw, sh);
  const n = nightK();
  if(n > 0){
    const h = w.harbor, lx = Math.round(h.wx-4)+.5, ly = Math.round(h.wy-7)+.5;
    lanternGlow(lx, ly, 26, n);
    ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = n; ctx.translate(lx, ly); ctx.rotate(time*1.1);
    const g = ctx.createLinearGradient(0,0,90,0); g.addColorStop(0,'rgba(255,236,170,.5)'); g.addColorStop(1,'rgba(255,236,170,0)');
    ctx.fillStyle = g; ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(90,-14); ctx.lineTo(90,14); ctx.closePath(); ctx.fill(); ctx.restore();
    lanternGlow(T.x, T.y, 20, n*.9);
    ctx.fillStyle = `rgba(255,226,150,${n})`; ctx.fillRect(Math.round(T.x - Math.cos(T.ang)*3), Math.round(T.y - Math.sin(T.ang)*3), 1, 1);
  }
  ctx.setTransform(1,0,0,1,0,0);
  ctx.drawImage(vigC, 0, 0);
}
function drawHarbor(h){
  const x = h.wx, y = h.wy;
  // Dock running east into the water
  ctx.fillStyle = '#7a5530'; ctx.fillRect(Math.round(x+2), Math.round(y-1), 14, 3);
  ctx.fillStyle = '#9c7444'; for(let i=0;i<14;i+=3) ctx.fillRect(Math.round(x+2+i), Math.round(y-1), 2, 3);
  ctx.fillStyle = '#4a3420'; ctx.fillRect(Math.round(x+15), Math.round(y+2), 1, 1); ctx.fillRect(Math.round(x+7), Math.round(y+2), 1, 1);
  // Bait shop: orange roof
  ctx.fillStyle = '#e8e0cc'; ctx.fillRect(Math.round(x-9), Math.round(y+2), 8, 6);
  ctx.fillStyle = '#ff6a3d'; ctx.fillRect(Math.round(x-10), Math.round(y+1), 10, 3);
  ctx.fillStyle = '#b8401f'; ctx.fillRect(Math.round(x-10), Math.round(y+3), 10, 1);
  // Lighthouse, seen from above: striped ring with a lamp
  const lx = Math.round(x-4), ly = Math.round(y-7);
  ctx.fillStyle = '#f2ede0'; ctx.fillRect(lx-2, ly-2, 5, 5);
  ctx.fillStyle = '#d84f3a'; ctx.fillRect(lx-2, ly, 5, 1); ctx.fillRect(lx, ly-2, 1, 5);
  ctx.fillStyle = '#ffe9a8'; ctx.fillRect(lx, ly, 1, 1);
  ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.translate(lx+.5, ly+.5); ctx.rotate(time*1.1);
  const g = ctx.createLinearGradient(0,0,60,0); g.addColorStop(0,'rgba(255,236,170,.45)'); g.addColorStop(1,'rgba(255,236,170,0)');
  ctx.fillStyle = g; ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(60,-9); ctx.lineTo(60,9); ctx.closePath(); ctx.fill();
  const g2 = ctx.createRadialGradient(0,0,0,0,0,8); g2.addColorStop(0,'rgba(255,236,170,.6)'); g2.addColorStop(1,'rgba(255,236,170,0)'); ctx.fillStyle = g2; ctx.fillRect(-8,-8,16,16);
  ctx.restore();
}
function drawTopBoat(){
  const tb = TOP_BOATS[S.boat], a = ((Math.round(T.ang/(Math.PI*2)*32) % 32) + 32) % 32, fr = tb.frames[a];
  const bob = Math.sin(time*2.4) > .7 ? 1 : 0;
  ctx.drawImage(fr, Math.round(T.x - tb.SZ/2), Math.round(T.y - tb.SZ/2) + bob);
  const ca = Math.cos(T.ang), sa = Math.sin(T.ang), L = tb.L;
  const put = (u, v, c) => ctx.fillRect(Math.round(T.x + u*ca - v*sa - .5), Math.round(T.y + u*sa + v*ca - .5) + bob, 1, 1);
  // Catch on deck, matching the hold
  let n = 0; const n0 = S.inv.length;
  for(let u = -L*.05; u > -L/2+1.5 && n < n0; u -= 1.5){
    const hw = tb.halfW(u) - 1.4;
    for(let v = -hw; v <= hw && n < n0; v += 1.5){ const sp = byId[S.inv[n].sid], c = sp ? sp.dot : [150,170,180]; ctx.fillStyle = `rgb(${c})`; put(u, v); n++; }
  }
  // Fisher in a yellow coat with a green hat
  ctx.fillStyle = '#f2c14e'; put(L*.18, 0); put(L*.18, 1);
  ctx.fillStyle = '#2f5d50'; put(L*.18+1, 0);
}
let miniT = 0;
function renderMini(){
  if(!WORLD) return;
  const w = WORLD, M = mini.width, span = Math.min(w.N, MINI_TILES)*TS, s = M/span;
  // window of the chart centered on the boat, kept inside the map
  const ox = clamp(T.x - span/2, 0, w.N*TS - span), oy = clamp(T.y - span/2, 0, w.N*TS - span);
  mctx.imageSmoothingEnabled = false; mctx.fillStyle = '#08121f'; mctx.fillRect(0,0,M,M);
  mctx.drawImage(w.mapC, ox, oy, span, span, 0, 0, M, M);
  if(w.fogDirty){ w.fogG.putImageData(w.fogImg, 0, 0); w.fogDirty = false; }
  mctx.imageSmoothingEnabled = true; mctx.drawImage(w.fogC, ox/TS, oy/TS, span/TS, span/TS, 0, 0, M, M); mctx.imageSmoothingEnabled = false;
  const toM = (wx, wy) => [(wx-ox)*s, (wy-oy)*s];
  // marker: drawn in place, or pinned to the edge as an arrow when off the chart window
  const marker = (wx, wy, fill, sz) => {
    let [mx, my] = toM(wx, wy); const inside = mx>=2 && my>=2 && mx<=M-2 && my<=M-2;
    if(!inside){
      const cx = M/2, cy = M/2, dx = mx-cx, dy = my-cy, k = Math.min((M/2-5)/Math.abs(dx||1e-6), (M/2-5)/Math.abs(dy||1e-6));
      mx = cx + dx*k; my = cy + dy*k;
      mctx.save(); mctx.translate(Math.round(mx), Math.round(my)); mctx.rotate(Math.atan2(dy, dx));
      mctx.fillStyle = '#081222'; mctx.beginPath(); mctx.moveTo(5,0); mctx.lineTo(-4,-5); mctx.lineTo(-4,5); mctx.closePath(); mctx.fill();
      mctx.fillStyle = fill; mctx.beginPath(); mctx.moveTo(4,0); mctx.lineTo(-3,-3.5); mctx.lineTo(-3,3.5); mctx.closePath(); mctx.fill();
      mctx.restore(); return;
    }
    mctx.fillStyle = '#081222'; mctx.fillRect(Math.round(mx)-sz/2-1, Math.round(my)-sz/2-1, sz+2, sz+2);
    mctx.fillStyle = fill; mctx.fillRect(Math.round(mx)-sz/2, Math.round(my)-sz/2, sz, sz);
  };
  for(const sp of w.spots) if(sp.found){ const [mx,my] = toM(sp.wx, sp.wy); if(mx>=0 && my>=0 && mx<=M && my<=M) marker(sp.wx, sp.wy, '#7ff0e0', 4); }
  marker(w.harbor.wx, w.harbor.wy, '#ff6a3d', 6);
  // boat as a small arrow
  const [bx, by] = toM(T.x, T.y);
  mctx.save(); mctx.translate(Math.round(bx)+.5, Math.round(by)+.5); mctx.rotate(T.ang);
  mctx.fillStyle = '#081222'; mctx.beginPath(); mctx.moveTo(7,0); mctx.lineTo(-5,-5); mctx.lineTo(-2,0); mctx.lineTo(-5,5); mctx.closePath(); mctx.fill();
  mctx.fillStyle = '#ffffff'; mctx.beginPath(); mctx.moveTo(5,0); mctx.lineTo(-4,-3.5); mctx.lineTo(-1.5,0); mctx.lineTo(-4,3.5); mctx.closePath(); mctx.fill();
  mctx.restore();
  const info = waterHere();
  $('miniLbl').textContent = info ? `${BIOMES[info.biome].name}, ${depthLabel(info.depth)}` : 'Chart';
}

/* ================== Fishing: boat geometry & deck pile ================== */
function boatGeom(){
  const b = boat(), L = b.len, left = Math.round(BOAT_X - L/2);
  const sink = Math.round(3*Math.min(1, invWeight()/b.maxW));
  const top = Math.round(surfY(BOAT_X) - 6 + sink);
  const fx = left + L - 24;
  return {L, left, top, fx, zx0: left + (S.boat>=2 ? 22 : 6), zx1: fx - 3};
}
function pileSlot(i, g){
  const Z = g.zx1 - g.zx0, sp = 6, base = Math.max(2, Math.floor(Z/sp));
  let r = 0, idx = i;
  for(;;){
    const cap = Math.max(2, base - Math.floor(r/2));
    if(idx < cap){ const x0 = g.zx0 + (Z - (cap-1)*sp)/2; return {x: x0 + idx*sp + ((i*37)%3) - 1, y: g.top - 1 - r*3}; }
    idx -= cap; r++;
  }
}

/* ================== Fishing actions ================== */
function castLine(){
  markSeen('cast');
  const r = G.rig, p = G.power;
  G.state='casting';
  G.cast = {t:0, dur:(.45+p*.45)/rod().cast, sx:r.tipX, sy:r.tipY, ex:Math.round(lerp(r.tipX+22, W-14, p)), arc:20+p*34};
  sfx('cast');
}
function hook(){
  markSeen('bite'); markSeen('wait');
  const f = G.bite.fish; if(!f) return;
  G.state='reeling'; G.hooked=f; f.mode='hooked'; f.leapCd = 2; G.bite.fish=null;
  G.reel = {tension:30, rate:0, wheel:0, slack:0, snapT:0, burstT:0, burstCd:rand(1,2.4), pull:0, stamina:1, phi:.8, intentT:rand(.8,1.8)};
  sfx('hook'); doShake(3); buzz(30);
}
function startRetrieve(){
  if(G.bite.fish){ fleeFish(G.bite.fish); G.bite.fish=null; }
  G.state='retrieve'; G.ret={t:0, sx:G.lure.x, sy:G.lure.y};
}
function fleeFish(f){ f.mode='flee'; f.jump=null; f.rot=0; f.dir = f.x > G.lure.x ? 1 : -1; f.speed *= 2.4; f.depth = Math.max(1.5, f.depth); bubbles(f.x, f.y, 4); }
function snapLine(){
  const f=G.hooked; if(f) fleeFish(f); G.hooked=null;
  for(let i=0;i<10;i++) parts.push({t:'spark', x:G.rig.tipX, y:G.rig.tipY, vx:rand(-40,40), vy:rand(-50,10), life:rand(.3,.6)});
  G.state='idle'; sfx('snap'); doShake(7); buzz([40,30,60]);
  toast('Line snapped! Ease off the reel when the gauge turns red.');
}
function escapeFish(){
  const f=G.hooked; if(f){ f.depth = G.lure.depth; fleeFish(f); } G.hooked=null;
  G.state='waiting'; G.lure.depth = Math.max(.5, G.lure.depth); sfx('miss');
  toast('It slipped the hook. Keep some tension on the line.');
}
function landFish(){
  markSeen('reel');
  const f = G.hooked, sp = f.def;
  const w = +(sp.wmin + (sp.wmax-sp.wmin)*Math.pow(Math.random(),1.6)).toFixed(2);
  const k = (w-sp.wmin)/((sp.wmax-sp.wmin)||1);
  const value = Math.max(1, Math.round(sp.value*(.6+.8*k)));
  fishes = fishes.filter(x=>x!==f); G.hooked=null;
  const g = boatGeom(), ok = fits(w);
  const target = ok ? pileSlot(S.inv.length, g) : {x:g.fx-4, y:g.top-3};
  G.landed = {sp, w, value, depth:G.lure.maxDepth, slot:target};
  G.landAnim = {t:0, dur:.85, sx:G.lure.x, sy:surfY(G.lure.x), tx:target.x, ty:target.y, spin:-1};
  G.state='landing';
  splashFX(G.lure.x, 2); sfx('bigsplash'); doShake(3); buzz(50);
}
function startLeap(f){
  f.jump = {t:0, dur:rand(.7,.95), x0:G.lure.x, vx:rand(8,22), h:rand(16,26)+f.def.rarity*2};
  f.leapCd = rand(4,7); f.jumpY = surfY(G.lure.x);
  splashFX(G.lure.x, 2); sfx('leap');
}

/* ================== Tools: net and dynamite ================== */
function toolReady(t){ return t==='rod' || (t==='net' && S.net>=0) || (t==='dyn' && S.dyn.count>0) || (isGun(t) && WS(t).lvl>=0); }
function selectTool(t){
  if(G.mode==='land'){ if(isGun(t) && toolReady(t)){ G.tool = t; sfx('tick'); } return; }
  if(G.mode!=='fish') return;
  if(G.state!=='idle'){ toast('Finish what you are doing first.'); return; }
  if(!toolReady(t)){ toast(t==='net' ? 'Buy a net at the harbor shop first.' : 'Buy dynamite at the harbor shop first.'); return; }
  G.tool = t; sfx('tick');
}
const newUid = () => Date.now().toString(36) + Math.random().toString(36).slice(2,6);
function rollCatch(sp){
  const w = +(sp.wmin + (sp.wmax-sp.wmin)*Math.pow(Math.random(),1.6)).toFixed(2);
  const k = (w-sp.wmin)/((sp.wmax-sp.wmin)||1);
  return {w, value:Math.max(1, Math.round(sp.value*(.6+.8*k)))};
}
// Put a batch of fish into the hold; each one flips onto the deck pile
function resolveHaul(list, title){
  const g = boatGeom(), rows = []; let kept = 0, total = 0;
  list.forEach((it, i) => {
    const sp = it.sp, {w, value} = rollCatch(sp), isNew = !S.caught[sp.id];
    S.caught[sp.id] = (S.caught[sp.id]||0) + 1;
    if(fits(w)){
      const uid = newUid(), slot = pileSlot(S.inv.length, g);
      S.inv.push({uid, sid:sp.id, name:sp.name, rarity:sp.rarity, w, value});
      G.pending.add(uid);
      G.flyers.push({sp, uid, sx:it.x, sy:it.y, tx:slot.x, ty:slot.y, t:-i*.12, dur:.8});
      kept++; total += value; rows.push({sp, w, value, kept:true, isNew});
    } else rows.push({sp, w, value, kept:false, isNew});
  });
  save();
  G.haul = {title, rows, kept, total}; G.haulT = .9 + list.length*.12;
}
function updateFlyers(dt){
  for(const f of G.flyers){
    f.t += dt; if(f.t < 0) continue;
    const k = Math.min(1, f.t/f.dur);
    f.x = lerp(f.sx, f.tx, ease(k)); f.y = lerp(f.sy, f.ty, k) - Math.sin(Math.PI*k)*28; f.rot = k*Math.PI*2;
    if(k >= 1 && !f.done){ f.done = true; G.pending.delete(f.uid); if(Math.random()<.5) sfx('flop'); }
  }
  G.flyers = G.flyers.filter(f => !f.done);
}
function showHaul(){
  const h = G.haul; G.haul = null; if(!h) return;
  const missed = h.rows.length - h.kept;
  $('haulTitle').textContent = h.title;
  $('haulBody').innerHTML = `<p style="margin:0 0 12px;font-size:13px">${h.kept} of ${h.rows.length} fish went into your hold, worth <b style="color:var(--warn)">${fmt(h.total)} coins</b>.${missed ? ` ${missed} didn't fit and went back in the water.` : ''}</p>
    <div class="list">${h.rows.map(r => `<div class="fishrow"><img src="${r.sp.iconURL}" alt=""><div class="meta"><strong>${esc(r.sp.name)}${r.isNew ? ' <span style="color:var(--warn);font-size:11px">New species</span>' : ''}</strong><span class="r${r.sp.rarity}">${RARITIES[r.sp.rarity]}</span> <span style="color:var(--bone-dim)">${r.w.toFixed(2)} lb</span></div><span class="price">${fmt(r.value)}</span><span style="font-size:12px;color:${r.kept ? 'var(--good)' : 'var(--bone-dim)'};min-width:58px;text-align:right">${r.kept ? 'Kept' : 'No room'}</span></div>`).join('')}</div>`;
  holding = false; $('haulDlg').showModal(); $('haulDone').focus();
  sfx('catch');
}
$('haulDone').onclick = () => $('haulDlg').close();

const netRange = () => 60 + S.net*22; // px past the bow; the rod reaches about twice as far
function castNet(){
  markSeen('net');
  const n = NETS[S.net], g = G.rig, bow = g.left + g.L;
  const cx = clamp(bow + 8 + n.w/2 + G.power*netRange(), bow + 6 + n.w/2, W - n.w/2 - 4);
  G.net = {phase:'fly', t:0, dur:(.4 + G.power*.35)/n.speed**.3, sx:g.tipX, sy:g.tipY, cx, fx:g.tipX, fy:g.tipY, x:Math.round(cx - n.w/2), d:0, max:Math.min(n.depth, LAKE_FT-1.5), hold:0, fish:[], tier:S.net};
  G.state = 'net'; sfx('cast');
}
function updateNet(dt){
  const N = G.net, n = NETS[N.tier];
  if(N.phase==='fly'){
    N.t += dt; const k = Math.min(1, N.t/N.dur);
    N.fx = lerp(N.sx, N.cx, k); N.fy = lerp(N.sy, surfY(N.cx), k) - Math.sin(Math.PI*k)*(8 + G.power*12);
    if(k >= 1){ N.phase = 'down'; splashFX(N.cx, 2); sfx('net'); }
    return;
  }
  if(N.phase==='down'){ N.d += 7*n.speed*dt; if(N.d >= N.max){ N.d = N.max; N.phase = 'hold'; N.hold = .6; } }
  else if(N.phase==='hold'){ N.hold -= dt; if(N.hold <= 0){ N.phase = 'up'; sfx('net'); markSeen('net2'); } }
  else { N.d -= 9*n.speed*dt; const bow = G.rig.left + G.rig.L + 2; N.x += (bow - N.x)*Math.min(1, dt*.35); } // hauling drags it back toward the boat
  // anything swimming into the mesh gets tangled, up to the net's capacity
  const top = SURF + N.d*FT;
  if(N.fish.length < n.cap) for(const f of fishes){
    if(N.fish.length >= n.cap) break;
    if(f.netTried || !['roam','flee','interested'].includes(f.mode)) continue;
    if(f.x < N.x || f.x > N.x + n.w || f.y < top || f.y > top + n.h) continue;
    f.netTried = true;
    if(Math.random() < NET_ESCAPE[f.def.rarity]){ fleeFish(f); toast(`A ${f.def.name} tore through the mesh. Rare fish need a rod.`); continue; }
    f.mode = 'netted'; f.nx = rand(3, n.w-3); f.ny = rand(4, n.h-3); N.fish.push(f); bubbles(f.x, f.y, 4); sfx('thrash');
  }
  if(N.d <= 0){
    const got = N.fish, cx = N.x + n.w/2;
    fishes = fishes.filter(f => !got.includes(f));
    G.net = null; G.state = 'idle'; splashFX(cx, 3); sfx('bigsplash'); doShake(2);
    if(got.length) resolveHaul(got.map(f => ({sp:f.def, x:f.x, y:SURF-2})), `${n.name} haul`);
    else toast('The net came up empty. Try lowering it where fish are swimming.');
  }
}
function throwDyn(){
  markSeen('dyn');
  if(S.dyn.count <= 0){ toast('Out of dynamite. Buy more at the harbor shop.'); return; }
  if(S.inv.length >= boat().cap){ toast('Your hold is full. Sail back to the harbor to sell first.'); return; }
  S.dyn.count--; save();
  const r = G.rig, tx = clamp(T.hover ? T.hover.x : W*.7, r.left + r.L + 10, W - 8);
  G.dyn = {phase:'fly', t:0, dur:.6, fuse:DYN.fuse[S.dyn.fuse].v, sx:r.fx+11, sy:r.top-8, tx, x:r.fx+11, y:r.top-8, d:0, rot:0, tick:0, target:aimDepth()};
  G.state = 'dyn'; sfx('cast');
}
function updateDyn(dt){
  const D = G.dyn;
  if(D.phase !== 'boom'){
    D.fuse -= dt; D.tick -= dt;
    if(D.tick <= 0){ D.tick = .12; sfx('fuse'); }
    const fx = D.x + Math.sin(D.rot)*3, fy = D.y - Math.cos(D.rot)*3;
    parts.push({t:'spark', x:fx, y:fy, vx:rand(-14,14), vy:rand(-22,4), life:rand(.15,.35)});
  }
  if(D.phase==='fly'){
    D.t += dt; const k = Math.min(1, D.t/D.dur);
    D.x = lerp(D.sx, D.tx, k); D.y = lerp(D.sy, surfY(D.tx), k) - Math.sin(Math.PI*k)*28; D.rot = k*Math.PI*3;
    if(k >= 1){ D.phase = 'sink'; D.d = 0; splashFX(D.x, 1); sfx('splash'); }
  } else if(D.phase==='sink'){
    // steer: W/S or arrow keys move the target depth; the stick swims toward it
    const steer = (T.keys.down ? 1 : 0) - (T.keys.up ? 1 : 0);
    if(steer) D.target = clamp(D.target + steer*14*dt, .5, dynMaxDepth());
    const diff = D.target - D.d, step = DYN.sink*dt;
    D.d = clamp(D.d + clamp(diff, -step, step), 0, LAKE_FT - 1); D.y = depthToY(D.d, D.x);
    D.rot = Math.abs(diff) > .3 ? D.rot + dt*1.5*Math.sign(diff) : D.rot*.9;
    if(Math.random() < dt*6) bubbles(D.x, D.y - 3, 1);
  }
  if(D.phase !== 'boom' && D.fuse <= 0) return explode();
  if(D.phase === 'boom'){
    D.t += dt;
    let allUp = true;
    for(const f of D.killed){
      const s = surfY(f.x) + 1;
      if(f.y > s){ f.y = Math.max(s, f.y - f.vy*dt); f.vy = Math.min(40, f.vy + 8*dt); allUp = false; }
      else f.y = s + Math.sin(time*3 + f.ph)*.6;
    }
    if((allUp && D.t > 1.2) || D.t > 8){
      const got = D.killed;
      fishes = fishes.filter(f => !got.includes(f));
      G.dyn = null; G.state = 'idle';
      if(got.length) resolveHaul(got.map(f => ({sp:f.def, x:f.x, y:f.y})), 'Blast haul');
      else toast('The blast missed. Nothing was in range.');
      if(S.dyn.count <= 0 && G.tool==='dyn'){ G.tool = 'rod'; toast('That was your last stick of dynamite.'); }
    }
  }
}
function explode(){
  const D = G.dyn, R = DYN.radius[S.dyn.radius].v;
  D.phase = 'boom'; D.t = 0; D.R = R; markSeen('dyn2');
  G.flashA = .75; doShake(9); sfx('boom'); buzz([80,40,120]);
  parts.push({t:'glow', x:D.x, y:D.y, R, life:.45, max:.45});
  parts.push({t:'shock', x:D.x, y:D.y, R, life:.5, max:.5});
  parts.push({t:'shock', x:D.x, y:D.y, R:R*1.6, life:.8, max:.8});
  for(let i=0;i<30;i++){ const a = rand(0, Math.PI*2), r = rand(0, R); parts.push({t:'bub', x:D.x+Math.cos(a)*r, y:D.y+Math.sin(a)*r, vx:0, vy:rand(-40,-14), life:rand(1,2.5), ph:rand(0,6)}); }
  for(let i=0;i<18;i++){ const a = rand(0, Math.PI*2), v = rand(30,90); parts.push({t:'debris', x:D.x, y:D.y, vx:Math.cos(a)*v, vy:Math.sin(a)*v, life:rand(.4,.9)}); }
  if(D.d < 10) splashFX(D.x, 3);
  D.killed = [];
  if(M && !['dying','leave'].includes(M.state) && Math.hypot(M.x - D.x, M.y - D.y) <= R + 14) damageSaltwight(2, 'The blast caught the Saltwight!');
  for(const f of fishes){
    if(!['roam','flee','interested','bite'].includes(f.mode)) continue;
    const d = Math.hypot(f.x - D.x, f.y - D.y);
    if(d <= R + f.def.sprite.w*.3){ f.mode = 'dead'; f.rot = Math.PI; f.vy = rand(14,24); f.dir = Math.random()<.5 ? 1 : -1; D.killed.push(f); }
    else if(d <= R*2.6){ fleeFish(f); f.dir = f.x > D.x ? 1 : -1; }
  }
}
function drawNet(){
  const N = G.net; if(!N) return;
  const n = NETS[N.tier], g = G.rig, bx = g.left + g.L - 2, by = g.top;
  if(N.phase==='fly'){ // bundled net in the air, trailing its line
    pixelCurve(bx, by, (bx+N.fx)/2, Math.min(by, N.fy) - 4, N.fx, N.fy, 'rgba(217,207,168,.85)');
    const x0 = Math.round(N.fx), y0 = Math.round(N.fy);
    px(x0-4, y0-3, 9, 7, '#0b1a24'); px(x0-3, y0-2, 7, 5, '#a89f80');
    for(let i=-3;i<=3;i+=2) px(x0+i, y0-2, 1, 5, '#d9cfa8');
    px(x0-3, y0-3, 2, 1, '#ff6a3d'); px(x0+2, y0-3, 2, 1, '#ff6a3d');
    return;
  }
  const top = Math.round(SURF + N.d*FT + Math.sin(time*2)*.6), x = Math.round(N.x);
  pixelCurve(bx, by, (bx+x)/2, Math.max(by, top) - 6, x, top, 'rgba(217,207,168,.85)');
  pixelCurve(bx, by, (bx+x+n.w)/2, Math.max(by, top) - 4, x+n.w, top, 'rgba(217,207,168,.85)');
  for(let cx=0; cx<=n.w; cx++){
    const u = cx/n.w, colH = n.h + Math.round(Math.sin(Math.PI*u)*4);
    for(let cy=1; cy<colH; cy++) if(((cx+cy)%4===0) || ((cx-cy+400)%4===0)){ ctx.fillStyle = 'rgba(217,207,168,.55)'; ctx.fillRect(x+cx, top+cy, 1, 1); }
    if(cx%6===2){ px(x+cx, top+colH, 2, 2, '#5a6570'); }
  }
  px(x, top, n.w+1, 1, '#e8dfbd');
  for(let cx=1; cx<n.w; cx+=6) px(x+cx, top-1, 3, 2, '#ff6a3d');
}
function drawDynamite(){
  const D = G.dyn; if(!D || D.phase==='boom') return;
  ctx.save(); ctx.translate(Math.round(D.x), Math.round(D.y)); ctx.rotate(Math.round(D.rot/(Math.PI/4))*(Math.PI/4));
  ctx.fillStyle='#0b1a24'; ctx.fillRect(-2,-4,5,9);
  ctx.fillStyle='#d8452f'; ctx.fillRect(-1,-3,3,7); ctx.fillStyle='#f07a5a'; ctx.fillRect(-1,-3,1,7);
  ctx.fillStyle='#5b2a14'; ctx.fillRect(-1,-2,3,1); ctx.fillRect(-1,2,3,1);
  ctx.fillStyle='#6b6b6b'; ctx.fillRect(0,-5,1,2);
  ctx.fillStyle = Math.floor(time*20)%2 ? '#fff4d2' : '#ffd25e'; ctx.fillRect(0,-6,1,1);
  ctx.restore();
  ctx.save(); ctx.globalCompositeOperation='lighter'; const fx = D.x + Math.sin(D.rot)*3, fy = D.y - Math.cos(D.rot)*3;
  const gl = ctx.createRadialGradient(fx,fy,0,fx,fy,7); gl.addColorStop(0,'rgba(255,200,90,.6)'); gl.addColorStop(1,'rgba(0,0,0,0)'); ctx.fillStyle=gl; ctx.fillRect(fx-7,fy-7,14,14); ctx.restore();
}
function dottedRing(x, y, R, col){ ctx.fillStyle = col; const n = Math.max(24, Math.round(R*1.4)); for(let q=0;q<n;q++){ if(q%3===2) continue; const an = q/n*Math.PI*2; ctx.fillRect(Math.round(x+Math.cos(an)*R), Math.round(y+Math.sin(an)*R), 1, 1); } }
function drawAim(){
  const R = DYN.radius[S.dyn.radius].v;
  const D = G.dyn;
  if(G.state==='dyn' && D && D.phase!=='boom'){
    dottedRing(D.x, D.y, R, 'rgba(255,210,94,.45)');
    const ty = depthToY(D.target, D.x); px(D.x-3, ty, 2, 1, '#ffd25e'); px(D.x+2, ty, 2, 1, '#ffd25e');
    const my = depthToY(dynMaxDepth(), D.x); ctx.fillStyle='rgba(255,106,61,.5)'; for(let i=-10;i<=10;i+=3) ctx.fillRect(Math.round(D.x+i), Math.round(my), 2, 1);
    return;
  }
  if(G.tool!=='dyn' || G.state!=='idle' || !T.hover || S.dyn.count<=0) return;
  const r = G.rig, sx = r.fx+11, sy = r.top-8, tx = clamp(T.hover.x, r.left + r.L + 10, W - 8), ty = surfY(tx);
  ctx.fillStyle = 'rgba(255,210,94,.7)';
  for(let i=1;i<14;i++){ const k = i/14, x = lerp(sx, tx, k), y = lerp(sy, ty, k) - Math.sin(Math.PI*k)*28; if(i%2) ctx.fillRect(Math.round(x), Math.round(y), 1, 1); }
  px(tx-2, ty-4, 5, 1, '#ff6a3d'); px(tx-1, ty-3, 3, 1, '#ff6a3d'); px(tx, ty-2, 1, 1, '#ff6a3d');
  // the mouse picks the depth too, down to what the fuse allows
  const bd = aimDepth(), by = depthToY(bd, tx), my = depthToY(dynMaxDepth(), tx);
  ctx.fillStyle = 'rgba(255,210,94,.35)'; for(let y = Math.round(ty+2); y < by; y += 3) ctx.fillRect(Math.round(tx), y, 1, 1);
  dottedRing(tx, by, R, 'rgba(255,210,94,.8)');
  px(tx, by, 1, 1, '#ffd25e');
  ctx.fillStyle='rgba(255,106,61,.55)'; for(let i=-14;i<=14;i+=3) ctx.fillRect(Math.round(tx+i), Math.round(my), 2, 1);
}

/* ================== Saltwight ==================
   A sea folk ambusher. It only appears while fishing in open water or deeper,
   never while sailing. Art: Ruben's frames, packed into one 64 x 64 sprite sheet. */
const SW_SHEET = new Image(); SW_SHEET.src = "data:image/png;base64,";
const SW_ANIM = {"idle": {"row": 0, "n": 4, "fps": 6, "loop": true}, "swim_r": {"row": 1, "n": 4, "fps": 8, "loop": true}, "swim_ur": {"row": 2, "n": 4, "fps": 8, "loop": true}, "swim_u": {"row": 3, "n": 4, "fps": 8, "loop": true}, "swim_dr": {"row": 4, "n": 4, "fps": 8, "loop": true}, "swim_d": {"row": 5, "n": 4, "fps": 8, "loop": true}, "jump": {"row": 6, "n": 5, "fps": 10, "loop": false}, "attack": {"row": 7, "n": 5, "fps": 12, "loop": false}, "hit": {"row": 8, "n": 3, "fps": 10, "loop": false}, "death": {"row": 9, "n": 10, "fps": 8, "loop": false}};
const SW_CHANCE = [0, .15, .25, .35, .5]; // by zone: shallows, open water, deep water, deep sea, abyss
const SW_SCALE_VALUE = 250;
let M = null, swRollT = 10;
function addSpecialItems(){
  try{ if(!ICONS.scale) return; }catch(e){ return; } // icons aren't built yet during the first registry pass
  const cv = document.createElement('canvas'); cv.width = 9; cv.height = 7; const g = cv.getContext('2d');
  [['#0b1a24',[[2,0,5,1],[1,1,7,1],[0,2,9,3],[1,5,7,1],[3,6,3,1]]],['#3fa58a',[[2,1,5,1],[1,2,7,3],[2,5,5,1]]],['#7ff0e0',[[3,2,2,1],[2,3,1,1]]],['#256b5c',[[5,4,3,1]]]]
    .forEach(([c, rs]) => { g.fillStyle = c; rs.forEach(r => g.fillRect(...r)); });
  byId.sw_scale = {id:'sw_scale', name:'Saltwight Scale', rarity:4, iconURL:ICONS.scale, pile:{frames:[cv], w:9, h:7, seq:[0], facesLeft:false, smooth:false}, dot:[127,240,224], sprite:{frames:[cv], w:9, h:7, seq:[0]}};
}
ICONS.revolver = 'data:image/png;base64,';
ICONS.ammo_revolver = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABgAAAAYCAYAAADgdz34AAAAbklEQVRIS2NkoDFghLNoBEYtIAgwguj/////GxsbGRoaGuBylIihWABTAAMghZSIgehhaAHIUz/3ZoO9adXAwHD28BSwR0kRA/HPHZmKPYjwaSRWbNSC0SDCnTqIFRtNRYM4iGgBUMoiWgCaWwAAAP6QKD6gLhIAAAAQZGVCR0Y3OTJGMjgyMDZFMjJBNTOZcUpSAAAAAElFTkSuQmCC';
ICONS.shotgun = 'data:image/png;base64,';
ICONS.ammo_shotgun = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABkAAAAZCAYAAADE6YVjAAAAeElEQVRIS2NkoANgpIMdw9WSZ5Zu/2HBN+/GFTCdpKEDFSFdrOb9M3B0oMTJqCUgMBpcOIOBWLHR1AUOBmxBg01sNLjAwYAtaLCJDVxw/f/////HB6kMLIf/gl1iN4uL4ezhKQzkip07MhWzFB61hKTgohUYPpYAALCoYCknEG/8AAAAEGRlQkdGMDBDNzRBMDZDQUIyRkM5PjfrPAAAAABJRU5ErkJggg==';
ICONS.sniper = 'data:image/png;base64,';
ICONS.ammo_sniper = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABkAAAAZCAYAAADE6YVjAAAAdklEQVRIS2NkoANgJNUOI5vs/+eOTCVJH0mK/////9/Pz4/h6Xs5BlIsIlohCAwPS0C+aGxsBPvo7NmzJAUZUYpAYHhZAvIRKMhoGlw/9+Yw/FD+CeY7xbKPWoIbjAYXCIymrtF8gh8Mr3wC89XHB6lDOOIpAQCjU/IaXmPjxAAAABBkZUJHODc5MjdDOEUyNjM0OENGQi0josAAAAAASUVORK5CYII=';
ICONS.lightning = 'data:image/png;base64,';
ICONS.ammo_lightning = 'data:image/png;base64,';
ICONS.ammo2_lightning = 'data:image/png;base64,';
// Ruben's shooting frames, pre-rotated around the grip into 8 aim angles (-30 to 75 degrees)
const GUN_ART = {
  // placeholder lightning gun art drawn to match, built the same way
  lightning:{sheet:(() => { const i = new Image(); i.src = 'data:image/png;base64,'; return i; })(), cell:112, frames:3, muzzle:[44.5, -1.5]},
  revolver:{sheet:(() => { const i = new Image(); i.src = 'data:image/png;base64,'; return i; })(), cell:96,  frames:3, muzzle:[23.5, -7.5]},
  shotgun: {sheet:(() => { const i = new Image(); i.src = 'data:image/png;base64,'; return i; })(), cell:112, frames:6, muzzle:[43.5, -3.5]},
  sniper:  {sheet:(() => { const i = new Image(); i.src = 'data:image/png;base64,'; return i; })(), cell:112, frames:3, muzzle:[43.5, -4.0]},
};
const GUN_ANGLES = [-30,-15,0,15,30,45,60,75];
ICONS.scale = makeIcon(P => {
  for(let y=1;y<15;y++){ const half = Math.round(Math.sin(Math.min(1, y/12)*Math.PI*.95)*6); for(let x=8-half; x<=7+half; x++) P(x, y, y<4 ? '#7ff0e0' : x < 8 ? '#52c6a8' : '#2f8f76'); }
  for(const [x,y] of [[6,5],[5,7],[7,8],[9,6],[6,10]]) P(x, y, '#c8fff4', false);
  for(let y=4;y<13;y+=3) for(let x=4;x<12;x++) if((x+y)%4===0) P(x, y, '#256b5c', false);
});
addSpecialItems();

function spawnSaltwight(){
  const hp = 3 + (ZONE >= 3 ? 1 : 0) + (ZONE >= 4 ? 1 : 0);
  M = {x:rand(170, 290), y:Math.min(BED_Y - 12, camY + H + 40), hp, maxHp:hp, state:'rise', st:0, life:45, vx:0, vy:-1,
       anim:'swim_u', ft:0, flip:false, tx:0, ty:0, raidT:rand(5, 9), strikeOpen:false, stole:false};
  M.tx = M.x - 30; M.ty = depthToY(clamp(rand(10, 24), 4, LAKE_FT - 4), M.x);
  toast('Something big is circling below the boat...');
  sfx('growl'); doShake(2);
}
function swSetAnim(a){ if(M.anim !== a){ M.anim = a; M.ft = 0; } }
function swSteer(tx, ty, speed, dt){
  const dx = tx - M.x, dy = ty - M.y, d = Math.hypot(dx, dy) || 1, step = Math.min(d, speed*dt);
  M.vx = dx/d*speed; M.vy = dy/d*speed; M.x += dx/d*step; M.y += dy/d*step;
  return d;
}
function swSwimAnim(){
  const sp = Math.hypot(M.vx, M.vy); if(sp < 4){ swSetAnim('idle'); return; }
  if(Math.abs(M.vx) > 2) M.flip = M.vx < 0;
  const a = Math.atan2(M.vy, Math.abs(M.vx)) * 180/Math.PI; // negative = heading up
  swSetAnim(a < -67 ? 'swim_u' : a < -22 ? 'swim_ur' : a < 22 ? 'swim_r' : a < 67 ? 'swim_dr' : 'swim_d');
}
const swCenter = () => (isWet() ? {x:G.lure.x, y:G.lure.y} : {x:230, y:depthToY(Math.min(16, LAKE_FT-4), 230)});
function swWaypoint(){ const c = swCenter(); M.tx = clamp(c.x + rand(-60, 60), 20, W - 20); M.ty = clamp(c.y + rand(-30, 30), SURF + 14, BED_Y - 12); }
function updateSaltwight(dt){
  if(!M){
    if(ZONE < 1) return;
    swRollT -= dt;
    if(swRollT <= 0){ swRollT = 60; if(Math.random() < SW_CHANCE[ZONE] + (HOT ? .1 : 0)) spawnSaltwight(); }
    return;
  }
  M.ft += dt; M.st += dt;
  const g = G.rig, bowX = g.left + g.L, deckX = bowX - 12, deckY = g.top - 16;
  switch(M.state){
    case 'rise': if(swSteer(M.tx, M.ty, 34, dt) < 6){ M.state = 'prowl'; swWaypoint(); } swSwimAnim(); break;
    case 'prowl':
      if(swSteer(M.tx, M.ty, 24, dt) < 5) swWaypoint();
      swSwimAnim();
      M.raidT -= dt; M.life -= dt;
      if(G.state==='reeling' && G.hooked && Math.random() < dt*.35){ M.state = 'hunt'; toast('The Saltwight is going for your catch! Reel fast!'); sfx('growl'); }
      else if(M.raidT <= 0 && ['idle','sinking','waiting','net','dyn','charging'].includes(G.state)){ M.state = 'approach'; }
      else if(M.life <= 0){ M.state = 'leave'; }
      break;
    case 'hunt':
      if(G.state !== 'reeling' || !G.hooked){ M.state = 'prowl'; swWaypoint(); break; }
      if(swSteer(G.lure.x, G.lure.y, 46, dt) < 10){ M.state = 'bite'; M.st = 0; M.stole = false; swSetAnim('attack'); }
      else swSwimAnim();
      break;
    case 'bite':
      if(!M.stole && M.st > .25){
        M.stole = true;
        if(G.hooked && G.state==='reeling'){
          const f = G.hooked; fishes = fishes.filter(x => x !== f); G.hooked = null; G.state = 'idle';
          for(let i=0;i<10;i++) parts.push({t:'spark', x:G.rig.tipX, y:G.rig.tipY, vx:rand(-40,40), vy:rand(-50,10), life:rand(.3,.6)});
          bubbles(M.x, M.y, 10); sfx('snap'); doShake(6); buzz([40,30,60]);
          toast(`The Saltwight bit through your line and took the ${f.def.name}!`);
        }
      }
      if(M.st > .45){ M.state = 'retreat'; M.raidT = rand(6, 10); M.tx = M.x + 30; M.ty = depthToY(clamp(25, 6, LAKE_FT - 4), M.x); }
      break;
    case 'approach': { // swim up beside the bow, just under the surface
      const d = swSteer(bowX + 22, SURF + 14, 42, dt); swSwimAnim();
      if(d < 6){ M.state = 'breach'; M.st = 0; M.sx = M.x; M.sy = M.y; M.flip = true; swSetAnim('jump'); splashFX(M.x, 3); sfx('bigsplash'); doShake(3); }
      break;
    }
    case 'breach': { // leap at the deck; this is the window to hit it
      const k = Math.min(1, M.st/.55);
      M.x = lerp(M.sx, deckX + 10, k); M.y = lerp(M.sy, deckY, k) - Math.sin(Math.PI*k)*18;
      M.strikeOpen = M.st > .08;
      if(k >= 1){ M.state = 'claw'; M.st = 0; M.stole = false; swSetAnim('attack'); sfx('growl'); }
      break;
    }
    case 'claw':
      M.strikeOpen = M.st < .22;
      if(!M.stole && M.st > .25){ M.stole = true; M.strikeOpen = false; swSteal(); }
      if(M.st > .45){ M.state = 'retreat'; M.raidT = rand(6, 10); M.tx = bowX + 40; M.ty = depthToY(clamp(22, 6, LAKE_FT - 4), bowX + 40); splashFX(bowX + 14, 3); sfx('bigsplash'); }
      break;
    case 'hurt': { // knocked back, falling into the water
      const k = Math.min(1, M.st/.3);
      M.x = lerp(M.sx, M.hx, k); M.y = lerp(M.sy, M.hy, k) - Math.sin(Math.PI*k)*10;
      if(k >= 1){
        if(M.sy < SURF) { splashFX(M.x, 3); sfx('bigsplash'); }
        if(M.hp <= 0){ M.state = 'dying'; M.st = 0; swSetAnim('death'); sfx('growl'); }
        else { M.state = 'retreat'; M.raidT = rand(5, 9); M.tx = M.x + 30; M.ty = depthToY(clamp(24, 6, LAKE_FT - 4), M.x); }
      }
      break;
    }
    case 'retreat': if(swSteer(M.tx, M.ty, 40, dt) < 6){ M.state = 'prowl'; swWaypoint(); } swSwimAnim(); break;
    case 'dying':
      M.y = Math.min(M.y + 6*dt, BED_Y - 10);
      if(Math.random() < dt*8) bubbles(M.x, M.y - 6, 1);
      if(M.st > SW_ANIM.death.n / SW_ANIM.death.fps + .4){ swReward(); M = null; }
      break;
    case 'leave':
      swSteer(M.x + 20, BED_Y + 80, 40, dt); swSwimAnim();
      if(M.y > Math.max(camY + H + 50, SURF + 60) || M.y >= BED_Y - 4){ toast('The Saltwight sank back into the deep.'); M = null; }
      break;
  }
  if(M && M.state!=='breach' && M.state!=='claw') M.strikeOpen = false;
  if(M && !['breach','claw','hurt'].includes(M.state)) M.y = Math.max(M.y, SURF + 12);
}
function strikeSaltwight(){
  markSeen('swwarn');
  if(!M || !M.strikeOpen) return;
  holding = false; M.strikeOpen = false;
  sfx('whack'); buzz(60);
  parts.push({t:'glow', x:M.x, y:M.y - 6, R:10, life:.25, max:.25});
  damageSaltwight(1, M.hp > 1 ? `Got it! ${M.hp - 1} more hit${M.hp - 1 > 1 ? 's' : ''} to drive it off for good.` : null);
}
function damageSaltwight(n, msg){
  M.hp -= n; doShake(5); G.flashA = Math.max(G.flashA, .25);
  M.state = 'hurt'; M.st = 0; M.sx = M.x; M.sy = M.y; M.hx = M.x + 14; M.hy = Math.max(M.y + 8, SURF + 14); M.flip = true;
  swSetAnim('hit');
  if(msg && M.hp > 0) toast(msg);
}
function swSteal(){
  doShake(5); sfx('claw');
  if(!S.inv.length){ toast('The Saltwight clawed at an empty deck.'); return; }
  const it = S.inv.pop(); save();
  toast(`The Saltwight snatched your ${it.name} off the deck!`);
  const sp = byId[it.sid]; if(sp && sp.sprite) G.relAnim = {t:0, dur:.6, sp, sx:M.x, sy:M.y, tx:M.x + 30, x:M.x, y:M.y, rot:0};
}
function swReward(){
  S.coins += 0; // the scale is the reward; sell it at the harbor
  const item = {uid:newUid(), sid:'sw_scale', name:'Saltwight Scale', rarity:4, w:.5, value:SW_SCALE_VALUE};
  if(fits(item.w)){ S.inv.push(item); toast(`The Saltwight is dead. You pulled a Saltwight Scale from the water, worth ${SW_SCALE_VALUE} coins at the harbor.`); }
  else { S.coins += SW_SCALE_VALUE; toast(`The Saltwight is dead. Your hold was full, so its scale went straight to the harbor for ${SW_SCALE_VALUE} coins.`); }
  S.caught.sw_kills = (S.caught.sw_kills || 0) + 1; save(); sfx('catch');
}
function drawSaltwight(){
  if(!M || !SW_SHEET.complete || !SW_SHEET.naturalWidth) return;
  const a = SW_ANIM[M.anim], i = a.loop ? Math.floor(M.ft*a.fps) % a.n : Math.min(a.n - 1, Math.floor(M.ft*a.fps));
  ctx.save(); ctx.translate(Math.round(M.x), Math.round(M.y)); if(M.flip) ctx.scale(-1, 1);
  ctx.drawImage(SW_SHEET, i*64, a.row*64, 64, 64, -32, -36, 64, 64);
  ctx.restore();
}
function drawStrikeMark(){
  const x = Math.round(M.x) - 3, y = Math.round(M.y) - 46 - Math.abs(Math.sin(time*16))*3;
  for(const [ox,oy] of [[-1,0],[1,0],[0,-1],[0,1],[1,1]]) pText('!', x+ox, y+oy, '#1b0b04', 2);
  pText('!', x, y, '#ffd25e', 2);
}
const threatEl = $('threatChip');
let threatKey = '';
function updateThreat(){
  const key = M && M.state!=='dying' ? M.hp + '/' + M.maxHp : ''; if(key === threatKey) return; threatKey = key;
  threatEl.hidden = !key; if(key) $('threatVal').innerHTML = Array.from({length:M.maxHp}, (_, i) => `<i class="${i < M.hp ? 'on' : ''}"></i>`).join('');
}
$('strikeBtn').addEventListener('click', () => { ac(); strikeSaltwight(); });

/* ================== Firearms ==================
   Revolver, shotgun and sniper rifle share one system. Art is drawn on a finer
   overlay canvas at half size, with the grip on the fisherman's hand. */
const fxc = $('fx'), fxx = fxc.getContext('2d');
fxc.width = W*GUN_K; fxc.height = H*GUN_K; fxx.imageSmoothingEnabled = false;
const curGun = () => isGun(G.tool) ? G.tool : null;
const gunReach = id => wTier(id).range * (WEAPONS[id].bolt && WS(id).alt ? DELAY_REACH : 1);
const gunViewMax = () => { const id = curGun(); if(!id) return 0; return Math.max(0, Math.min(CAM_MAX, SURF + (gunReach(id) + 4)*FT - H + 20)); };
function gunHand(){ const r = G.rig; return {x:r.fx + 10.5, y:r.top - 6}; }
function gunAimAngle(){
  if(G.gun.reload) return -30;
  const h = gunHand(); if(!T.hover) return G.gun.aim;
  const tx = T.hover.x, ty = T.hover.y + camY;
  return clamp(Math.atan2(ty - h.y, Math.max(2, tx - h.x)) * 180/Math.PI, -30, 80);
}
function gunMuzzle(id){
  const h = gunHand(), a = G.gun.aim*Math.PI/180, [mx, my] = GUN_ART[id].muzzle;
  return {x:h.x + (mx*Math.cos(a) - my*Math.sin(a))/GUN_K, y:h.y + (mx*Math.sin(a) + my*Math.cos(a))/GUN_K};
}
function fireGun(){
  const id = curGun(); if(!id || WS(id).lvl < 0) return;
  const g = G.gun, w = WEAPONS[id], t = wTier(id), st = WS(id);
  if(g.reload){ sfx('dry'); return; }
  if(g.cd > 0) return;
  if(w.bolt && st.alt){ fireDelayed(); return; }
  if(st.mag <= 0){
    if(st.ammo <= 0){ sfx('dry'); toast(`Out of ${w.ammoName.toLowerCase()}. Buy more at the harbor shop.`); }
    else if(w.auto) startReload();
    else { sfx('dry'); toast('Reload first: press R.'); }
    return;
  }
  g.aim = gunAimAngle();
  const m = gunMuzzle(id);
  let a = g.aim*Math.PI/180;
  if(T.hover){ const tx = T.hover.x, ty = T.hover.y + camY; if(tx > m.x + 2) a = Math.atan2(ty - m.y, tx - m.x); }
  markSeen('gun:'+id);
  if(w.bolt){ st.mag--; g.cd = t.cool; g.shotT = 0; castBolt(m, a, t); if(st.mag === 0 && st.ammo > 0) g.pending = .35; save(); return; }
  st.mag--; g.cd = t.cool; g.shotT = 0; g.shotId = (g.shotId||0) + 1;
  const n = t.pellets || 1, spread = (t.spread || 0)*Math.PI/180;
  for(let i=0;i<n;i++){
    // pellets fan out evenly across the cone, with a little jitter
    const off = n > 1 ? (-spread/2 + spread*(i + Math.random()*.8 + .1)/n) : 0;
    const aa = a + off, sp = w.speed*(n > 1 ? rand(.88, 1.08) : 1);
    G.bullets.push({x:m.x, y:m.y, dx:Math.cos(aa), dy:Math.sin(aa), spd:sp, wet:false, uw:0, spent:false, fade:.6, alive:true,
      dmg:t.dmg, range:t.range, pierce:w.pierce, hit:new Set(), shot:g.shotId, kind:id});
  }
  parts.push({t:'glow', x:m.x, y:m.y, R:id==='revolver' ? 6 : 9, life:.09, max:.09});
  sfx(id==='shotgun' ? 'blast' : id==='sniper' ? 'rifle' : 'shot');
  doShake(id==='revolver' ? 1.5 : id==='shotgun' ? 3.5 : 3); buzz(id==='revolver' ? 15 : 35);
  if(st.mag === 0 && st.ammo > 0 && w.auto) g.pending = .3;   // empty: reload right after the shot
  save();
}
function startReload(){
  const id = curGun(); if(!id) return;
  const g = G.gun, w = WEAPONS[id], st = WS(id);
  if(st.lvl < 0 || g.reload || st.mag >= magOf(id) || (w.bolt && st.alt)) return;
  if(st.ammo <= 0){ toast(`No spare ${w.ammoName.toLowerCase()}. Buy more at the harbor shop.`); return; }
  const spent = magOf(id) - st.mag, n = w.bolt ? spent : Math.min(spent, st.ammo), h = gunHand();
  g.reload = {t:0, dur:wTier(id).reload, n, done:0, id, cells:w.bolt ? 1 : n};
  if(w.bolt){ sfx('hum'); return; }
  if(id !== 'shotgun') for(let i=0;i<spent;i++) parts.push({t:'casing', x:h.x + 3, y:h.y - 2, vx:rand(-20,10), vy:rand(-40,-15), life:2, wet:false});
  sfx('cock');
}
function gunTimers(dt, land){
  const g = G.gun, id = curGun();
  g.cd = Math.max(0, g.cd - dt); g.shotT += dt;
  if(g.pending > 0){ g.pending -= dt; if(g.pending <= 0) startReload(); }
  if(g.reload && g.reload.id !== id) g.reload = null;   // switching weapons cancels a reload
  if(land && g.reload){
    const R = g.reload, st = WS(R.id); R.t += dt;
    const loaded = Math.min(R.n, Math.floor(R.t / R.dur * (R.n + .5)));
    while(R.done < loaded){ R.done++; if(!WEAPONS[R.id].bolt) sfx(R.id==='sniper' ? 'bolt' : 'click'); }
    if(R.t >= R.dur){ st.mag += R.n; st.ammo -= R.cells; g.reload = null; sfx(WEAPONS[R.id].bolt ? 'tick' : 'cock'); save(); }
  }
}
function updateGun(dt){
  const g = G.gun, id = curGun();
  gunTimers(dt, false);
  if(id && G.state==='idle'){
    g.aim += (gunAimAngle() - g.aim)*Math.min(1, dt*18);
    const steer = (T.keys.down ? 1 : 0) - (T.keys.up ? 1 : 0);
    if(steer) g.view = clamp(g.view + steer*140*dt, 0, gunViewMax());
    g.view = Math.min(g.view, gunViewMax());
  }
  if(g.reload){
    const R = g.reload, st = WS(R.id); R.t += dt;
    const loaded = Math.min(R.n, Math.floor(R.t / R.dur * (R.n + .5)));
    while(R.done < loaded){ R.done++; if(!WEAPONS[R.id].bolt) sfx(R.id==='sniper' ? 'bolt' : 'click'); }
    if(R.t >= R.dur){ st.mag += R.n; st.ammo -= R.cells; g.reload = null; sfx(WEAPONS[R.id].bolt ? 'tick' : 'cock'); save(); }
  }
  // bullets: very fast in air, slowing through the water until they're spent at the weapon's range
  G.dmgAcc = G.zapDmg || 0; G.zapDmg = 0;
  updateLightning(dt);
  for(const b of G.bullets){
    if(b.spent){ b.fade -= dt; b.y += 8*dt; if(b.fade <= 0) b.alive = false; continue; }
    const RANGE = b.range*FT;
    let remain = b.spd*dt;
    while(remain > 0 && b.alive && !b.spent){
      const st = Math.min(3, remain); remain -= st;
      const f = b.wet ? Math.max(.05, 1 - Math.pow(b.uw/RANGE, 2)) : 1;
      b.x += b.dx*st*f; b.y += b.dy*st*f;
      if(!b.wet && b.y >= surfY(b.x)){ b.wet = true; parts.push({t:'ripple', x:b.x, r:1, v:10, life:.4, max:.4}); if(Math.random() < .5) parts.push({t:'drop', x:b.x, y:b.y-1, vx:rand(-15,15), vy:rand(-35,-15), life:.4, c:'#e6fbfc'}); }
      if(b.wet){ b.uw += st*f; if(Math.random() < .06) parts.push({t:'bub', x:b.x, y:b.y, vx:0, vy:rand(-14,-6), life:rand(.4,.9), ph:rand(0,6)}); }
      if(b.uw >= RANGE || (b.y - SURF)/FT > b.range){ b.spent = true; break; }
      if(!ABYSS && b.y >= BED_Y - 6){ b.alive = false; for(let i=0;i<3;i++) parts.push({t:'debris', x:b.x, y:b.y, vx:rand(-20,20), vy:rand(-25,-5), life:.4}); break; }
      if(b.x < -10 || b.x > W + 10){ b.alive = false; break; }
      gunHitTest(b);
    }
  }
  G.bullets = G.bullets.filter(b => b.alive);
  if(G.dmgAcc > 0 && M && !['dying','leave'].includes(M.state)){
    const left = Math.max(0, Math.round((M.hp - G.dmgAcc)*10)/10), hits = Math.ceil(left - 1e-6);
    damageSaltwight(G.dmgAcc, left > 0 ? `Shot the Saltwight! ${hits} hit${hits>1?'s':''} left.` : null);
  }
  for(const p of parts) if(p.t==='casing'){
    if(!p.wet){ p.vy += 160*dt; p.x += p.vx*dt; p.y += p.vy*dt; if(p.y >= surfY(p.x)){ p.wet = true; p.vy = 10; p.vx *= .2; sfx('tink'); parts.push({t:'ripple', x:p.x, r:1, v:6, life:.3, max:.3}); } }
    else { p.y += p.vy*dt; p.x += p.vx*dt; p.life -= dt*.6; }
  }
}
function gunHitTest(b){
  // a target can only be hit once per bullet; piercing rounds keep going after a hit
  if(M && !['dying','leave','hurt'].includes(M.state) && !b.hit.has('M') && Math.hypot(b.x - M.x, b.y - (M.y - 4)) < 13){
    b.hit.add('M'); G.dmgAcc += b.dmg;
    parts.push({t:'glow', x:b.x, y:b.y, R:7, life:.12, max:.12});
    for(let i=0;i<4;i++) parts.push({t:'spark', x:b.x, y:b.y, vx:rand(-30,30), vy:rand(-30,10), life:rand(.2,.4)});
    if(!b.pierce){ b.alive = false; return; }
  }
  for(const f of fishes){
    if(!SHOOTABLE.includes(f.mode) || b.hit.has(f)) continue;
    if(Math.hypot(b.x - f.x, b.y - f.y) < Math.max(4, f.def.sprite.w*.38)){
      b.hit.add(f);
      killShot(f); sfx('thunk');
      if(!b.pierce){ b.alive = false; return; }
    }
  }
}
const SHOOTABLE = ['roam','flee','interested','bite'];
function killShot(f){
  if(f.mode==='bite' && G.bite.fish===f){ G.bite.fish = null; G.state = 'waiting'; }
  f.mode = 'shot'; f.rot = Math.PI; f.vy = rand(18,26); f.surfT = 0;
  bubbles(f.x, f.y, 4);
  for(const o of fishes) if(o !== f && o.mode==='roam' && Math.hypot(o.x-f.x, o.y-f.y) < 40) fleeFish(o);
}
function collectShot(f){
  fishes = fishes.filter(x => x !== f);
  const sp = f.def, {w, value} = rollCatch(sp);
  S.caught[sp.id] = (S.caught[sp.id]||0) + 1;
  if(fits(w)){
    const uid = newUid(), slot = pileSlot(S.inv.length, boatGeom());
    S.inv.push({uid, sid:sp.id, name:sp.name, rarity:sp.rarity, w, value}); G.pending.add(uid);
    G.flyers.push({sp, uid, sx:f.x, sy:f.y, tx:slot.x, ty:slot.y, t:0, dur:.8});
    toast(`Shot a ${sp.name} (${w.toFixed(1)} lb, ${fmt(value)} coins). It's in your hold.`);
  } else toast(`No room in the hold for the ${sp.name}. It drifted away.`);
  save();
}
/* ================== Lightning gun ==================
   A bolt follows the aim line to the first fish (or the Saltwight) inside its range, then
   jumps to the nearest unhit target within reach, again and again. Delayed cells fire a glowing
   charge that sinks to the aim point and bursts, killing everything in a small radius and
   chaining out from there. Bolts are re-shaped every few frames so they flicker and warp. */
const DELAY_REACH = 1.8;    // delayed cells reach this many times the gun's normal range
G.bolts = []; G.orbs = []; G.zapDmg = 0; G.zapFlash = 0;
const swTargetable = () => M && !['dying','leave','hurt'].includes(M.state);
function zapTarget(tg, dmg){
  if(tg === 'M'){ G.zapDmg += dmg; return; }
  tg.zapT = .55; killShot(tg);
}
const tgPos = tg => tg === 'M' ? {x:M.x, y:M.y - 4} : {x:tg.x, y:tg.y};
// chain from the hit targets to the nearest unhit ones, branching from earlier hits when the last one has nothing in reach
function chainFrom(starts, t, hitSet, links, jumps, d0){
  let frontier = starts.slice(), d = d0;
  while(jumps > 0 && frontier.length){
    let best = null, bd = 1e9, from = null;
    for(let k = frontier.length-1; k >= 0 && !best; k--){
      const src = frontier[k], p = tgPos(src);
      for(const f of fishes){ if(hitSet.has(f) || !SHOOTABLE.includes(f.mode)) continue; const dd = Math.hypot(f.x-p.x, f.y-p.y); if(dd < t.jump && dd < bd){ bd = dd; best = f; from = src; } }
      if(swTargetable() && !hitSet.has('M')){ const q = tgPos('M'), dd = Math.hypot(q.x-p.x, q.y-p.y); if(dd < t.jump + 8 && dd < bd){ bd = dd; best = 'M'; from = src; } }
      if(!best) frontier.splice(k, 1);
    }
    if(!best) break;
    links.push({a:tgPos(from), b:tgPos(best), d:++d});
    hitSet.add(best); zapTarget(best, t.dmg); frontier.push(best); jumps--;
  }
  return d;
}
function castBolt(m, a, t){
  const dx = Math.cos(a), dy = Math.sin(a), maxY = SURF + t.range*FT;
  let x = m.x, y = m.y, hit = null;
  for(let s = 0; s < 700; s += 2){
    x = m.x + dx*s; y = m.y + dy*s;
    if(x < -4 || x > W+4 || y > maxY || (!ABYSS && y > BED_Y - 4)) break;
    if(swTargetable() && Math.hypot(x - M.x, y - (M.y-4)) < 13){ hit = 'M'; break; }
    const f = fishes.find(f => SHOOTABLE.includes(f.mode) && Math.hypot(x - f.x, y - f.y) < Math.max(5, f.def.sprite.w*.42));
    if(f){ hit = f; break; }
  }
  const links = [{a:{x:m.x, y:m.y}, b:hit ? tgPos(hit) : {x, y}, d:0, main:true}], hitSet = new Set();
  if(hit){ hitSet.add(hit); zapTarget(hit, t.dmg); chainFrom([hit], t, hitSet, links, t.chains, 0); }
  else parts.push({t:'glow', x, y, R:6, life:.2, max:.2});
  G.bolts.push({links, t:0, dur:.42, gen:-1});
  G.zapFlash = .35; doShake(2.5); buzz(40); sfx('zap');
  parts.push({t:'glow', x:m.x, y:m.y, R:10, life:.12, max:.12});
  const kills = [...hitSet].filter(h => h !== 'M').length;
  if(kills > 1) toast(`Chain lightning! ${kills} fish hit.`);
}
function fireDelayed(){
  const id = curGun(), st = WS(id), t = wTier(id), g = G.gun;
  if(st.ammo2 <= 0){ sfx('dry'); toast('Out of delayed power cells. Buy more at the harbor shop, or press T to switch back.'); return; }
  g.aim = gunAimAngle();
  const m = gunMuzzle(id), maxY = SURF + t.range*DELAY_REACH*FT;
  let tx, ty;
  if(T.hover){ tx = T.hover.x; ty = T.hover.y + camY; }
  else { const a = g.aim*Math.PI/180; tx = m.x + Math.cos(a)*200; ty = m.y + Math.sin(a)*200; }
  ty = clamp(ty, SURF + 10, ABYSS ? maxY : Math.min(maxY, BED_Y - 8)); tx = clamp(tx, m.x + 6, W - 6);
  st.ammo2--; g.cd = t.reload; g.shotT = 0; markSeen('gun:lightning:alt');
  G.orbs.push({x:m.x, y:m.y, tx, ty, phase:'fly', t:0, wet:false, tier:t});
  sfx('hum'); doShake(1.5); save();
}
function toggleAmmo(){
  const id = curGun(); if(!id || !WEAPONS[id].bolt || WS(id).lvl < 0) return;
  const st = WS(id); st.alt = !st.alt; G.gun.reload = null; gunChipKey = ''; sfx('tick');
  toast(st.alt ? `Delayed power cells loaded (${st.ammo2} left). Aim where the charge should burst.` : `Power cells loaded (${st.ammo} left).`);
  save();
}
function burstOrb(o){
  const t = o.tier, R = t.burst, hitSet = new Set(), links = [];
  // spokes of lightning out from the burst
  for(let k=0;k<11;k++){ const an = k/11*Math.PI*2 + rand(-.2,.2), L = R*rand(.8,1.35); links.push({a:{x:o.x, y:o.y}, b:{x:o.x + Math.cos(an)*L, y:o.y + Math.sin(an)*L}, d:0, spoke:true}); }
  for(const f of fishes) if(SHOOTABLE.includes(f.mode) && Math.hypot(f.x - o.x, f.y - o.y) < R + f.def.sprite.w*.3){ hitSet.add(f); links.push({a:{x:o.x, y:o.y}, b:tgPos(f), d:0}); zapTarget(f, t.dmg); }
  if(swTargetable() && Math.hypot(M.x - o.x, M.y - 4 - o.y) < R + 12){ hitSet.add('M'); links.push({a:{x:o.x, y:o.y}, b:tgPos('M'), d:0}); zapTarget('M', t.dmg*2); }
  chainFrom([...hitSet], t, hitSet, links, t.chains, 0);
  G.bolts.push({links, t:0, dur:.6, gen:-1, burst:{x:o.x, y:o.y, R}});
  G.zapFlash = .55; doShake(5); buzz(80); sfx('zapboom');
  for(let i=0;i<14;i++){ const an = rand(0, Math.PI*2), r = rand(0, R); parts.push({t:'bub', x:o.x + Math.cos(an)*r, y:o.y + Math.sin(an)*r, vx:0, vy:rand(-30,-10), life:rand(.8,1.8), ph:rand(0,6)}); }
  const kills = [...hitSet].filter(h => h !== 'M').length;
  toast(kills ? `Lightning burst! ${kills} fish hit.` : 'The burst lit up empty water.');
}
function updateLightning(dt){
  for(const b of G.bolts) b.t += dt;
  G.bolts = G.bolts.filter(b => b.t < b.dur);
  G.zapFlash = Math.max(0, G.zapFlash - dt*2.5);
  for(const f of fishes) if(f.zapT > 0) f.zapT -= dt;
  for(const o of G.orbs){
    o.t += dt;
    if(o.phase === 'fly'){
      const dx = o.tx - o.x, dy = o.ty - o.y, d = Math.hypot(dx, dy), spd = (o.wet ? 150 : 320)*dt;
      if(d <= spd){ o.x = o.tx; o.y = o.ty; o.phase = 'arm'; o.t = 0; sfx('hum'); }
      else { o.x += dx/d*spd; o.y += dy/d*spd; }
      if(!o.wet && o.y >= surfY(o.x)){ o.wet = true; parts.push({t:'ripple', x:o.x, r:1, v:12, life:.4, max:.4}); sfx('splash'); }
      if(o.wet && Math.random() < .5) parts.push({t:'bub', x:o.x + rand(-1,1), y:o.y, vx:0, vy:rand(-16,-6), life:rand(.4,.9), ph:rand(0,6)});
    } else if(o.phase === 'arm' && o.t > .55){ burstOrb(o); o.done = true; }
  }
  G.orbs = G.orbs.filter(o => !o.done);
}
// midpoint displacement: a jagged path between two points, with a few short forks
function boltPath(a, b, disp, depth){
  let pts = [a, b];
  for(let lv=0; lv<depth; lv++){
    const out = [pts[0]];
    for(let i=0;i<pts.length-1;i++){ const p = pts[i], q = pts[i+1], dx = q.x-p.x, dy = q.y-p.y, L = Math.hypot(dx,dy) || 1, o = (Math.random()*2-1)*disp;
      out.push({x:(p.x+q.x)/2 - dy/L*o, y:(p.y+q.y)/2 + dx/L*o}, q); }
    pts = out; disp *= .55;
  }
  return pts;
}
function shapeBolt(b){
  b.paths = [];
  for(const l of b.links){
    const L = Math.hypot(l.b.x-l.a.x, l.b.y-l.a.y), main = boltPath(l.a, l.b, Math.min(14, L*.22), L > 40 ? 5 : 4);
    b.paths.push({pts:main, w:l.spoke ? .7 : 1, d:l.d});
    // forks: short side branches off the main path
    const forks = l.spoke ? 0 : Math.min(3, Math.floor(L/22));
    for(let k=0;k<forks;k++){ const i = 2 + Math.floor(Math.random()*(main.length-4)), p = main[i], q = main[Math.min(main.length-1, i+2)], ang = Math.atan2(q.y-p.y, q.x-p.x) + (Math.random()<.5?-1:1)*rand(.5,1.1), fl = rand(6, 16);
      b.paths.push({pts:boltPath(p, {x:p.x + Math.cos(ang)*fl, y:p.y + Math.sin(ang)*fl}, 3, 3), w:.5, d:l.d}); }
  }
}
function strokePath(pts){ ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y); for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i].x, pts[i].y); ctx.stroke(); }
// drawn after the day tint with additive blending, so bolts light up the water at any time of day
function drawLightning(){
  ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
  for(const o of G.orbs){
    const p = o.phase==='arm' ? (Math.floor(o.t*14)%2 ? 1 : .5) : .8, r = o.phase==='arm' ? 5 + o.t*10 : 4;
    const g = ctx.createRadialGradient(o.x,o.y,0,o.x,o.y,r*3); g.addColorStop(0,`rgba(170,225,255,${.6*p})`); g.addColorStop(1,'rgba(60,140,255,0)'); ctx.fillStyle = g; ctx.fillRect(o.x-r*3, o.y-r*3, r*6, r*6);
    ctx.fillStyle = o.phase==='arm' ? '#ffb04a' : '#dff4ff'; ctx.fillRect(Math.round(o.x)-1, Math.round(o.y)-1, 3, 3); ctx.fillStyle = '#ffffff'; ctx.fillRect(Math.round(o.x), Math.round(o.y), 1, 1);
    if(o.phase==='arm') for(let k=0;k<3;k++){ const an = Math.random()*Math.PI*2, L = rand(4, 9); ctx.strokeStyle = 'rgba(150,210,255,.8)'; ctx.lineWidth = .8; strokePath(boltPath({x:o.x, y:o.y}, {x:o.x + Math.cos(an)*L, y:o.y + Math.sin(an)*L}, 2, 2)); }
  }
  for(const b of G.bolts){
    const gen = Math.floor(b.t / .045); if(gen !== b.gen){ b.gen = gen; shapeBolt(b); }   // re-shape: the bolt warps and flickers
    const life = 1 - Math.pow(b.t/b.dur, 2), flick = .65 + .35*Math.random();
    if(b.burst){ const {x, y, R} = b.burst, g = ctx.createRadialGradient(x,y,0,x,y,R*2.4); g.addColorStop(0,`rgba(190,230,255,${.55*life})`); g.addColorStop(1,'rgba(40,110,255,0)'); ctx.fillStyle = g; ctx.fillRect(x-R*2.4, y-R*2.4, R*4.8, R*4.8); }
    for(const p of b.paths){
      const show = clamp((b.t - p.d*.035)/.03, 0, 1); if(show <= 0) continue;   // each jump lands a moment after the last
      const a = life*flick*show, mid = p.pts[p.pts.length >> 1];
      if(p.w >= 1){ const g = ctx.createRadialGradient(mid.x,mid.y,0,mid.x,mid.y,42); g.addColorStop(0,`rgba(80,150,255,${.16*a})`); g.addColorStop(1,'rgba(80,150,255,0)'); ctx.fillStyle = g; ctx.fillRect(mid.x-42, mid.y-42, 84, 84); }
      ctx.strokeStyle = `rgba(50,120,255,${.22*a})`; ctx.lineWidth = 5*p.w; strokePath(p.pts);
      ctx.strokeStyle = `rgba(90,180,255,${.55*a})`; ctx.lineWidth = 2.2*p.w; strokePath(p.pts);
      ctx.strokeStyle = `rgba(230,248,255,${.95*a})`; ctx.lineWidth = Math.max(.7, 1*p.w); strokePath(p.pts);
      const e = p.pts[p.pts.length-1]; if(p.w >= 1){ ctx.fillStyle = `rgba(200,235,255,${.8*a})`; ctx.fillRect(Math.round(e.x)-1, Math.round(e.y)-1, 3, 3); }
    }
  }
  // fish still crackling after a hit
  for(const f of fishes) if(f.zapT > 0 && onScreen(f.y)){
    const a = clamp(f.zapT/.55, 0, 1), w = f.def.sprite.w*.5;
    const g = ctx.createRadialGradient(f.x,f.y,0,f.x,f.y,w+6); g.addColorStop(0,`rgba(150,210,255,${.5*a})`); g.addColorStop(1,'rgba(60,140,255,0)'); ctx.fillStyle = g; ctx.fillRect(f.x-w-6, f.y-w-6, (w+6)*2, (w+6)*2);
    if(Math.random() < .7){ const an = Math.random()*Math.PI*2; ctx.strokeStyle = `rgba(210,240,255,${a})`; ctx.lineWidth = .8; strokePath(boltPath({x:f.x + Math.cos(an)*w*.4, y:f.y + Math.sin(an)*w*.3}, {x:f.x + Math.cos(an)*(w+4), y:f.y + Math.sin(an)*(w*.6+3)}, 2, 2)); }
  }
  ctx.restore();
}
function drawBullets(){
  for(const b of G.bullets){
    const a = b.spent ? Math.max(0, b.fade/.6)*.6 : 1;
    ctx.fillStyle = b.wet ? `rgba(220,245,255,${a})` : `rgba(255,244,210,${a})`;
    const n = b.spent ? 1 : b.kind==='sniper' ? 12 : b.kind==='shotgun' ? 4 : 7;
    for(let i=0;i<n;i++) ctx.fillRect(Math.round(b.x - b.dx*i*1.2), Math.round(b.y - b.dy*i*1.2), 1, 1);
    if(!b.spent){ ctx.fillStyle = '#ffffff'; ctx.fillRect(Math.round(b.x), Math.round(b.y), 1, 1); }
  }
  for(const p of parts) if(p.t==='casing'){ px(p.x, p.y, 1, 2, p.wet ? 'rgba(201,154,46,.6)' : '#e8b84a'); }
}
function drawCrosshair(){
  const id = curGun(); if(G.mode!=='fish' || !id || G.state!=='idle' || WS(id).lvl<0) return;
  const reach = Math.round(gunReach(id)), ry = Math.round(SURF + reach*FT), blue = WEAPONS[id].bolt;
  if(onScreen(ry, 2) && reach < LAKE_FT){ ctx.fillStyle = blue ? 'rgba(110,190,255,.5)' : 'rgba(255,90,90,.45)'; for(let x=14;x<W;x+=6) ctx.fillRect(x, ry, 3, 1); pText(String(reach), W-4-String(reach).length*4, ry-7, blue ? 'rgba(150,210,255,.8)' : 'rgba(255,140,140,.75)'); }
  if(!T.hover || IS_TOUCH) return;
  const x = Math.round(T.hover.x), y = Math.round(T.hover.y + camY), c = G.gun.reload ? 'rgba(255,210,94,.5)' : '#ffd25e';
  const gap = id==='shotgun' ? 5 : 3;
  if(WEAPONS[id].bolt && WS(id).alt){ const c2 = G.gun.cd > 0 ? 'rgba(255,176,74,.5)' : '#ffb04a'; for(let k=0;k<8;k++){ const an = k/8*Math.PI*2 + time; px(x + Math.cos(an)*6, y + Math.sin(an)*6, 1, 1, c2); } }
  px(x-gap-3, y, 3, 1, c); px(x+gap, y, 3, 1, c); px(x, y-gap-3, 1, 3, c); px(x, y+gap, 1, 3, c); px(x, y, 1, 1, '#ffffff');
}
function drawGunHud(){
  // loaded rounds over the fisherman's head, plus a reload bar
  const id = curGun(); if(!id || WS(id).lvl<0) return;
  const w = WEAPONS[id], st = WS(id), r = G.rig, R = G.gun.reload, step = 4, mag = magOf(id), x0 = r.fx + 3 - Math.round(mag*step/2), y0 = r.top - 25;
  if(w.bolt && st.alt){ const n = Math.min(8, st.ammo2), cd = G.gun.cd; for(let i=0;i<Math.max(1,n);i++){ px(x0 + i*step - 1, y0 - 1, 3, 5, '#0b1a24'); px(x0 + i*step, y0, 1, 3, i < n ? '#ffb04a' : '#3b4656'); } if(cd > 0){ const bw = 15, k = 1 - cd/wTier(id).reload; px(x0-1, y0+5, bw+2, 4, '#0b1a24'); px(x0, y0+6, Math.round(bw*clamp(k,0,1)), 2, '#7fd0ff'); } return; }
  const shown = R ? st.mag + Math.min(R.n, R.done) : st.mag;
  const on = id==='shotgun' ? '#e63946' : w.bolt ? '#7fd0ff' : '#ffd25e';
  for(let i=0;i<mag;i++){ px(x0 + i*step - 1, y0 - 1, 3, 5, '#0b1a24'); px(x0 + i*step, y0, 1, 3, i < shown ? on : '#3b4656'); if(i < shown) px(x0 + i*step, y0, 1, 1, '#fff4d2'); }
  if(R){ const bw = Math.max(15, mag*step - 1), k = Math.min(1, R.t/R.dur); px(x0-1, y0+5, bw+2, 4, '#0b1a24'); px(x0, y0+6, bw, 2, '#24364d'); px(x0, y0+6, Math.round(bw*k), 2, '#7bd389'); }
}
function drawGunOverlay(fade){
  fxx.setTransform(1,0,0,1,0,0); fxx.clearRect(0, 0, fxc.width, fxc.height);
  const id = curGun();
  if(G.mode==='land'){ if(!G.trans || G.trans.switched) drawLandGun(fade); return; }
  if(G.mode!=='fish' || !id || WS(id).lvl<0 || !G.rig.top) return;
  const art = GUN_ART[id]; if(!art.sheet.complete || !art.sheet.naturalWidth) return;
  if(G.state!=='idle' && G.state!=='charging') return;
  const g = G.gun, h = gunHand(), C = art.cell;
  const row = g.shotT*18 < art.frames ? Math.floor(g.shotT*18) : art.frames - 1;   // shot frames at 18 fps, then hold the last
  let col = 0, best = 1e9; GUN_ANGLES.forEach((a, i) => { const d = Math.abs(a - g.aim); if(d < best){ best = d; col = i; } });
  const sx = Math.round((h.x + (G.shakeX||0))*GUN_K), sy = Math.round((h.y - Math.round(camY) + (G.shakeY||0))*GUN_K);
  fxx.globalAlpha = 1 - fade;
  const drawIt = () => fxx.drawImage(art.sheet, col*C, (id==='shotgun' || id==='sniper' ? Math.min(row, art.frames-1) : row)*C, C, C, sx - C/2, sy - C/2, C, C);
  drawIt();
  fxx.globalAlpha = 1;
  // Same time-of-day tint as the scene: multiply the gun's square, then trim back to the gun's own pixels
  const lc = lightNow();
  if(lc[0] < 253 || lc[1] < 253 || lc[2] < 253){
    fxx.globalCompositeOperation = 'multiply'; fxx.fillStyle = `rgb(${lc})`; fxx.fillRect(sx - C/2, sy - C/2, C, C);
    fxx.globalCompositeOperation = 'destination-in'; fxx.globalAlpha = 1 - fade; drawIt();
    fxx.globalCompositeOperation = 'source-over'; fxx.globalAlpha = 1;
  }
}
const gunChip = $('gunChip');
let gunChipKey = '';
function updateGunChip(){
  const id = curGun(), on = G.mode==='fish' && !!id && WS(id).lvl>=0, R = G.gun.reload;
  const st = id ? WS(id) : null, w = id ? WEAPONS[id] : null;
  const shown = st ? (R ? st.mag + Math.min(R.n, R.done) : st.mag) : 0;
  const alt = !!(w && w.bolt && st.alt);
  const key = [on, id, shown, st && st.ammo, st && st.ammo2, alt, st && st.lvl, !!R, R ? Math.floor(R.t/R.dur*20) : 0].join('|'); if(key===gunChipKey) return; gunChipKey = key;
  gunChip.hidden = !on; if(!on) return;
  $('ammoIcon').src = ICONS[(alt ? 'ammo2_' : 'ammo_') + id];
  $('cylPips').innerHTML = alt ? '' : Array.from({length:magOf(id)}, (_, i) => `<i class="${i < shown ? 'on' : ''}"></i>`).join('');
  $('ammoVal').textContent = alt ? `${st.ammo2} delayed` : w.bolt ? `${st.ammo} cells` : `${st.ammo} spare`;
  gunChip.title = w.bolt ? 'Tap or press T to switch power cells' : w.ammoName;
  gunChip.classList.toggle('swap', !!w.bolt);
  gunChip.classList.toggle('reloading', !!R);
  $('rbarFill').style.width = R ? Math.min(100, R.t/R.dur*100) + '%' : '0';
}
function weaponStats(id, t){
  return id==='shotgun' ? `<li>Pellets <span>${t.pellets}</span>, cone <span>${t.spread}°</span></li><li>Reload <span>${t.reload} s</span></li><li>Range <span>${t.range} ft</span></li>`
    : id==='sniper' ? `<li>Reaches <span>${t.range} ft</span>, pierces</li><li>Damage <span>${t.dmg}</span> per hit</li><li>Reload <span>${t.reload} s</span> by hand</li>`
    : id==='lightning' ? `<li>Jumps <span>${t.chains}</span> fish, range <span>${t.range} ft</span></li><li>Bolts per cell <span>${t.shots}</span></li><li>Delayed burst to <span>${Math.round(t.range*DELAY_REACH)} ft</span></li>`
    : `<li>Damage <span>${t.dmg}</span> per shot</li><li>Reload <span>${t.reload} s</span></li><li>Range <span>${t.range} ft</span></li>`;
}
function weaponCards(cards){
  for(const id of WEAPON_IDS){
    const w = WEAPONS[id], st = WS(id), cur = st.lvl, nx = w.tiers[cur+1], t = w.tiers[Math.max(0,cur)];
    const nextTxt = !nx ? '' : id==='shotgun' ? `${nx.pellets} pellets, ${nx.spread}° cone, ${nx.reload} s reload` : id==='sniper' ? `reaches ${nx.range} ft, ${nx.reload} s reload`
      : id==='lightning' ? `${nx.chains} jumps, ${nx.shots} bolt${nx.shots>1?'s':''} per cell, ${nx.range} ft` : `damage ${nx.dmg}, ${nx.reload} s reload`;
    cards.push(`<div class="card ${cur>=0?'eq':''}"><div class="row" style="margin:0"><img class="cardicon wide" src="${ICONS[id]}" alt="">${pips(cur+1, w.tiers.length)}</div>
      <h3>${cur>=0 ? esc(t.name) : w.label}</h3><p>${cur>=0 ? esc(t.desc) : esc(w.blurb)}</p>
      ${cur>=0 ? `<ul class="stats">${weaponStats(id, t)}</ul>` : ''}
      ${nx ? `<p style="color:var(--bone)">${cur>=0 ? 'Upgrade to' : 'Buy the'} ${esc(nx.name)}: ${nextTxt}.${cur<0 ? ' Comes loaded.' : ''}</p>
        <div class="row"><span class="price">${fmt(nx.price)} coins</span><button class="btn sm" data-tk="w:${id}" ${S.coins<nx.price?'disabled':''}>${cur>=0?'Upgrade':'Buy'}</button></div>`
      : `<div class="row"><span style="color:var(--bone-dim);font-size:12px">Fully upgraded</span></div>`}</div>`);
  }
}
function ammoCard(id, alt){
  const w = WEAPONS[id], st = WS(id), owned = st.lvl >= 0;
  const name = alt ? w.ammo2Name : w.ammoName, price = alt ? w.ammo2Price : w.ammoPrice, max = alt ? w.ammo2Max : w.ammoMax, have = alt ? st.ammo2 : st.ammo, [p1, p2] = alt ? w.packs2 : w.packs;
  const room = max - have, n1 = Math.max(1, Math.min(p1, room)), n2 = Math.max(1, Math.min(p2, room)), k = alt ? 'b' : 'a';
  const about = w.bolt ? (alt ? 'Fires a charge deep into the water that bursts into lightning, killing fish nearby and jumping to others.' : `Powers the lightning gun. ${owned ? `Each cell fires ${magOf(id)} bolt${magOf(id)>1?'s':''} at your gun's level.` : 'Better guns get more bolts from each cell.'}`)
    : `For the ${w.label.toLowerCase()}. ${w.mag > 1 ? `Holds ${w.mag} loaded.` : 'One round loaded at a time.'}`;
  const loaded = !alt && owned ? `<li>Loaded <span>${st.mag} of ${magOf(id)}</span></li>` : '';
  return `<div class="card ${owned?'':'locked'}"><div class="row" style="margin:0"><img class="cardicon" src="${ICONS[(alt?'ammo2_':'ammo_')+id]}" alt=""><span class="price">${price} coins each</span></div>
    <h3>${name}</h3><p>${about}</p>
    <ul class="stats"><li>Spare <span>${have} of ${max}</span></li>${loaded}</ul>
    ${owned ? `<div class="row"><button class="btn sm" data-tk="${k}1:${id}" ${room<=0||S.coins<n1*price?'disabled':''}>Buy ${n1} for ${fmt(n1*price)}</button><button class="btn ghost sm" data-tk="${k}2:${id}" ${room<=0||S.coins<n2*price?'disabled':''}>Buy ${n2}</button></div>`
      : `<p style="color:var(--bone-dim)">Buy the ${w.label.toLowerCase()} in the Weapons tab first.</p>`}</div>`;
}
function ammoShop(){
  const cards = [];
  for(const id of WEAPON_IDS){ cards.push(ammoCard(id, false)); if(WEAPONS[id].ammo2Name) cards.push(ammoCard(id, true)); }
  return `<div class="grid">${cards.join('')}</div>`;
}
function weaponShop(){ const cards = []; weaponCards(cards); return `<div class="grid">${cards.join('')}</div>`; }
function equipmentRow(){
  const bits = [];
  for(const id of WEAPON_IDS){ const st = WS(id); if(st.lvl < 0) continue;
    bits.push(`<span class="eqi"><img class="wide" src="${ICONS[id]}" alt="">${esc(wTier(id).name)}</span><span class="eqi"><img src="${ICONS['ammo_'+id]}" alt="">${WEAPONS[id].bolt ? `${st.ammo} cells` : `${st.mag} loaded, ${st.ammo} spare`}</span>${WEAPONS[id].bolt ? `<span class="eqi"><img src="${ICONS['ammo2_'+id]}" alt="">${st.ammo2} delayed</span>` : ''}`); }
  if(S.net>=0) bits.push(`<span class="eqi"><img src="${ICONS.net}" alt="">${esc(NETS[S.net].name)}</span>`);
  if(S.light>=0) bits.push(`<span class="eqi"><img src="${ICONS.light}" alt="">${esc(LIGHTS[S.light].name)}</span>`);
  if(S.dyn.count>0) bits.push(`<span class="eqi"><img src="${ICONS.dyn}" alt="">${S.dyn.count} dynamite</span>`);
  return bits.length ? `<div class="equip">${bits.join('')}</div>` : '';
}

/* ================== Tool wheel ==================
   One button opens a wheel with every tool, so the bottom of the screen stays clear. */
const TOOL_ORDER = ['rod','net','dyn','revolver','shotgun','sniper','lightning'];
const wheelTools = () => TOOL_ORDER.filter(t => toolReady(t) && (G.mode!=='land' || isGun(t)));   // only what you own (and have sticks for)
function toolInfo(t){
  if(t==='rod') return {name:rod().name, info:'Cast and reel', badge:''};
  if(t==='net') return S.net>=0 ? {name:NETS[S.net].name, info:`Holds ${NETS[S.net].cap} fish`, badge:''} : {name:'Net', info:'Buy at the harbor', badge:''};
  if(t==='dyn') return S.dyn.count>0 ? {name:'Dynamite', info:`${S.dyn.count} left`, badge:S.dyn.count} : {name:'Dynamite', info:'Buy at the harbor', badge:''};
  const st = WS(t); if(WEAPONS[t].bolt && st.lvl>=0) return {name:wTier(t).name, info:`${st.ammo} power cells, ${st.ammo2} delayed`, badge:st.ammo + st.ammo2 + (st.mag ? 1 : 0)};
  return st.lvl>=0 ? {name:wTier(t).name, info:`${st.mag} loaded, ${st.ammo} spare`, badge:st.mag + st.ammo} : {name:WEAPONS[t].label, info:'Buy at the harbor', badge:''};
}
function renderWheel(){
  const wheel = $('wheel'); wheel.querySelectorAll('.wslot').forEach(n => n.remove());
  const list = wheelTools();
  list.forEach((t, i) => {
    const ang = -90 + i*360/list.length, ready = true, ti = toolInfo(t), b = document.createElement('button');
    b.className = 'wslot' + (G.tool===t ? ' cur' : ''); b.disabled = !ready; b.dataset.tool = t;
    b.style.setProperty('--a', ang + 'deg');
    b.innerHTML = `<img class="${isGun(t) ? 'wide' : ''}" src="${ICONS[t]}" alt=""><span>${esc(isGun(t) ? WEAPONS[t].label : t==='dyn' ? 'Dynamite' : t==='net' ? 'Net' : 'Rod')}</span>${ti.badge!=='' ? `<em>${ti.badge}</em>` : ''}<kbd>${i+1}</kbd>`;
    b.setAttribute('aria-label', `${ti.name}: ${ti.info}`);
    const show = () => { $('wheelName').textContent = ti.name; $('wheelInfo').textContent = ti.info; };
    b.addEventListener('pointerenter', show); b.addEventListener('focus', show);
    b.onclick = () => { $('wheelDlg').close(); selectTool(t); };
    wheel.appendChild(b);
  });
  const ti = toolInfo(G.tool); $('wheelName').textContent = ti.name; $('wheelInfo').textContent = ti.info;
}
$('toolBtn').onclick = () => { if(G.mode==='fish' || G.mode==='land') openDlg('wheelDlg'); };

/* ================== Fishing update ================== */
function updateRig(dt){
  const g = boatGeom(), hx = g.fx+11, hy = g.top-6;
  let target = -.95 + Math.sin(time*1.5)*.03;
  if(G.state==='charging') target = -.95 - G.power*1.05;
  else if(G.state==='casting') target = G.cast.t/G.cast.dur < .35 ? -.25 : -.6;
  else if(G.state==='sinking'||G.state==='waiting') target = -.62;
  else if(G.state==='bite') target = -.55 + Math.sin(time*40)*.06;
  else if(G.state==='reeling') target = -.75 + Math.sin(time*30)*.02*G.reel.tension/50;
  else if(G.state==='landing') target = -1.25;
  G.rodA += (target - G.rodA)*Math.min(1, dt*14);
  const L = rod().len;
  G.rig = Object.assign(g, {hx, hy, tipX: hx + Math.cos(G.rodA)*L, tipY: hy + Math.sin(G.rodA)*L});
}
const catchX = () => G.rig.tipX + 4;

function updateFishing(dt){
  updateRig(dt);
  for(const c of clouds){ c.x += c.v*dt; if(c.x > W+10) c.x = -c.img.width-10; }
  for(const p of plankton){ p.x += p.v*dt*.5; p.y += Math.sin(time+p.ph)*.05 + (p.fall||0)*dt; if(p.x>W) p.x=0; if(p.y>BED_Y) p.y=SURF+6; else if(p.y<SURF+6) p.y=BED_Y-2; }
  updateParts(dt);
  updateRelease(dt);
  updateFlyers(dt);
  G.flashA = Math.max(0, G.flashA - dt*2.2);
  if(G.haul){ G.haulT -= dt; if(G.haulT <= 0 && !anyDialog()) showHaul(); }
  const D = G.dyn;
  const focus = isWet() ? G.lure.y
    : (G.state==='net' && G.net) ? SURF + G.net.d*FT + 10
    : (G.state==='dyn' && D && D.phase!=='fly' && !(D.phase==='boom' && D.t > 1.1)) ? D.y
    : G.orbs.length ? G.orbs[0].y : (G.bolts.find(b => b.burst) || {}).burst?.y ?? null;
  const camTarget = focus!=null ? clamp(focus - H*.48, 0, CAM_MAX) : (isGun(G.tool) && G.state==='idle') ? G.gun.view : 0;
  camY += (camTarget - camY)*Math.min(1, dt*3.2);
  if(!Number.isFinite(camY)) camY = 0;
  if(anyDialog() || (G.trans && G.trans.to==='travel')) return;

  const L = G.lure, r = G.rig;
  switch(G.state){
    case 'idle': case 'charging': case 'landed':
      L.x = r.tipX + Math.sin(time*2)*1; L.y = r.tipY + 8; L.depth = 0;
      if(G.state!=='landed') L.maxDepth = 0;
      if(G.state==='charging'){ G.power += G.pdir*dt*1.1*rod().cast; if(G.power>=1){G.power=1;G.pdir=-1;} if(G.power<=0){G.power=0;G.pdir=1;} }
      break;
    case 'casting': {
      const c=G.cast; c.t += dt; const t = Math.min(1, c.t/c.dur);
      L.x = lerp(c.sx, c.ex, t); L.y = lerp(c.sy, surfY(c.ex), t) - Math.sin(Math.PI*t)*c.arc;
      if(t>=1){ G.state='sinking'; L.depth=0; splashFX(L.x, 1); sfx('splash'); }
      break;
    }
    case 'sinking':
      L.depth = Math.min(lureCap(), L.depth + bait().sink*dt);
      if(L.depth >= lureCap()){ G.state='waiting'; markSeen('sink'); }
      break;
    case 'waiting':
      if(holding && holdFromWaiting){
        const vx = L.x - catchX(), vy = L.depth*FT, len = Math.hypot(vx,vy)||1, sp = 34*rod().reel*dt;
        L.x -= vx/len*sp; L.depth = Math.max(0, (vy - vy/len*sp)/FT);
        if(len < 8) startRetrieve();
      }
      break;
    case 'bite':
      G.bite.t -= dt;
      L.x += Math.sin(time*50)*.3;
      if(G.bite.t<=0){ const f=G.bite.fish; G.bite.fish=null; if(f) fleeFish(f); G.state='waiting'; sfx('miss'); if(!S.seen.bite) toast('Missed the bite. Hook faster when you see the !'); }
      break;
    case 'reeling': updateReel(dt); break;
    case 'net': updateNet(dt); break;
    case 'dyn': updateDyn(dt); break;
    case 'retrieve': {
      G.ret.t += dt; const t=Math.min(1,G.ret.t/.35);
      L.x = lerp(G.ret.sx, r.tipX, t); L.y = lerp(G.ret.sy, r.tipY+8, t) - Math.sin(Math.PI*t)*14;
      if(t>=1) G.state='idle';
      break;
    }
    case 'landing': {
      const a = G.landAnim; a.t += dt; const t = Math.min(1, a.t/a.dur);
      a.x = lerp(a.sx, a.tx, ease(t)); a.y = lerp(a.sy, a.ty, t) - Math.sin(Math.PI*t)*30; a.rot = t*Math.PI*2*a.spin;
      L.x = a.x; L.y = a.y;
      if(t>=1){ G.state='landed'; sfx('flop'); sfx('catch'); doShake(2); for(let i=0;i<6;i++) parts.push({t:'drop', x:a.tx+rand(-3,3), y:a.ty, vx:rand(-20,20), vy:rand(-40,-15), life:.5, c:'#cfeff3'}); openCatch(); }
      break;
    }
  }
  if(isWet()){
    const f = G.hooked;
    L.y = (f && f.jump) ? f.jumpY : depthToY(L.depth, L.x);
    L.maxDepth = Math.max(L.maxDepth, L.depth);
  }
  updateFish(dt);
  updateSaltwight(dt);
  updateGun(dt);
}

function updateReel(dt){
  const R = G.reel, f = G.hooked, sp = f.def, rd = rod(), L = G.lure;
  const input = Math.max(holding ? 1 : 0, R.wheel);
  R.wheel = Math.max(0, R.wheel - dt*2.2);
  R.rate += (input - R.rate)*Math.min(1, dt*10);
  const Px = catchX();
  if(f.jump){
    const j = f.jump; j.t += dt; const t = Math.min(1, j.t/j.dur);
    L.x = clamp(j.x0 + j.vx*t, Px, W-6); L.depth = 0;
    f.jumpY = surfY(L.x) - Math.sin(Math.PI*t)*j.h;
    f.rot = t*Math.PI*2;
    R.tension += (R.rate*25 - R.tension)*Math.min(1, dt*3);
    if(t>=1){ f.jump=null; f.rot=0; L.depth = 1.5; R.phi = 1.2; R.intentT = rand(.8,1.4); splashFX(L.x, 3); sfx('bigsplash'); doShake(2.5); }
    return;
  }
  R.burstCd -= dt;
  if(R.burstT>0) R.burstT -= dt;
  else if(R.burstCd<=0){ R.burstT = rand(.5,1.1) + sp.diff*.05; R.burstCd = Math.max(.8, rand(1.4,3.4) - sp.diff*.1); sfx('thrash'); bubbles(f.x, f.y, 6); doShake(1.5); }
  R.intentT -= dt;
  if(R.intentT<=0){
    R.intentT = rand(.8, 2);
    const roll = Math.random();
    R.phi = roll < .25*(1.3-R.stamina) + (L.depth < 12 ? .2 : 0) ? -.5 : roll < .55 ? .15 : roll < .8 ? .65 : 1.15;
  }
  const force = .15 + sp.diff*.085;
  const wob = .6 + .4*Math.sin(time*(2+sp.speed*.3) + f.ph);
  R.stamina = Math.max(0, R.stamina - dt*.03*(R.tension/50));
  R.pull = force*wob*(R.burstT>0 ? 1.8 : 1)*(.7 + .3*R.stamina);
  const vx = L.x - Px, vy = L.depth*FT, len = Math.hypot(vx, vy) || 1;
  const reelSpd = R.rate*28*rd.reel, pullSpd = R.pull*16;
  let nx = L.x - vx/len*reelSpd*dt + Math.cos(R.phi)*pullSpd*dt;
  let ny = vy - vy/len*reelSpd*dt + Math.sin(R.phi)*pullSpd*dt;
  let strained = false;
  const maxD = lureCap()*FT;
  if(ny > maxD){ ny = maxD; if(R.phi > .3) strained = true; }
  if(ny < 0) ny = 0;
  const maxLen = rd.depth*FT + 180, nl = Math.hypot(nx-Px, ny);
  if(nl > maxLen){ nx = Px + (nx-Px)*maxLen/nl; ny = ny*maxLen/nl; strained = true; }
  L.x = clamp(nx, Px, W-6); L.depth = ny/FT;
  const target = (R.rate*35 + R.pull*R.rate*80 + R.pull*15 + (strained ? R.pull*40 : 0)) / rd.str;
  R.tension += (target - R.tension)*Math.min(1, dt*(target>R.tension ? 5 : 3));
  if(R.tension >= 100){ R.snapT += dt; if(R.snapT > .12) return snapLine(); } else R.snapT = 0;
  if(R.tension < 14) R.slack += dt; else R.slack = Math.max(0, R.slack - dt*1.5);
  if(R.slack > 2.4) return escapeFish();
  const dist = Math.hypot(L.x - Px, L.depth*FT);
  if(dist <= 10 && L.depth <= 2) return landFish();
  f.leapCd -= dt;
  if(f.leapCd <= 0 && dist > 22){
    if(L.depth < .4) { if(Math.random() < .75) startLeap(f); else { R.phi = 1.1; f.leapCd = 1.5; } }
    else if(L.depth < 5 && Math.random() < dt*1.1*(1 + sp.rarity*.25)) startLeap(f);
  }
  if(L.depth < .05 && !f.jump && R.phi < 0) R.phi = .9;
}

function updateFish(dt){
  const L = G.lure, lureWet = G.state==='sinking' || G.state==='waiting';
  let chasers = fishes.filter(f=>f.mode==='interested').length;
  const biteMul = bait().bite * (HOT ? 1.4 : 1);
  for(const f of fishes){
    const sp = f.def;
    f.ft += dt*(3 + sp.speed*.6)*(f.mode==='hooked' ? 2.2 : f.mode==='flee' ? 1.8 : 1);
    if(f.mode==='roam' || f.mode==='flee'){
      f.x += f.dir*f.speed*(f.mode==='flee'?1:.5)*dt;
      f.y = depthToY(f.depth, f.x) + Math.sin(time*1.3+f.ph)*3;
      if(f.mode==='roam'){
        f.turnT -= dt; if(f.turnT<=0){ f.dir*=-1; f.turnT=rand(4,10); }
        f.cd -= dt;
        if(lureWet && f.cd<=0){
          f.cd = 1.2;
          const d = Math.hypot(f.x-L.x, f.y-L.y);
          // fancy bait doesn't tempt small fry: fish more than a tier below the bait mostly ignore it
          const gap = S.bait - sp.rarity, baitFit = gap <= 0 ? 1 : gap === 1 ? .35 : .06;
          if(d < 26 + S.bait*7 && chasers < 3 && Math.random() < .45*biteMul*RAR_BITE[sp.rarity]*baitFit){ f.mode = 'interested'; f.chaseT = rand(2.5, 4); chasers++; }
        }
      }
    } else if(f.mode==='interested'){
      const w = f.def.sprite.w, dx = L.x - f.x, dy = L.y - f.y, d = Math.hypot(dx,dy);
      f.chaseT = (f.chaseT ?? 3) - dt;
      // give up after a few seconds, or if the lure gets away
      if(!lureWet || f.chaseT <= 0 || d > 26 + S.bait*7 + 40){ f.mode='roam'; f.cd = rand(3, 5); f.depth = clamp((f.y - SURF)/FT, .8, LAKE_FT-1); continue; }
      if(Math.abs(dx)>1) f.dir = Math.sign(dx);
      const s2 = f.speed*.9*dt;
      if(d > w/2 + 1){ f.x += dx/d*s2; f.y += dy/d*s2; f.depth = (f.y - SURF)/FT; }
      else { G.state='bite'; G.bite = {fish:f, t: Math.max(.45, .95 - sp.rarity*.07 - sp.diff*.015)}; f.mode='bite'; sfx('bite'); doShake(4); buzz(40);
        for(const o of fishes) if(o !== f && o.mode==='interested'){ o.mode = 'roam'; o.cd = rand(2, 4); o.depth = clamp((o.y - SURF)/FT, .8, LAKE_FT-1); } }
    } else if(f.mode==='bite'){
      const w = f.def.sprite.w; f.x = L.x - f.dir*(w/2 - 1); f.y = L.y + Math.sin(time*30)*.6;
    } else if(f.mode==='netted'){
      const N = G.net; if(!N){ f.mode='flee'; continue; }
      f.x = N.x + f.nx + Math.sin(time*6 + f.ph)*1.2; f.y = SURF + N.d*FT + f.ny; if(Math.random() < dt*2) f.dir *= -1;
    } else if(f.mode==='shot'){
      const s2 = surfY(f.x) + 1;
      if(f.y > s2){ f.y = Math.max(s2, f.y - f.vy*dt); f.vy = Math.min(40, f.vy + 10*dt); }
      else { f.y = s2 + Math.sin(time*3 + f.ph)*.6; f.surfT = (f.surfT||0) + dt; if(f.surfT > .5) collectShot(f); }
    } else if(f.mode==='dead'){
      // handled by the blast
    } else if(f.mode==='hooked'){
      const w = f.def.sprite.w;
      if(f.jump){ f.dir = 1; f.x = L.x; f.y = f.jumpY; }
      else { f.dir = 1; f.x = L.x + (w/2 - 1); f.y = L.y + Math.sin(time*22)*1.2; }
    }
  }
  fishes = fishes.filter(f => !((f.mode==='roam'||f.mode==='flee') && (f.x < -50 || f.x > W+50)));
  const roaming = fishes.filter(f=>f.mode==='roam');
  if(roaming.length < fishTarget() + S.bait*2 && Math.random() < dt*1.4) spawnFish();
  if(lureWet && Math.random() < dt*1.5){
    const near = roaming.filter(f => Math.abs(f.depth - L.depth) < 22).length;
    if(near < (HOT ? 6 : 4)) spawnFish(null, false, clamp(L.depth + rand(-10,10), 1, LAKE_FT-2));
  }
}
function sprH(s){ if(s.h) return s.h; const img=s.frames[0]; return img && img.naturalWidth ? s.w*img.naturalHeight/img.naturalWidth : s.w*.5; }
function updateRelease(dt){
  const a = G.relAnim; if(!a) return;
  a.t += dt; const t = Math.min(1, a.t/a.dur);
  a.x = lerp(a.sx, a.tx, t); a.y = lerp(a.sy, surfY(a.tx), t) - Math.sin(Math.PI*t)*22; a.rot = t*Math.PI*2;
  if(t>=1){ splashFX(a.tx, 2); sfx('splash'); const f = spawnFish(a.sp, true, 2); f.x = a.tx; fleeFish(f); G.relAnim = null; }
}

/* ================== Fishing render ================== */
function drawSprite(s, x, y, dir, ft, rot){
  const seq = s.seq || [0], fr = s.frames[seq[Math.floor(ft||0) % seq.length]] || s.frames[0];
  const w = s.w, h = sprH(s);
  ctx.save(); ctx.translate(Math.round(x), Math.round(y));
  if(rot) ctx.rotate(Math.round(rot/(Math.PI/4))*(Math.PI/4));
  let flip = dir < 0; if(s.facesLeft) flip = !flip;
  if(flip) ctx.scale(-1, 1);
  if(s.smooth){ ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high'; }
  if(fr && (fr.width || fr.naturalWidth)) ctx.drawImage(fr, -w/2, -h/2, w, h);
  ctx.imageSmoothingEnabled = false;
  ctx.restore();
}
function onScreen(y, m=30){ return y > camY - m && y < camY + H + m; }
function drawFish(f){ if(onScreen(f.y)) drawSprite(f.def.sprite, f.x, f.y, f.dir, f.ft, f.rot); }
function drawFishGlow(f){
  if(!onScreen(f.y)) return;
  const s = f.def.sprite, x = Math.round(f.x), y = Math.round(f.y), w = s.w;
  if(f.def.rarity < 4 && !s.lantern) return;
  ctx.save(); ctx.globalCompositeOperation='lighter';
  if(f.def.rarity >= 4){
    const pulse = .5 + .5*Math.sin(time*3 + f.ph);
    const g = ctx.createRadialGradient(x,y,1,x,y,w*.9);
    g.addColorStop(0, f.def.rarity===5 ? `rgba(255,90,170,${.28+.18*pulse})` : `rgba(255,190,70,${.25+.15*pulse})`);
    g.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=g; ctx.fillRect(x-w, y-w, w*2, w*2);
    if(Math.random()<.08) parts.push({t:'spark', x:x+rand(-w/2,w/2), y:y+rand(-3,3), vx:0, vy:-8, life:.5});
  }
  if(s.lantern && !f.rot){
    const flip = f.dir<0 ? -1 : 1, lx = x + s.lantern.x*flip, ly = y + s.lantern.y, p = .6+.4*Math.sin(time*5+f.ph);
    const g = ctx.createRadialGradient(lx,ly,0,lx,ly,10); g.addColorStop(0,`rgba(127,240,224,${.75*p})`); g.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=g; ctx.fillRect(lx-10,ly-10,20,20);
  }
  ctx.restore();
}
function drawKelp(k, back){
  const segs = Math.floor(k.h/3);
  if(k.giant){ // giant kelp: olive-brown stalk with leaf blades and gas bladders, swaying more near the top
    for(let i=0;i<segs;i++){
      const y = BED_Y + 4 - i*3; if(y < camY-6 || y > camY+H+6) continue;
      const x = k.x + Math.sin(time*(back?.5:.7) + k.ph + i*.08)*Math.min(14, i*.18);
      px(x, y-3, 2, 3, back ? (i%2 ? '#24403a' : '#2a4a40') : (i%2 ? '#5a6a2a' : '#6a7a30'));
      if(i%3===1){ const dir = (i%6===1) ? 1 : -1; px(x + (dir>0 ? 2 : -4), y-2, 4, 1, back ? '#2e5246' : '#7f8f3a'); px(x + (dir>0 ? 4 : -5), y-3, 2, 1, back ? '#2e5246' : '#7f8f3a'); if(!back && i%9===4) px(x + (dir>0 ? 2 : -1), y-1, 1, 1, '#c8b04a'); }
    }
    return;
  }
  if(k.grass){ // short seagrass tufts
    for(let b=-1;b<=1;b++) for(let i=0;i<Math.floor(k.h/2);i++){ const y = BED_Y + 4 - i*2, x = k.x + b*2 + Math.sin(time*1.2 + k.ph + b + i*.3)*i*.18; px(x, y-2, 1, 2, back ? (b ? '#2f7a5a' : '#3a8a60') : (b ? '#4a9a5a' : '#5aaa62')); }
    return;
  }
  for(let i=0;i<segs;i++){
    const y = BED_Y + 4 - i*3, x = k.x + Math.sin(time*(back?.7:1) + k.ph + i*.35)*i*.22;
    const bk = LAKE_FT < 60 ? ['#1f5d63','#24696e'] : ['#0b2236','#0e2a40'];
    px(x, y-3, 2, 3, back ? bk[0] : (i%2 ? '#24583f' : '#2f6b48'));
    if(i%4===2) px(x + (i%8===2 ? 2 : -3), y-2, 3, 1, back ? bk[1] : '#3f8051');
  }
}
/* ================== Biome scenery ==================
   Built once per fishing spot in buildScenery(), drawn in layers:
   sky extras (behind the water line), back (behind fish), bed (on the bottom), front (in front of fish)
   and glow (after the day tint, so it shines at night). */
let SC = {};
function buildScenery(){
  SC = {};
  const seedR = mulberry32((Math.round(T.x)*73856093 ^ Math.round(T.y)*19349663 ^ BIOME*83492791) >>> 0), R = (a,b) => a + seedR()*(b-a);
  if(BIOME===B.mangrove){
    SC.trees = [{x:R(4,18), s:R(.9,1.1)}, {x:R(226,246), s:R(.9,1.2)}, {x:R(288,308), s:R(.8,1)}].map(t => ({...t, roots:Array.from({length:6},(_,i)=>({y0:-R(4,16)*t.s, dx:(i%2?1:-1)*R(6,26)*t.s, bend:R(-6,6)}))}));
    SC.leaves = Array.from({length:7},()=>({x:R(150,320), ph:R(0,6)}));
  }
  if(BIOME===B.reef && LAKE_FT < 120){
    const [c, g] = mk(W, 70); const pal = ['#ff7a7a','#ffb35a','#c07ae0','#f2e06a','#5ad0c0','#ff8ab8','#ff9a4a'];
    const put = (x,y,col) => { g.fillStyle = col; g.fillRect(Math.round(x), Math.round(y), 1, 1); };
    const base = 66; // bottom of the canvas sits on the reef floor
    for(let x=6; x<W; x+=R(14,24)){
      const col = pal[Math.floor(R(0,pal.length))], dk = shade(col,-.35), lt = shade(col,.35), type = Math.floor(R(0,4));
      if(type===0){ // branching coral
        const grow = (x0,y0,ang,len,d) => { for(let i=0;i<len;i++){ const xx = x0+Math.cos(ang)*i, yy = y0-Math.sin(ang)*i; put(xx,yy,i===len-1?lt:col); put(xx+1,yy,dk); } if(d<3){ const ex = x0+Math.cos(ang)*len, ey = y0-Math.sin(ang)*len; grow(ex,ey,ang+R(.3,.7),len*.7,d+1); grow(ex,ey,ang-R(.3,.7),len*.7,d+1); } };
        grow(x, base, Math.PI/2, R(6,10), 0);
      } else if(type===1){ // brain coral dome
        const rx = R(5,9), ry = R(3,6);
        for(let yy=-ry; yy<=0; yy++) for(let xx=-rx; xx<=rx; xx++) if(xx*xx/(rx*rx)+yy*yy/(ry*ry) <= 1) put(x+xx, base+yy, (Math.abs(Math.sin(xx*.9+yy*1.7))<.25) ? dk : (yy < -ry*.6 ? lt : col));
      } else if(type===2){ // sea fan
        const h = R(10,18);
        for(let k=-4;k<=4;k++){ const a = Math.PI/2 + k*.17; for(let i=0;i<h;i+=1.5) if(seedR() < .8) put(x+Math.cos(a)*i, base-Math.sin(a)*i, i>h*.7 ? lt : col); }
        for(let i=0;i<4;i++) put(x, base-i, dk);
      } else { // tube sponges
        for(let t=0;t<R(2,5);t++){ const tx = x+t*3, h = R(5,14); for(let i=0;i<h;i++){ put(tx,base-i,col); put(tx+1,base-i,dk); } put(tx,base-h,lt); put(tx+1,base-h,lt); }
      }
    }
    SC.coral = c;
    SC.anem = Array.from({length:4},()=>({x:R(10,310), col:pal[Math.floor(R(0,pal.length))], ph:R(0,6)}));
  }
  if(BIOME===B.volcanic){
    SC.vents = Array.from({length:Math.floor(R(3,5))},()=>({x:R(20,300), h:R(8,26), w:R(5,9), ph:R(0,6)}));
    SC.volcano = {x:R(240,290)};
  }
  if(BIOME===B.frozen){
    SC.bergs = [{x:R(200,230), w:R(34,48), h:R(14,22)}, {x:R(280,300), w:R(20,30), h:R(8,13)}];
    SC.floes = [{x:R(150,170), w:R(18,28)}, {x:R(220,245), w:R(14,22)}, {x:R(285,305), w:R(16,26)}];
    SC.snow = Array.from({length:50},()=>({x:R(0,W), y:R(0,SURF), v:R(6,12), ph:R(0,6)}));
  }
  if(BIOME===B.deep || BIOME===B.abyss) SC.glow = Array.from({length:36},()=>({x:R(0,W), y:R(SURF+120, BED_Y), ph:R(0,6), c:seedR()<.6 ? '127,240,224' : '170,140,255'}));
}
function drawSkyExtras(){
  if(SC.volcano){ // a smoking volcano on the horizon
    const vx = Math.round(SC.volcano.x), base = SURF-1;
    for(let y=0;y<28;y++){ const half = 3 + y*1.4, yy = base - 27 + y; px(vx-half, yy, half, 1, '#463c4c'); px(vx, yy, half, 1, '#342c3a'); }
    px(vx-3, base-28, 6, 2, '#5a2a24'); px(vx-2, base-28, 4, 1, '#ff7a3a');
    for(let i=0;i<6;i++){ const t = (time*.12 + i/6) % 1, sx = vx + t*26 + Math.sin(time+i)*2, sy = base-30 - t*30, r = 2 + t*5; ctx.fillStyle = `rgba(90,86,96,${.55*(1-t)})`; ctx.beginPath(); ctx.arc(sx, sy, r, 0, Math.PI*2); ctx.fill(); }
  }
  if(SC.bergs){ // frosty haze over the hills, then jagged icebergs on the horizon
    ctx.fillStyle = 'rgba(232,244,250,.5)'; ctx.fillRect(0, SURF-34, W, 38);
    for(const b of SC.bergs) for(let x=-b.w/2; x<=b.w/2; x++){
      const u = Math.abs(x)/(b.w/2), X = Math.round(b.x + x), h = Math.round(b.h*Math.min(1, (1 - u)*1.7)*(.86 + .14*Math.sin(Math.floor(x/3)*1.3 + b.x)));
      if(h <= 0) continue; px(X, SURF - h, 1, h, x < b.w*.12 ? '#f2fbfd' : '#b8dae8'); px(X, SURF - h, 1, 1, '#ffffff');
    }
  }
  if(SC.trees) for(const t of SC.trees){ // mangrove canopy and trunks above the water
    const x = Math.round(t.x), s = t.s;
    px(x-1, SURF-22*s, 3, 22*s, '#4a3a2a');
    for(const [ox,oy,r,c] of [[-10,-30,10,'#2a5030'],[8,-32,11,'#2e5834'],[0,-38,10,'#3a6a3c'],[-4,-28,8,'#356238'],[12,-26,7,'#2a5030']]){
      const cx = x+ox*s, cy = SURF+oy*s, rr = r*s; for(let yy=-rr; yy<=rr; yy++){ const w = Math.round(Math.sqrt(rr*rr-yy*yy)); px(cx-w, cy+yy, w*2, 1, c); }
      if(c==='#3a6a3c') px(cx-3, cy-rr+2, 4, 1, '#4f8a4a');
    }
  }
  if(SC.snow) for(const f of SC.snow){ const y = (f.y + time*f.v) % SURF, x = (f.x + Math.sin(time*.8 + f.ph)*4 + W) % W; ctx.fillStyle = 'rgba(250,252,255,.85)'; ctx.fillRect(Math.round(x), Math.round(y), 1, 1); }
}
function drawSceneryBack(){
  if(SC.trees) for(const t of SC.trees){ // arching prop roots down into the water
    for(const r of t.roots){ const x0 = t.x, y0 = SURF + r.y0, x1 = t.x + r.dx, y1 = BED_Y + 1;
      pixelCurve(x0, y0, x0 + r.dx*.9 + r.bend, y0 + 2, x1, y1, '#3e3020'); pixelCurve(x0+1, y0, x0 + r.dx*.9 + r.bend + 1, y0 + 2, x1+1, y1, '#5a4632'); }
  }
  if(SC.vents && camY + H > BED_Y - 260) for(const v of SC.vents){ // rising bubble streams
    const top = BED_Y - 6 - v.h, rise = Math.min(240, top - SURF - 4);
    for(let i=0;i<9;i++){ const t = (time*.22 + i/9 + v.ph) % 1, y = top - t*rise; if(!onScreen(y,2)) continue; const x = v.x + Math.sin(time*2 + i*1.7 + v.ph)*(1 + t*4); ctx.fillStyle = `rgba(220,226,235,${.55*(1-t)})`; ctx.fillRect(Math.round(x), Math.round(y), i%3===0 ? 2 : 1, i%3===0 ? 2 : 1); }
  }
}
function drawSceneryBed(){
  if(SC.coral) ctx.drawImage(SC.coral, 0, BED_Y - 68);
  if(SC.anem) for(const a of SC.anem){ const by = BED_Y - 2; px(a.x-2, by-2, 5, 2, shade(a.col,-.3)); for(let k=-3;k<=3;k++){ for(let i=0;i<6;i++){ const x = a.x + k*.9 + Math.sin(time*1.6 + a.ph + k*.6 + i*.4)*i*.35, y = by - 2 - i; px(x, y, 1, 1, i>3 ? shade(a.col,.4) : a.col); } } }
  if(SC.vents) for(const v of SC.vents){ // basalt chimneys with a glowing mouth
    const base = BED_Y - 2;
    for(let y=0;y<v.h;y++){ const half = Math.round(v.w*(.45 + .55*(y/v.h))/2) + 1; px(v.x-half, base-v.h+y, half, 1, '#2e262a'); px(v.x, base-v.h+y, half, 1, '#1c1618'); if(y%5===2) px(v.x-half, base-v.h+y, 1, 1, '#4a3a3a'); }
    px(v.x-2, base-v.h-1, 4, 2, '#ff8a3a'); px(v.x-1, base-v.h-1, 2, 1, '#ffd27a');
  }
}
function drawSceneryFront(){
  if(SC.floes && camY < SURF + 30) for(const f of SC.floes){ // ice floes riding the swell
    for(let x=Math.round(f.x); x<f.x+f.w; x++){ const s = Math.round(surfY(x)), e = Math.min(x - f.x, f.x + f.w - x);
      px(x, s-2, 1, 2, '#f6fcfe'); px(x, s, 1, Math.min(5, 2 + e*.6), 'rgba(186,226,238,.9)'); if((x*7)%11===0 && e > 2) px(x, s+Math.min(5,2+e*.6), 1, 2, 'rgba(220,244,250,.8)'); }
  }
  if(SC.leaves && camY < SURF + 10) for(const l of SC.leaves){ const x = (l.x + time*1.5) % W; px(x, Math.round(surfY(x)) - 1, 2, 1, '#4a7a3a'); }
}
// After the tint: things that glow, so they still read at night
function drawSceneryGlow(){
  if(SC.vents && camY + H > BED_Y - 80){
    ctx.save(); ctx.globalCompositeOperation='lighter';
    for(const v of SC.vents){ const x = v.x, y = BED_Y - 3 - v.h, p = .7 + .3*Math.sin(time*3 + v.ph); const g = ctx.createRadialGradient(x,y,1,x,y,22); g.addColorStop(0,`rgba(255,130,60,${.4*p})`); g.addColorStop(1,'rgba(255,90,40,0)'); ctx.fillStyle = g; ctx.fillRect(x-22,y-22,44,44); }
    const bg = ctx.createLinearGradient(0, BED_Y-40, 0, BED_Y+6); bg.addColorStop(0,'rgba(255,80,30,0)'); bg.addColorStop(1,'rgba(255,80,30,.14)'); ctx.fillStyle = bg; ctx.fillRect(0, BED_Y-40, W, 46);
    ctx.restore();
  }
  if(SC.volcano && camY < SURF+4){ const x = Math.round(SC.volcano.x), y = SURF-29; ctx.save(); ctx.globalCompositeOperation='lighter'; const g = ctx.createRadialGradient(x,y,1,x,y,14); g.addColorStop(0,'rgba(255,120,50,.55)'); g.addColorStop(1,'rgba(255,80,40,0)'); ctx.fillStyle = g; ctx.fillRect(x-14,y-14,28,28); ctx.restore(); }
  if(SC.glow){ ctx.save(); ctx.globalCompositeOperation='lighter'; for(const s of SC.glow){ if(!onScreen(s.y,2)) continue; const a = .25 + .25*Math.sin(time*2 + s.ph); if(a < .08) continue; ctx.fillStyle = `rgba(${s.c},${a})`; ctx.fillRect(Math.round(s.x + Math.sin(time*.3+s.ph)*3), Math.round(s.y), 1, 1); } ctx.restore(); }
}
function pixelCurve(x0,y0,cx,cy,x1,y1,col,thickTo=0){
  const steps = Math.max(8, Math.ceil(Math.hypot(x1-x0,y1-y0)*1.2));
  ctx.fillStyle = col;
  for(let i=0;i<=steps;i++){
    const t=i/steps, a=(1-t)*(1-t), b=2*(1-t)*t, c=t*t;
    const x=a*x0+b*cx+c*x1, y=a*y0+b*cy+c*y1, th = t<thickTo ? 2 : 1;
    if(y < camY-4 || y > camY+H+4) continue;
    ctx.fillRect(Math.round(x), Math.round(y), th, th);
  }
}
function drawBoatAndFisher(){
  const r = G.rig, b = boat(), L = b.len, top = r.top, left = r.left, hull = b.hull, dk = shade(hull,-.35), lt = shade(hull,.28);
  if(top > camY + H + 20) return;
  if(S.boat>=2){
    px(left+4, top-12, 15, 12, '#e8e0cc'); px(left+3, top-14, 17, 2, '#7a2a20');
    px(left+8, top-9, 5, 4, '#6fb7c9'); px(left+8, top-9, 5, 1, '#a9e0ea');
  }
  if(S.boat>=3){
    px(left+11, top-46, 2, 34, '#5a4030');
    for(let i=0;i<5;i++) px(left+13+i*2, top-46 + Math.round(Math.sin(time*5 - i*.8)*1), 2, 5, i%2 ? '#ff6a3d' : '#ff8a5d');
  }
  // Stern lantern on a short pole; it glows after dark
  px(left+2, top-11, 1, 11, '#4a3420'); px(left, top-11, 3, 1, '#4a3420');
  px(left-1, top-10, 3, 3, '#7a5a2a'); px(left, top-9, 1, 1, '#ffd27a');
  r.lantern = {x:left, y:top-9};
  if(S.light >= 0){ const bx = left + L - 8; px(bx, top-4, 4, 3, '#5a6570'); px(bx, top-4, 4, 1, '#8a96a0'); px(bx+4, top-4, 1, 3, '#ffe48a'); px(bx+1, top-1, 2, 1, '#3d4650'); }
  if(S.boat===1){ px(left-5, top-4, 5, 7, '#2b2f3a'); px(left-6, top-6, 7, 3, '#d84f3a'); px(left-3, top+3, 1, 6, '#55606a'); }
  S.inv.forEach((it, i) => { if(G.pending.has(it.uid)) return; const p = pileSlot(i, r), sp = byId[it.sid]; drawSprite(sp ? sp.pile : GENERIC_PILE, p.x, p.y, hash(it.uid)%2 ? 1 : -1, 0, 0); });
  if(G.state==='landed' && G.landed){ const p = G.landed.slot; drawSprite(G.landed.sp.pile, p.x, p.y + (Math.floor(time*6)%2 ? -1 : 0), 1, time*6, 0); }
  const fx = r.fx;
  px(fx, top-9, 6, 10, '#f2c14e'); px(fx+5, top-9, 1, 10, '#c99a2e'); px(fx, top-5, 6, 1, '#c99a2e');
  px(fx+1, top-14, 5, 5, '#f0c39b'); px(fx+1, top-11, 1, 2, '#8a5a3a'); px(fx+2, top-10, 3, 1, '#8a5a3a');
  px(fx+4, top-13, 1, 1, '#2a1a10');
  px(fx+1, top-16, 5, 2, '#2f5d50'); px(fx-1, top-14, 9, 1, '#244a40');
  px(fx+5, top-7, 5, 2, '#f2c14e'); px(fx+10, top-7, 2, 2, '#f0c39b');
  const rows = [];
  for(let row=0; row<11; row++){
    const l = Math.round(left + row*.9 + (row>6 ? (row-6)*1.2 : 0)), rr = Math.round(left + L - row*1.8 - (row>5 ? (row-5)*1.5 : 0));
    const c = row===0 ? lt : row===1 ? dk : row%3===1 ? dk : hull;
    px(l, top+row, rr-l, 1, c); rows.push([l, rr]);
  }
  px(left+L-3, top-2, 4, 2, lt); px(left-1, top-1, 3, 1, lt);
  for(let x=left+6; x<left+L-8; x+=10) px(x, top+4, 1, 1, '#d9c9a0');
  ctx.fillStyle = 'rgba(38,128,158,.5)';
  rows.forEach(([l, rr], row) => { const y = top+row; for(let x=l; x<rr; x++) if(y >= Math.ceil(surfY(x))) ctx.fillRect(x, y, 1, 1); });
  px(r.hx-1, r.hy-1, 3, 3, '#9aa6b0'); px(r.hx, r.hy, 1, 1, '#5a6570');
  const tensionK = G.state==='reeling' ? G.reel.tension/100 : G.state==='bite' ? .3 : 0;
  let tipX = r.tipX, tipY = r.tipY;
  const dx = G.lure.x-tipX, dy = G.lure.y-tipY, dl = Math.hypot(dx,dy)||1, bend = tensionK*10;
  tipX += dx/dl*bend*.45; tipY += dy/dl*bend*.45;
  const cx = (r.hx+tipX)/2 + dx/dl*bend, cy = (r.hy+tipY)/2 + dy/dl*bend;
  if(!isGun(G.tool)){ pixelCurve(r.hx, r.hy, cx, cy, tipX, tipY, rod().col, .3); px(tipX, tipY, 1, 1, '#efe3c8'); }
  G.rig.btX = tipX; G.rig.btY = tipY;
}
function drawLine(){
  if(isGun(G.tool) && G.state==='idle') return;
  const L = G.lure, tx = G.rig.btX ?? G.rig.tipX, ty = G.rig.btY ?? G.rig.tipY;
  const wet = isWet();
  let sag = wet ? 10 : 3; if(G.state==='reeling') sag = 14*(1 - G.reel.tension/100);
  if(G.state==='casting' || G.state==='landing') sag = -6;
  pixelCurve(tx, ty, (tx+L.x)/2, Math.max(ty, L.y) - (wet ? (L.y - ty)*.45 : 0) + sag, L.x, L.y, 'rgba(235,240,240,.62)');
  if(G.state==='landing' || (G.hooked && G.hooked.jump)) return;
  const lx = Math.round(L.x), ly = Math.round(L.y), bc = bait().col;
  if(S.bait>=2 || L.depth>40){ ctx.save(); ctx.globalCompositeOperation='lighter'; const g=ctx.createRadialGradient(lx,ly,0,lx,ly,S.bait>=2?9:5); g.addColorStop(0, S.bait===3 ? 'rgba(255,210,94,.55)' : S.bait===2 ? 'rgba(127,240,224,.5)' : 'rgba(200,220,230,.25)'); g.addColorStop(1,'rgba(0,0,0,0)'); ctx.fillStyle=g; ctx.fillRect(lx-9,ly-9,18,18); ctx.restore(); }
  px(lx, ly, 1, 3, '#cfd6db'); px(lx+1, ly+2, 1, 1, '#cfd6db'); px(lx+2, ly+1, 1, 1, '#cfd6db');
  if(S.bait===0){ px(lx-1, ly+1, 2, 1, bc); px(lx-2, ly+2, 1, 1, bc); }
  else { px(lx-1, ly-1, 2, 3, bc); if(Math.floor(time*4)%2) px(lx-1, ly-1, 1, 1, '#ffffff'); }
}
/* ================== Light in the dark ==================
   The day tint and deep water darken everything. Lights (a glowing lure, lanternfish, the boat light)
   redraw the fish inside their glow at full color: fish are drawn again onto an offscreen layer,
   cut to the shape of the lights, and laid over the darkened scene. */
const [litC, litG] = mk(W, H), [maskC, maskG] = mk(W, H);
litG.imageSmoothingEnabled = false;
function boatBeam(){
  if(S.light < 0 || !G.rig || !G.rig.top) return null;
  const r = G.rig, reach = Math.min(LIGHTS[S.light].reach*FT, (ABYSS ? 9999 : BED_Y - SURF)), bx = r.left + boat().len - 6, by = SURF + 1;
  const ey = by + reach, cx = bx + reach*.28, half = 12 + reach*.32;
  return {bx, by, ey, cx, half, reach};
}
function drawLights(sx, syc){
  const lights = [];
  const glowBait = isWet() && S.bait >= 2 && G.state!=='landing';
  if(glowBait) lights.push({x:G.lure.x, y:G.lure.y, r:S.bait===3 ? 44 : 36, col:S.bait===3 ? '255,214,110' : '127,240,224'});
  for(const f of fishes){ const ln = f.def.sprite.lantern; if(ln && !f.rot && onScreen(f.y, 20)){ const flip = f.dir<0 ? -1 : 1; lights.push({x:f.x + ln.x*flip, y:f.y + ln.y, r:18, col:'127,240,224', small:true}); } }
  const beam = boatBeam();
  if(!lights.length && !beam) return;
  // 1. the shape of all the light, in white
  maskG.setTransform(1,0,0,1,0,0); maskG.clearRect(0,0,W,H); maskG.setTransform(1,0,0,1,sx,syc); maskG.globalCompositeOperation = 'lighter';
  for(const L of lights){ const g = maskG.createRadialGradient(L.x,L.y,0,L.x,L.y,L.r); g.addColorStop(0,'rgba(255,255,255,1)'); g.addColorStop(.55,'rgba(255,255,255,.75)'); g.addColorStop(1,'rgba(255,255,255,0)'); maskG.fillStyle = g; maskG.fillRect(L.x-L.r, L.y-L.r, L.r*2, L.r*2); }
  if(beam){ const g = maskG.createLinearGradient(0, beam.by, 0, beam.ey); g.addColorStop(0,'rgba(255,255,255,1)'); g.addColorStop(.6,'rgba(255,255,255,.7)'); g.addColorStop(1,'rgba(255,255,255,0)');
    maskG.fillStyle = g; maskG.beginPath(); maskG.moveTo(beam.bx-3, beam.by); maskG.lineTo(beam.bx+3, beam.by); maskG.lineTo(beam.cx+beam.half, beam.ey); maskG.lineTo(beam.cx-beam.half, beam.ey); maskG.closePath(); maskG.fill(); }
  // 2. the fish (and the monster) again, at full color
  litG.setTransform(1,0,0,1,0,0); litG.globalCompositeOperation = 'source-over'; litG.clearRect(0,0,W,H); litG.setTransform(1,0,0,1,sx,syc);
  const main = ctx; ctx = litG;
  try{ for(const f of fishes) drawFish(f); drawSaltwight(); if(G.state==='landing' && G.landed){ const a=G.landAnim; drawSprite(G.landed.sp.sprite, a.x, a.y, 1, time*8, a.rot); } }
  finally{ ctx = main; }
  litG.setTransform(1,0,0,1,0,0); litG.globalCompositeOperation = 'destination-in'; litG.drawImage(maskC, 0, 0); litG.globalCompositeOperation = 'source-over';
  ctx.save(); ctx.setTransform(1,0,0,1,0,0); ctx.drawImage(litC, 0, 0); ctx.restore();
  // 3. the light itself, glowing in the water; stronger the darker it is
  ctx.save(); ctx.globalCompositeOperation = 'lighter';
  for(const L of lights){ const dk = clamp(Math.max(nightK(), (L.y - SURF)/(FT*220)), .25, 1), pulse = L.small ? .8 + .2*Math.sin(time*5) : .85 + .15*Math.sin(time*3.2);
    const g = ctx.createRadialGradient(L.x,L.y,0,L.x,L.y,L.r); g.addColorStop(0,`rgba(${L.col},${.42*dk*pulse})`); g.addColorStop(.4,`rgba(${L.col},${.14*dk*pulse})`); g.addColorStop(1,`rgba(${L.col},0)`); ctx.fillStyle = g; ctx.fillRect(L.x-L.r, L.y-L.r, L.r*2, L.r*2); }
  if(beam){ const dk = clamp(Math.max(nightK(), LAKE_FT/260), .15, 1), g = ctx.createLinearGradient(0, beam.by, 0, beam.ey); g.addColorStop(0,`rgba(255,240,200,${.2*dk})`); g.addColorStop(1,'rgba(255,240,200,0)');
    ctx.fillStyle = g; ctx.beginPath(); ctx.moveTo(beam.bx-2, beam.by); ctx.lineTo(beam.bx+2, beam.by); ctx.lineTo(beam.cx+beam.half, beam.ey); ctx.lineTo(beam.cx-beam.half, beam.ey); ctx.closePath(); ctx.fill();
    // a few drifting motes catch the beam
    for(let i=0;i<14;i++){ const t = ((time*.05 + i*.071) % 1), y = beam.by + t*(beam.ey-beam.by), half = 2 + (beam.half)*t, x = beam.bx + (beam.cx-beam.bx)*t + Math.sin(i*7.3 + time*.6)*half*.8; if(!onScreen(y,2)) continue; ctx.fillStyle = `rgba(255,246,220,${.45*(1-t)*dk})`; ctx.fillRect(Math.round(x), Math.round(y), 1, 1); } }
  ctx.restore();
}
// Sailing at night: a cone of light ahead of the bow shows the map at full color
function drawTravelBeam(zoom, cam, sx, sy, sw, sh){
  const n = nightK(); if(S.light < 0 || n <= .05 || !WORLD) return;
  const len = LIGHTS[S.light].beam, a = T.ang, ax = T.x + Math.cos(a)*3, ay = T.y + Math.sin(a)*3, sp = .42;
  const tr = [zoom,0,0,zoom,-cam.x*zoom,-cam.y*zoom];
  const wedge = g => { g.beginPath(); g.moveTo(ax, ay); for(let k=0;k<=12;k++){ const aa = a - sp + 2*sp*k/12; g.lineTo(ax + Math.cos(aa)*len, ay + Math.sin(aa)*len); } g.closePath(); };
  maskG.setTransform(1,0,0,1,0,0); maskG.globalCompositeOperation = 'source-over'; maskG.clearRect(0,0,W,H); maskG.setTransform(...tr);
  const mg = maskG.createRadialGradient(ax,ay,0,ax,ay,len); mg.addColorStop(0,'rgba(255,255,255,1)'); mg.addColorStop(.7,'rgba(255,255,255,.75)'); mg.addColorStop(1,'rgba(255,255,255,0)'); maskG.fillStyle = mg; wedge(maskG); maskG.fill();
  litG.setTransform(1,0,0,1,0,0); litG.globalCompositeOperation = 'source-over'; litG.clearRect(0,0,W,H); litG.setTransform(...tr);
  litG.drawImage(WORLD.mapC, sx, sy, sw, sh, sx, sy, sw, sh);
  { const main = ctx; ctx = litG; try{ drawTopBoat(); } finally{ ctx = main; } }
  litG.setTransform(1,0,0,1,0,0); litG.globalCompositeOperation = 'destination-in'; litG.drawImage(maskC, 0, 0); litG.globalCompositeOperation = 'source-over';
  ctx.save(); ctx.setTransform(1,0,0,1,0,0); ctx.globalAlpha = .9*n; ctx.drawImage(litC, 0, 0); ctx.restore();
  ctx.save(); ctx.globalCompositeOperation = 'lighter'; const g = ctx.createRadialGradient(ax,ay,0,ax,ay,len); g.addColorStop(0,`rgba(255,240,200,${.28*n})`); g.addColorStop(1,'rgba(255,240,200,0)'); ctx.fillStyle = g; wedge(ctx); ctx.fill(); ctx.restore();
}
function drawCharge(){
  const r=G.rig, x=r.fx-10, y=r.top-26;
  px(x-1,y-1,28,6,'#0c1626'); px(x,y,26,4,'#24364d');
  const w=Math.round(26*G.power), c = G.power<.5 ? '#7bd389' : G.power<.82 ? '#ffd25e' : '#ff6a3d';
  px(x,y,w,4,c); px(x,y,w,1,'rgba(255,255,255,.45)');
}
function drawBang(){
  const L=G.lure, bounce=Math.abs(Math.sin(time*14))*3, x=Math.round(L.x)-3, y=Math.round(L.y)-22-bounce;
  for(const [ox,oy] of [[-1,0],[1,0],[0,-1],[0,1],[1,1]]) pText('!', x+ox, y+oy, '#1b0b04', 2);
  pText('!', x, y, '#ff6a3d', 2);
}
function renderFishing(){
  ctx.setTransform(1,0,0,1,0,0);
  ctx.fillStyle='#01030a'; ctx.fillRect(0,0,W,H);
  const sx = shake>0 ? Math.round(rand(-shake,shake)*.5) : 0, sy = shake>0 ? Math.round(rand(-shake,shake)*.5) : 0;
  G.shakeX = sx; G.shakeY = sy;
  const cy = Math.round(camY);
  ctx.setTransform(1,0,0,1,sx,sy-cy);
  if(cy < SURF+4){
    drawSky();
    drawSkyExtras();
    for(const c of clouds) ctx.drawImage(c.img, Math.round(c.x), c.y);
  }
  const viewBot = cy + H + 2;
  for(let x=0; x<W; x++){
    const s = Math.round(surfY(x)), y0 = Math.max(s, cy-2), h = Math.min(viewBot - y0, waterC.height - (y0-(SURF-4)));
    if(h>0) ctx.drawImage(waterC, x, y0-(SURF-4), 1, h, x, y0, 1, h);
  }
  if(cy < SURF+4){
    for(let x=0; x<W; x++){ const s=Math.round(surfY(x)); px(x, s, 1, 1, '#c6f0ee'); if((x+Math.floor(time*8))%9<3) px(x, s+1, 1, 1, 'rgba(198,240,238,.35)'); }
    const sun = sunPos(); if(sun) for(let i=0;i<10;i++){ const yy=SURF+3+i*1.6, ww=Math.max(2, 10-i)*(.6+.4*Math.sin(time*3+i*1.7)); if(Math.sin(time*6+i*2.3)>-.2) px(sun.x-ww/2+Math.sin(time*2+i)*3, yy, ww, 1, 'rgba(255,236,190,.6)'); }
  }
  if(rockC) ctx.drawImage(rockC, 0, Math.round(cy*.35));
  const dayK = 1 - nightK();
  if(cy < SURF+160 && dayK > .05){
    ctx.save(); ctx.globalCompositeOperation='lighter'; ctx.globalAlpha = dayK;
    for(let i=0;i<4;i++){
      const x0 = 40 + i*78 + Math.sin(time*.4+i)*10, wd = 10 + (i%2)*8, rl = Math.min(120, LAKE_FT*FT);
      const lg = ctx.createLinearGradient(0,SURF,0,SURF+rl); lg.addColorStop(0,`rgba(180,240,255,${BIOME===B.shallows||BIOME===B.reef ? .17 : BIOME===B.mangrove ? .05 : BIOME===B.frozen ? .14 : .11})`); lg.addColorStop(1,'rgba(180,240,255,0)');
      ctx.fillStyle=lg; ctx.beginPath(); ctx.moveTo(x0,SURF); ctx.lineTo(x0+wd,SURF); ctx.lineTo(x0+wd-30,SURF+rl); ctx.lineTo(x0-45,SURF+rl); ctx.closePath(); ctx.fill();
    }
    ctx.restore();
  }
  const bedVisible = !ABYSS && cy + H > BED_Y - 100;
  if(bedVisible || BIOME===B.kelp) for(const k of kelpBack) drawKelp(k, true);
  drawSceneryBack();
  for(const p of plankton){ if(!onScreen(p.y,2)) continue; ctx.fillStyle=`rgba(${p.c||'210,240,230'},${p.a*(.6+.4*Math.sin(time*2+p.ph))})`; ctx.fillRect(Math.round(p.x), Math.round(p.y), 1, 1); }
  if(bedVisible) ctx.drawImage(bedC, 0, BED_Y-8);
  if(bedVisible) drawSceneryBed();
  if(isWet()){
    const ly = Math.round(SURF + lureCap()*FT);
    if(onScreen(ly,2) && rod().depth < LAKE_FT){ ctx.fillStyle='rgba(255,106,61,.4)'; for(let x=14;x<W;x+=6) ctx.fillRect(x, ly, 3, 1); }
  }
  for(const f of fishes) drawFish(f);
  drawNet();
  drawSaltwight();
  drawBullets();
  for(const p of parts) if(p.t==='bub' && onScreen(p.y,2)){ ctx.fillStyle='rgba(210,245,250,.7)'; ctx.fillRect(Math.round(p.x), Math.round(p.y), 1, 1); }
  if(bedVisible || BIOME===B.kelp) for(const k of kelpFront) drawKelp(k, false);
  drawSceneryFront();
  ctx.drawImage(tintC, 0, 0);
  drawBoatAndFisher();
  drawLine();
  if(G.state==='landing'){ const a=G.landAnim; drawSprite(G.landed.sp.sprite, a.x, a.y, 1, time*8, a.rot); }
  if(G.relAnim){ const a=G.relAnim; drawSprite(a.sp.sprite, a.x, a.y, 1, time*8, a.rot); }
  for(const f of G.flyers) if(f.t >= 0) drawSprite(f.sp.sprite, f.x, f.y, 1, time*8, f.rot);
  drawDynamite();
  drawSplashes();
  for(const p of parts){
    if(p.t==='drop') px(p.x, p.y, 1, 1, p.c);
    else if(p.t==='debris'){ ctx.fillStyle=`rgba(${p.life>.5?'255,210,94':'120,110,100'},${Math.min(1,p.life*2)})`; ctx.fillRect(Math.round(p.x), Math.round(p.y), 1, 1); }
    else if(p.t==='spark'){ ctx.fillStyle=`rgba(255,230,160,${Math.min(1,p.life*2)})`; ctx.fillRect(Math.round(p.x), Math.round(p.y), 1, 1); }
  }
  // Time of day: tint the whole scene, then add what glows in the dark
  applyDayTint();
  drawLights(sx, sy-cy);
  if(cy < SURF+4) drawNightSky();
  drawSceneryGlow();
  drawLightning();
  { const r = G.rig, n = nightK(); if(r && r.lantern && n > 0){ lanternGlow(r.lantern.x, r.lantern.y, 46, n); px(r.lantern.x-1, r.lantern.y-1, 3, 3, `rgba(255,224,150,${.6+.4*n})`); px(r.lantern.x, r.lantern.y, 1, 1, '#fff6d8');
      ctx.save(); ctx.globalCompositeOperation='lighter'; for(let i=0;i<6;i++){ const yy = SURF+3+i*2, ww = Math.max(1, 6-i)*(.6+.4*Math.sin(time*3+i)); ctx.fillStyle = `rgba(255,200,120,${.35*n})`; ctx.fillRect(Math.round(r.lantern.x-ww/2+Math.sin(time*2+i)*2), yy, Math.round(ww), 1); } ctx.restore(); } }
  for(const f of fishes) drawFishGlow(f);
  const step = LAKE_FT > 200 ? 20 : 10;
  for(let d=0; d<=LAKE_FT; d+=5){ const y=Math.round(SURF + d*FT); if(!onScreen(y,6)) continue; px(0, y, d%step===0?5:3, 1, 'rgba(239,227,200,.55)'); if(d>0 && d%step===0) pText(String(d), 7, y-2, 'rgba(239,227,200,.6)'); }
  if(cy < SURF+20) pText('FT', 7, SURF+4, 'rgba(239,227,200,.4)');
  drawAim();
  if(G.state==='charging') drawCharge();
  drawGunHud();
  drawCrosshair();
  if(G.state==='bite') drawBang();
  if(M && M.strikeOpen) drawStrikeMark();
  ctx.setTransform(1,0,0,1,0,0);
  if(G.flashA > 0){ ctx.fillStyle = `rgba(255,246,220,${G.flashA})`; ctx.fillRect(0,0,W,H); }
  if(G.zapFlash > 0){ ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.fillStyle = `rgba(90,150,255,${G.zapFlash*.35})`; ctx.fillRect(0,0,W,H); ctx.restore(); }
  ctx.drawImage(vigC, 0, 0);
}

/* ================== HUD ================== */
const COIN_SVG = '<svg viewBox="0 0 8 8" width="14" height="14" style="shape-rendering:crispEdges"><rect x="2" y="0" width="4" height="8" fill="#ffd25e"/><rect x="0" y="2" width="8" height="4" fill="#ffd25e"/><rect x="1" y="1" width="6" height="6" fill="#ffd25e"/><rect x="3" y="2" width="2" height="4" fill="#c9962a"/></svg>';
const SUN_SVG = '<svg viewBox="0 0 8 8"><rect x="3" y="0" width="2" height="1" fill="#ffd25e"/><rect x="3" y="7" width="2" height="1" fill="#ffd25e"/><rect x="0" y="3" width="1" height="2" fill="#ffd25e"/><rect x="7" y="3" width="1" height="2" fill="#ffd25e"/><rect x="2" y="2" width="4" height="4" fill="#ffd25e"/><rect x="3" y="1" width="2" height="6" fill="#ffd25e"/><rect x="1" y="3" width="6" height="2" fill="#ffd25e"/><rect x="3" y="3" width="1" height="1" fill="#fff4c0"/></svg>';
const DUSK_SVG = '<svg viewBox="0 0 8 8"><rect x="2" y="3" width="4" height="2" fill="#ff9a4e"/><rect x="1" y="4" width="6" height="1" fill="#ff9a4e"/><rect x="3" y="2" width="2" height="1" fill="#ff9a4e"/><rect x="0" y="5" width="8" height="1" fill="#6f8fc4"/><rect x="1" y="6" width="6" height="1" fill="#4a6aa4"/></svg>';
const MOON_SVG = '<svg viewBox="0 0 8 8"><rect x="2" y="1" width="3" height="1" fill="#e8ecf8"/><rect x="1" y="2" width="2" height="4" fill="#e8ecf8"/><rect x="2" y="6" width="3" height="1" fill="#e8ecf8"/><rect x="3" y="5" width="3" height="1" fill="#e8ecf8"/><rect x="3" y="2" width="1" height="1" fill="#e8ecf8"/><rect x="6" y="1" width="1" height="1" fill="#e8ecf8"/></svg>';
let clockKey = '';
function updateClockChip(){
  const p = periodNow(), lbl = clockLabel(Math.floor(S.clock/10)*10), key = p.id + lbl; if(key === clockKey) return; clockKey = key;
  $('clockName').textContent = p.name; $('clockVal').textContent = lbl;
  $('clockIco').innerHTML = p.id==='night' || p.id==='evening' ? MOON_SVG : p.id==='dawn' || p.id==='dusk' ? DUSK_SVG : SUN_SVG;
}
const hintEl=$('hint'), gaugeEl=$('gauge'), gfill=$('gfill'), actionsEl=$('actions');
let lastHint='', lastActions='';
const IS_TOUCH = matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 0 && !matchMedia('(pointer: fine)').matches;
if(IS_TOUCH) document.body.classList.add('touch');
const TOUCH_TEXT = [
  ['Walk with A and D or the arrows, jump with W or Space. Walk right to explore the island.', 'Drag on the left side to walk, push up or tap Jump to jump. Walk right to explore.'],
  ['Click to shoot where you aim. R reloads.', 'Tap where you want to shoot.'],
  ['Hold click or Space to cast.', 'Press and hold to cast, then let go.'],
  ['Click to fire lightning', 'Tap to fire lightning'], [' T switches to delayed cells.', ''], ['Click where the charge should burst', 'Tap where the charge should burst'],
  [' T switches cells. Scroll to look deeper.', ' Use the arrows to look deeper.'], ['Press T to switch back to power cells.', 'Tap Normal cells to switch back.'],
  ['Sail with W A S D or the arrow keys, or hold the mouse where you want to go.', 'Put your thumb down anywhere and drag to sail.'],
  ['Hold click or Space to cast. Press 1, 2 or 3 to switch tools, Esc to sail on.', 'Press and hold to cast, then let go. Switch tools in the corner.'],
  ['Press Esc to sail back to the harbor.', 'Tap Return to sail and head back to the harbor.'],
  ['Hold click or Space to throw the', 'Press and hold to throw the'], [', then release.', ', then let go.'],
  ['Point where and how deep, then click or Space to throw', 'Tap where and how deep to throw it'],
  ['Release to', 'Let go to'],
  ['Sinking. Click to stop at this depth, or scroll to adjust.', 'Sinking. Tap to stop here, or use the arrows.'],
  ['Scroll to raise or lower the lure. Hold to reel in. R pulls the line out.', 'Use the arrows to raise or lower the lure. Hold to reel in.'],
  ['Bite! Click or press Space now!', 'Bite! Tap now!'],
  ['Strike! Click or press Space!', 'Strike! Tap now!'],
  ['Click to shoot', 'Tap to shoot'], [' R reloads. Scroll to look deeper.', ' Use the arrows to look deeper.'],
  ['Press Q for the tool wheel, Esc to sail on.', 'Tap the tool button to switch tools.'],
  ['Press R to reload.', 'Tap Reload to reload.'], ['Reload first: press R.', 'Reload first: tap Reload.'],
  ['Pick it from the tool wheel while fishing.', 'Pick it from the tool wheel while fishing.'],
  ['Reel it all the way to the boat. Ease off when the gauge turns red.', 'Hold to reel it all the way to the boat. Let go when the gauge turns red.'],
  ['Click to haul it up.', 'Tap to haul it up.'],
  ['Scroll or press W/S to move it up or down', 'Hold the arrows to move it up or down'],
  ['Sail up to the harbor and press E to shop.', 'Sail up to the harbor and tap Enter harbor to shop.'],
  ['Press 2 while fishing to use it.', 'Pick it from the tools while fishing.'],
  ['Press 3 while fishing to throw.', 'Pick it from the tools while fishing.'],
  ['Let go of the throttle and slow to a stop before casting.', 'Let go and slow to a stop before casting.'],
];
function touchText(t){ if(!IS_TOUCH || !t) return t; for(const [a,b] of TOUCH_TEXT) t = t.split(a).join(b); return t; }
// Tutorial hints show until you've done the thing once, then never again
function markSeen(k){ if(!S.seen[k]){ S.seen[k] = 1; save(); } }
function tipHint(key, t, alert){ setHint(S.seen[key] ? '' : t, alert); }
function setHint(t, alert){ t = touchText(t); if(t!==lastHint){ hintEl.textContent=t; lastHint=t; } hintEl.classList.toggle('alert', !!alert); hintEl.style.display = t ? '' : 'none'; }
function setActions(list){
  const key = list.map(a=>a.id).join('|'); if(key===lastActions) return; lastActions = key;
  actionsEl.innerHTML = list.map(a=>`<button class="btn" data-act="${a.id}">${a.label} <kbd>${a.key}</kbd></button>`).join('');
  actionsEl.querySelectorAll('[data-act]').forEach(b => b.onclick = () => { const a = b.dataset.act; if(a==='harbor') tryEnterHarbor(); else if(a==='ashore') tryGoAshore(); else if(a==='boat') returnToSail(); else tryStartFishing(); });
}
const padEl = $('touchPad');
let padKey = '';
function updateTouchPad(){
  const dyn = G.state==='dyn' && G.dyn && G.dyn.phase!=='boom', gun = isGun(G.tool) && G.state==='idle';
  const on = IS_TOUCH && G.mode==='fish' && !G.trans && (G.state==='waiting' || G.state==='sinking' || dyn || gun);
  const bolt = gun && WEAPONS[G.tool].bolt, alt = bolt && WS(G.tool).alt;
  const key = on + '|' + dyn + '|' + gun + '|' + bolt + '|' + alt; if(key===padKey) return; padKey = key;
  padEl.classList.toggle('on', on); $('padReel').hidden = dyn || gun; $('padReload').hidden = !gun || alt; $('padAmmo').hidden = !bolt; $('padAmmo').textContent = alt ? 'Normal cells' : 'Delayed cells';
}
function bindPad(id, sign){
  const b = $(id); let timer = null;
  const stop = () => { clearInterval(timer); timer = null; T.keys.up = false; T.keys.down = false; b.classList.remove('down'); };
  b.addEventListener('pointerdown', e => {
    e.preventDefault(); ac(); b.classList.add('down');
    if(G.state==='dyn' || (isGun(G.tool) && G.state==='idle')){ T.keys[sign<0 ? 'up' : 'down'] = true; return; } // held: steer the dynamite smoothly
    nudge(sign); timer = setInterval(() => nudge(sign), 140);
  });
  ['pointerup','pointercancel','pointerleave'].forEach(ev => b.addEventListener(ev, stop));
}
bindPad('padUp', -1); bindPad('padDown', 1);
$('padReload').addEventListener('click', () => startReload());
$('padAmmo').addEventListener('click', () => toggleAmmo());
{ const jb = $('padJump'); jb.addEventListener('pointerdown', e => { e.preventDefault(); ac(); heroJump(); HERO.jumpHeld = true; jb.classList.add('down'); }); ['pointerup','pointercancel','pointerleave'].forEach(ev => jb.addEventListener(ev, () => { HERO.jumpHeld = false; jb.classList.remove('down'); })); }
$('padReload2').addEventListener('click', () => startReload());
$('gunChip').addEventListener('click', () => { if(G.mode==='fish' && G.state==='idle') toggleAmmo(); });
$('padReel').addEventListener('click', () => { if(G.mode==='fish' && (G.state==='waiting'||G.state==='sinking'||G.state==='bite')) startRetrieve(); });
function updateHud(){
  updateTouchPad();
  { const sb = $('strikeBtn'), on = !!(M && M.strikeOpen && G.mode==='fish'); if(sb.hidden === on) sb.hidden = !on; }
  // coins, time, hold and weight live in the inventory; the HUD only warns when the hold is full
  const b = boat(), wt = invWeight(), full = S.inv.length>=b.cap || wt >= b.maxW*.98;
  { const hc = $('holdChip'); if(hc.hidden === full) hc.hidden = !full; }
  updateClockChip();
  if(!WORLD){ setHint(''); setActions([]); return; }
  if(G.mode==='travel'){
    const info = waterHere();
    $('depthChip').hidden = true;
    const acts = [];
    if(nearHarbor()) acts.push({id:'harbor', label:'Enter harbor', key:'E'});
    if(stopped() && info) acts.push({id:'fish', label: info.spot ? 'Fish the hot spot' : 'Cast line', key:'Space'});
    if(!G.trans && nearShore()) acts.push({id:'ashore', label:'Go ashore', key: nearHarbor() ? 'L' : 'E'});
    setActions(G.trans ? [] : acts);
    if(G.trans || !stopped()) setHint(''); else tipHint('sail', 'Sail with W A S D or the arrow keys, or hold the mouse where you want to go.');
    gaugeEl.classList.remove('on');
    return;
  }
  if(G.mode==='land'){
    $('depthChip').hidden = true; gaugeEl.classList.remove('on'); updateTools(); updateThreat();
    $('tools').style.display = wheelTools().length ? '' : 'none';
    { const pr = $('padReload2'), hide = !curGun() || (WEAPONS[curGun()].bolt && WS(curGun()).alt); if(pr.hidden !== hide) pr.hidden = hide; }
    setActions(!G.trans && ISL && HERO.x < 74 ? [{id:'boat', label:'Back to boat', key:'E'}] : []);
    if(G.trans || !ISL) setHint('');
    else if(curGun() && S.seen.land) tipHint('gun:land', 'Click to shoot where you aim. R reloads.');
    else tipHint('land', 'Walk with A and D or the arrows, jump with W or Space. Walk right to explore the island.');
    if(Math.abs(HERO.vx) > 20 && HERO.x > 130) markSeen('land');
    return;
  }
  $('tools').style.display = '';
  setActions([]);
  const wet = isWet();
  $('depthChip').hidden = !wet;   // the lure's depth, only while it's in the water
  if(wet){ $('depthLbl').textContent = 'Lure'; $('depthVal').textContent = `${G.lure.depth.toFixed(0)} ft`; }
  const st = G.state;
  updateTools();
  updateThreat();
  const swHere = swActive();
  if(M && M.strikeOpen) setHint('Strike! Click or press Space!', true);
  else if(st==='idle' && swHere && !isGun(G.tool)) tipHint('swwarn', 'The Saltwight is here. You can\'t cast until it leaves. Strike when it attacks, or shoot it.', true);
  else if(st==='idle'){
    if(S.inv.length>=b.cap) setHint('Your hold is full. Press Esc to sail back to the harbor.');
    else if(G.tool==='net'){ const n = NETS[S.net]; tipHint('net', `Hold click or Space to throw the ${n.name}, then release. It sinks to ${Math.min(n.depth, LAKE_FT-1)} ft and holds ${n.cap} fish.`); }
    else if(isGun(G.tool) && WEAPONS[G.tool].bolt){ const id = G.tool, st = WS(id), w = WEAPONS[id];
      if(st.alt) st.ammo2 <= 0 ? setHint('Out of delayed power cells. Press T to switch back to power cells.') : tipHint('gun:lightning:alt', 'Click where the charge should burst. T switches cells. Scroll to look deeper.');
      else if(st.mag + st.ammo <= 0) setHint('Out of power cells. Buy more at the harbor shop.');
      else tipHint('gun:lightning', 'Click to fire lightning. It jumps between fish. T switches to delayed cells.'); }
    else if(isGun(G.tool)){ const id = G.tool, st = WS(id), w = WEAPONS[id];
      if(G.gun.reload) setHint('');
      else if(st.mag + st.ammo <= 0) setHint(`Out of ${w.ammoName.toLowerCase()}. Buy more at the harbor shop.`);
      else if(st.mag <= 0 && !w.auto) setHint('Press R to reload.');
      else tipHint('gun:'+id, `Click to shoot. R reloads. Scroll to look deeper.`); }
    else if(G.tool==='dyn') tipHint('dyn', `Point where and how deep, then click or Space to throw (reaches ${Math.round(dynMaxDepth())} ft).`);
    else tipHint('cast', 'Hold click or Space to cast. Press Q for the tool wheel, Esc to sail on.');
  }
  else if(st==='net'){ const N = G.net, n = NETS[N.tier]; if(S.seen.net2) setHint(''); else setHint(N.phase==='up' ? `Hauling the net up with ${N.fish.length} of ${n.cap} fish.` : `Net at ${N.d.toFixed(0)} of ${N.max.toFixed(0)} ft with ${N.fish.length} of ${n.cap} fish. Click to haul it up.`); }
  else if(st==='dyn'){ const D = G.dyn; if(S.seen.dyn2) setHint(''); else setHint(D.phase==='boom' ? 'Collecting the catch as it floats up.' : `Fuse: ${Math.max(0, D.fuse).toFixed(1)} s. Scroll or press W/S to move it up or down (max ${Math.round(dynMaxDepth())} ft).`, D.phase!=='boom'); }
  else if(st==='charging') tipHint(G.chargeTool==='net' ? 'net' : 'cast', G.chargeTool==='net' ? 'Release to throw the net. It lands closer than a rod cast.' : 'Release to cast. More power casts farther.');
  else if(st==='sinking') tipHint('sink', 'Sinking. Click to stop at this depth, or scroll to adjust.');
  else if(st==='waiting') tipHint('wait', 'Scroll to raise or lower the lure. Hold to reel in. R pulls the line out.');
  else if(st==='bite') tipHint('bite', 'Bite! Click or press Space now!', true);
  else if(st==='reeling') tipHint('reel', 'Reel it all the way to the boat. Ease off when the gauge turns red.');
  else setHint('');
  gaugeEl.classList.toggle('on', st==='reeling');
  if(st==='reeling'){
    const t = clamp(G.reel.tension,0,100);
    gfill.style.height = `calc(${t}% - 4px * ${t/100})`;
    gfill.style.background = t<60 ? 'var(--good)' : t<85 ? 'var(--warn)' : 'var(--bad)';
    $('gDepth').textContent = `${G.lure.depth.toFixed(0)} ft deep`;
    $('gLine').textContent = `${(Math.hypot(G.lure.x-catchX(), G.lure.depth*FT)/FT).toFixed(0)} ft out`;
    $('slack').classList.toggle('on', G.reel.slack>.7 && Math.floor(time*4)%2===0);
  }
}
let lastToolKey = '';
function updateTools(){
  updateGunChip();
  const ti = toolInfo(G.tool);
  const key = [G.tool, ti.badge, ti.info].join('|'); if(key===lastToolKey) return; lastToolKey = key;
  const b = $('toolBtn'), im = b.querySelector('img');
  im.src = ICONS[G.tool]; im.className = isGun(G.tool) ? 'wide' : '';
  b.title = `${ti.name}: ${ti.info}. Click or press Q to switch tools.`; b.setAttribute('aria-label', b.title);
  $('toolBadge').textContent = ti.badge; $('toolBadge').hidden = ti.badge==='' || ti.badge===0;
}
let toastT=null;
function toast(msg){ msg = touchText(msg); const t=$('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('show'), 2800); }

/* ================== Dialogs ================== */
function openDlg(id){ const d=$(id); if(d.open) return; holding=false; T.keys={}; if(G.state==='charging'){ G.state='idle'; }
  document.querySelectorAll('dialog[open]').forEach(o=>{ if(o.id!=='catchDlg' && o.id!=='mapDlg') o.close(); });
  if(id==='invDlg') renderInv(); if(id==='shopDlg') renderShop(); if(id==='adminDlg') renderAdmin(); if(id==='wheelDlg') renderWheel();
  d.showModal(); }
function toggleDlg(id){ if($('catchDlg').open || $('mapDlg').open) return; const d=$(id); d.open ? d.close() : openDlg(id); }
document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click', ()=>b.closest('dialog').close()));
document.querySelectorAll('dialog').forEach(d=>d.addEventListener('click', e=>{ if(e.target===d && d.id!=='catchDlg' && d.id!=='mapDlg') d.close(); }));
async function popOut(){
  if(POPPED || !('documentPictureInPicture' in window)) return;
  try{
    saveWorld();
    const w = Math.round(Math.min(760, screen.availWidth*.45)), h = Math.round(w*9/16 + 40);
    const pip = await documentPictureInPicture.requestWindow({width:w, height:h});
    pipWin = pip; POPPED = true; holding = false; T.keys = {}; joyEnd();
    const d = pip.document; d.title = 'Driftwood Isles';
    const st = d.createElement('style'); st.textContent = 'html,body{margin:0;height:100%;background:#081222;overflow:hidden}iframe{border:0;width:100%;height:100%;display:block}';
    d.head.appendChild(st);
    const fr = d.createElement('iframe'); fr.src = location.href.split('#')[0].split('?')[0] + '?popout=1'; fr.allow = 'autoplay; fullscreen; vibrate';
    fr.addEventListener('load', () => fr.focus());
    d.body.appendChild(fr);
    $('poppedOv').hidden = false;
    if(AC && AC.state === 'running') AC.suspend();
    pip.addEventListener('pagehide', () => { location.reload(); });   // pick up the progress made in the pop-out
  }catch(e){ POPPED = false; pipWin = null; toast("Couldn't open the pop-out window."); }
}
if('documentPictureInPicture' in window && !POPOUT && window.top === window) $('btnPop').hidden = false;
$('btnPop').onclick = popOut;
$('popBack').onclick = () => { if(pipWin) pipWin.close(); else location.reload(); };
$('btnInv').onclick=()=>openDlg('invDlg'); $('btnAdmin').onclick=()=>openDlg('adminDlg'); $('btnSail').onclick=returnToSail;

// Map size
$('mapDlg').addEventListener('cancel', e=>e.preventDefault());
document.querySelectorAll('#mapDlg [data-size]').forEach(b => b.onclick = () => { $('mapDlg').close(); toast('Charting the waters…'); setTimeout(()=>newWorld(b.dataset.size), 60); });
function askMapSize(){ document.querySelectorAll('dialog[open]').forEach(o=>o.close()); $('mapDlg').showModal(); }

function fits(w){ return S.inv.length < boat().cap && invWeight() + w <= boat().maxW + 1e-9; }
function openCatch(){
  const c = G.landed, sp = c.sp;
  $('cImg').src = sp.iconURL; $('cImg').alt = sp.name;
  $('cName').textContent = sp.name;
  $('cRar').textContent = RARITIES[sp.rarity]; $('cRar').className = 'r'+sp.rarity;
  $('cW').textContent = c.w.toFixed(2)+' lb'; $('cV').textContent = fmt(c.value)+' coins'; $('cD').textContent = c.depth.toFixed(0)+' ft';
  $('cNew').hidden = !!S.caught[sp.id];
  const ok = fits(c.w), warn = $('cWarn');
  $('cKeep').disabled = !ok;
  if(!ok){ warn.hidden=false; warn.textContent = S.inv.length>=boat().cap ? `Your hold is full (${boat().cap} fish). Release this one, then sell your catch at the harbor.` : `Too heavy for your ${boat().name} (${invWeight().toFixed(1)} of ${boat().maxW} lb used). Release it, or sell your catch and upgrade your boat.`; }
  else warn.hidden=true;
  S.caught[sp.id] = (S.caught[sp.id]||0) + 1; save();
  holding=false; $('catchDlg').showModal();
  (ok ? $('cKeep') : $('cRelease')).focus();
}
$('catchDlg').addEventListener('cancel', e=>e.preventDefault());
$('cKeep').onclick = () => { const c=G.landed; if(!c||!fits(c.w)) return;
  S.inv.push({uid:Date.now().toString(36)+Math.random().toString(36).slice(2,6), sid:c.sp.id, name:c.sp.name, rarity:c.sp.rarity, w:c.w, value:c.value});
  save(); sfx('coin'); closeCatch(); toast(`${c.sp.name} added to your hold.`); };
$('cRelease').onclick = () => { const c=G.landed; closeCatch(); if(c){ G.relAnim = {t:0, dur:.7, sp:c.sp, sx:c.slot.x, sy:c.slot.y, tx:G.rig.tipX+18+rand(0,20), x:c.slot.x, y:c.slot.y, rot:0}; sfx('leap'); toast(`${c.sp.name} released.`); } };
function closeCatch(){ $('catchDlg').close(); G.landed=null; G.state='idle'; }

function renderInv(){
  const b=boat(), wt=invWeight(), body=$('invBody');
  const per = periodNow(), ico = per.id==='night' || per.id==='evening' ? MOON_SVG : per.id==='dawn' || per.id==='dusk' ? DUSK_SVG : SUN_SVG;
  let h = `<div class="invstat"><div class="chip" title="Coins">${COIN_SVG}<b>${fmt(S.coins)}</b> coins</div><div class="chip" title="Time of day"><span class="cico">${ico}</span><span class="lbl">${per.name}</span><span>${clockLabel(S.clock)}</span></div></div>`;
  h += `<div class="summary"><div><label>Fish: ${S.inv.length} of ${b.cap}</label><div class="bar"><i style="width:${Math.min(100,S.inv.length/b.cap*100)}%;background:${S.inv.length>=b.cap?'var(--bad)':'var(--good)'}"></i></div></div>
    <div><label>Weight: ${wt.toFixed(1)} of ${b.maxW} lb</label><div class="bar"><i style="width:${Math.min(100,wt/b.maxW*100)}%;background:${wt>=b.maxW*.95?'var(--bad)':'var(--good)'}"></i></div></div></div>`;
  h += equipmentRow();
  h += `<div class="toolbar"><span style="color:var(--bone-dim);font-size:12px">Hold value: <b style="color:var(--warn)">${fmt(S.inv.reduce((a,f)=>a+f.value,0))} coins</b>. Sell it at the harbor, the orange marker on your chart.</span></div>`;
  if(!S.inv.length) h += `<div class="empty">Your hold is empty.<br>Stop on open water, press Space and cast a line.</div>`;
  else h += `<div class="list">${S.inv.slice().reverse().map(f=>fishRow(f)).join('')}</div>`;
  h += `<h4>Fish log</h4><div class="dex">${RT.map(sp=>{ const n=S.caught[sp.id]||0; return `<div class="${n?'':'unk'}"><img src="${sp.iconURL}" alt=""><span class="${n?'r'+sp.rarity:''}">${n?esc(sp.name):'Not caught yet'}</span><br><span style="color:var(--bone-dim)">${n?`Caught ${n}`:`${Math.round(sp.dmin)} to ${Math.round(sp.dmax)} ft`}${sp.biomes?`<br>${sp.biomes.slice(0,2).map(b=>BIOMES[B[b]].name).join(', ')}${sp.biomes.length>2?` +${sp.biomes.length-2}`:''}`:''}${sp.time?`<br>${PERIOD_BY_ID[sp.time].name} only`:''}</span></div>`; }).join('')}</div>`;
  body.innerHTML = h;
}
function fishRow(f, sell){
  const icon = byId[f.sid]?.iconURL || GENERIC_ICON;
  return `<div class="fishrow"><img src="${icon}" alt=""><div class="meta"><strong>${esc(f.name)}</strong><span class="r${f.rarity}">${RARITIES[f.rarity]}</span> <span style="color:var(--bone-dim)">${f.w.toFixed(2)} lb</span></div><span class="price">${fmt(f.value)}</span>${sell?`<button class="btn sm" data-sell="${f.uid}">Sell</button>`:''}</div>`;
}
let shopTab='sell';
let restPick = null;
// Fade to black, move the clock, fade back in
function restUntil(id){
  const p = PERIOD_BY_ID[id], fade = $('sleepFade');
  $('shopDlg').close(); fade.querySelector('span').textContent = `Resting until ${p.name.toLowerCase()}...`; fade.classList.add('on'); sfx('sail');
  setTimeout(() => { S.clock = p.h*60; clockKey = ''; restPick = null; save(); }, 900);
  setTimeout(() => { fade.classList.remove('on'); toast(`You wake at ${clockLabel(p.h*60)}. It's ${p.name.toLowerCase()}.`); }, 1900);
}
function renderShop(tab){
  if(tab) shopTab=tab;
  $('shopCoins').textContent = fmt(S.coins)+' coins';
  document.querySelectorAll('#shopDlg .tab').forEach(t=>t.setAttribute('aria-selected', t.dataset.tab===shopTab));
  const body=$('shopBody'); let h='';
  if(shopTab==='sell'){
    const total=S.inv.reduce((a,f)=>a+f.value,0);
    h += `<div class="toolbar"><span style="font-size:13px">${S.inv.length} fish in your hold, worth <b style="color:var(--warn)">${fmt(total)} coins</b></span><button class="btn" id="sellAll" ${S.inv.length?'':'disabled'}>Sell all for ${fmt(total)}</button></div>`;
    h += S.inv.length ? `<div class="list">${S.inv.slice().reverse().map(f=>fishRow(f,true)).join('')}</div>` : `<div class="empty">Nothing to sell yet.<br>Sail out, catch something and bring it back here.</div>`;
  } else if(shopTab==='rest'){
    const cur = periodNow(); if(!restPick || restPick===cur.id) restPick = PERIODS[(PERIODS.indexOf(cur)+1) % PERIODS.length].id;
    const p = PERIOD_BY_ID[restPick], ico = restPick==='night' || restPick==='evening' ? MOON_SVG : restPick==='dawn' || restPick==='dusk' ? DUSK_SVG : SUN_SVG;
    h += `<div class="restbox"><p>It's <b style="color:var(--warn)">${cur.name.toLowerCase()}</b>, ${clockLabel(S.clock)}. Rest at the harbor to skip ahead. Some rare fish only come out at certain times of day.</p>
      <div class="restpick"><span class="cico big">${ico}</span><div><strong>${p.name}</strong><span>Starts at ${clockLabel(p.h*60)}</span></div></div>
      <div class="flexw" style="justify-content:center"><button class="btn ghost" id="restNext">Change time</button><button class="btn" id="restGo">Rest until ${p.name.toLowerCase()}</button></div></div>`;
  } else if(shopTab==='tackle'){
    h += tackleShop();
  } else if(shopTab==='weapons'){
    h += weaponShop();
  } else if(shopTab==='ammo'){
    h += ammoShop();
  } else {
    const cat = shopTab, list = cat==='rod'?RODS:cat==='bait'?BAITS:BOATS, cur = S[cat];
    h += `<div class="grid">${list.map((it,i)=>{
      const owned = S.owned[cat].includes(i), eq = cur===i;
      let stats='';
      if(cat==='rod') stats=`<li>Reaches <span>${it.depth} ft</span></li><li>Line strength <span>${it.str}x</span></li><li>Reel speed <span>${it.reel}x</span></li><li>Cast speed <span>${it.cast}x</span></li>`;
      if(cat==='bait') stats=`<li>Bite rate <span>${it.bite}x</span></li><li>Rare fish odds <span>+${Math.round(it.boost*100)}%</span> per tier</li><li>Sinks <span>${it.sink} ft/s</span></li>`;
      if(cat==='boat') stats=`<li>Holds <span>${it.cap} fish</span></li><li>Weight limit <span>${it.maxW} lb</span></li><li>Top speed <span>${it.speed}</span></li><li>Sight range <span>${it.vision} tiles</span></li>`;
      const tooSmall = cat==='boat' && (S.inv.length>it.cap || invWeight()>it.maxW);
      let act;
      if(eq) act=`<button class="btn ghost sm" disabled>Equipped</button>`;
      else if(owned) act=`<button class="btn ghost sm" data-equip="${i}" ${tooSmall?'disabled title="Sell some fish first: your catch won\'t fit"':''}>Equip</button>`;
      else act=`<button class="btn sm" data-buy="${i}" ${S.coins<it.price||tooSmall?'disabled':''}>Buy</button>`;
      const price = owned ? `<span style="color:var(--bone-dim);font-size:12px">Owned</span>` : `<span class="price">${fmt(it.price)} coins</span>`;
      return `<div class="card ${eq?'eq':''}"><h3>${esc(it.name)}</h3><p>${esc(it.desc)}</p><ul class="stats">${stats}</ul><div class="row">${price}${act}</div>${!owned&&S.coins<it.price?`<p>You need ${fmt(it.price-S.coins)} more coins.</p>`:''}</div>`;
    }).join('')}</div>`;
  }
  body.innerHTML=h;
  const rn=$('restNext'); if(rn) rn.onclick=()=>{ const cur = periodNow(); let i = PERIODS.findIndex(q => q.id===restPick); do { i = (i+1) % PERIODS.length; } while(PERIODS[i].id===cur.id); restPick = PERIODS[i].id; sfx('tick'); renderShop(); $('restNext').focus(); };
  const rg=$('restGo'); if(rg) rg.onclick=()=>restUntil(restPick);
  const sa=$('sellAll'); if(sa) sa.onclick=()=>{ const t=S.inv.reduce((a,f)=>a+f.value,0); S.coins+=t; S.inv=[]; save(); sfx('coin'); toast(`Sold your catch for ${fmt(t)} coins.`); renderShop(); };
  body.querySelectorAll('[data-sell]').forEach(b=>b.onclick=()=>{ const i=S.inv.findIndex(f=>f.uid===b.dataset.sell); if(i<0) return; const f=S.inv[i]; S.coins+=f.value; S.inv.splice(i,1); save(); sfx('coin'); toast(`Sold ${f.name} for ${fmt(f.value)} coins.`); renderShop(); });
  body.querySelectorAll('[data-buy]').forEach(b=>b.onclick=()=>{ const cat=shopTab, i=+b.dataset.buy, list=cat==='rod'?RODS:cat==='bait'?BAITS:BOATS, it=list[i]; if(S.coins<it.price) return; S.coins-=it.price; S.owned[cat].push(i); S[cat]=i; save(); sfx('coin'); toast(`Bought and equipped the ${it.name}.`); renderShop(); });
  body.querySelectorAll('[data-equip]').forEach(b=>b.onclick=()=>{ const cat=shopTab, i=+b.dataset.equip; S[cat]=i; save(); toast('Equipped.'); renderShop(); });
  body.querySelectorAll('[data-tk]').forEach(b=>b.onclick=()=>buyTackle(b.dataset.tk));
}
const pips = (n, of) => `<span class="pips" aria-label="Level ${n} of ${of}">${Array.from({length:of},(_,i)=>`<i class="${i<n?'on':''}"></i>`).join('')}</span>`;
function tackleShop(){
  const cards = [];
  // Net: buy, then two upgrades
  const cur = S.net, nx = NETS[cur+1];
  const netStats = n => `<li>Reaches <span>${n.depth} ft</span></li><li>Holds <span>${n.cap} fish</span></li><li>Speed <span>${n.speed}x</span></li>`;
  cards.push(`<div class="card ${cur>=0?'eq':''}"><div class="row" style="margin:0"><img class="cardicon" src="${ICONS.net}" alt="">${pips(cur+1, NETS.length)}</div>
    <h3>${cur>=0 ? NETS[cur].name : 'Fishing net'}</h3><p>${cur>=0 ? esc(NETS[cur].desc) : 'Catches several fish at once, but only in shallow water. Rare fish often tear free.'}</p>
    ${cur>=0 ? `<ul class="stats">${netStats(NETS[cur])}</ul>` : ''}
    ${nx ? `<p style="color:var(--bone)">${cur>=0 ? 'Upgrade to' : 'Buy the'} ${nx.name}: ${nx.depth} ft, ${nx.cap} fish, ${nx.speed}x speed.</p>
      <div class="row"><span class="price">${fmt(nx.price)} coins</span><button class="btn sm" data-tk="net" ${S.coins<nx.price?'disabled':''}>${cur>=0?'Upgrade':'Buy'}</button></div>`
    : `<div class="row"><span style="color:var(--bone-dim);font-size:12px">Fully upgraded</span></div>`}</div>`);
  // Boat light
  { const lv = S.light, nl = LIGHTS[lv+1];
    cards.push(`<div class="card ${lv>=0?'eq':''}"><div class="row" style="margin:0"><img class="cardicon" src="${ICONS.light}" alt="">${pips(lv+1, LIGHTS.length)}</div>
      <h3>${lv>=0 ? LIGHTS[lv].name : 'Boat light'}</h3><p>${lv>=0 ? esc(LIGHTS[lv].desc) : 'Lights up the water under your boat so you can see fish in the dark, and throws a beam ahead of the bow when you sail at night.'}</p>
      ${lv>=0 ? `<ul class="stats"><li>Lights the water to <span>${LIGHTS[lv].reach} ft</span></li></ul>` : ''}
      ${nl ? `<p style="color:var(--bone)">${lv>=0 ? 'Upgrade to' : 'Buy the'} ${nl.name}: lights to ${nl.reach} ft.</p><div class="row"><span class="price">${fmt(nl.price)} coins</span><button class="btn sm" data-tk="light" ${S.coins<nl.price?'disabled':''}>${lv>=0?'Upgrade':'Buy'}</button></div>`
        : `<div class="row"><span style="color:var(--bone-dim);font-size:12px">Fully upgraded</span></div>`}</div>`); }
  // Dynamite sticks
  const cap = DYN.bag[S.dyn.bag].v, room = cap - S.dyn.count, fillCost = room*DYN.stick;
  cards.push(`<div class="card"><div class="row" style="margin:0"><img class="cardicon" src="${ICONS.dyn}" alt=""><span class="price">${fmt(DYN.stick)} coins each</span></div>
    <h3>Dynamite</h3><p>Throw it, steer it up or down while the fuse burns, and every fish in the blast floats up into your boat. Each stick is used up.</p>
    <ul class="stats"><li>Carrying <span>${S.dyn.count} of ${cap}</span></li><li>Reaches down to <span>${Math.round(dynBoomDepth())} ft</span></li><li>Blast radius <span>${Math.round(DYN.radius[S.dyn.radius].v/FT)} ft</span></li></ul>
    <div class="row"><button class="btn sm" data-tk="stick1" ${room<=0||S.coins<DYN.stick?'disabled':''}>Buy 1</button><button class="btn ghost sm" data-tk="stickfill" ${room<=0||S.coins<fillCost?'disabled':''}>${room>0 ? `Fill up (${room}) for ${fmt(fillCost)}` : 'Satchel full'}</button></div></div>`);
  // Dynamite upgrades
  const ups = [
    ['fuse','Longer fuse', ICONS.fuse, l => `${DYN.fuse[l].v} s fuse, reaches ${Math.round(dynBoomDepth(l))} ft`],
    ['radius','Bigger blast', ICONS.blast, l => `${Math.round(DYN.radius[l].v/FT)} ft blast radius`],
    ['bag','Bigger satchel', ICONS.bag, l => `Carry ${DYN.bag[l].v} sticks`],
  ];
  for(const [k, name, icon, desc] of ups){
    const lv = S.dyn[k], next = DYN[k][lv+1];
    cards.push(`<div class="card"><div class="row" style="margin:0"><img class="cardicon" src="${icon}" alt="">${pips(lv+1, DYN[k].length)}</div>
      <h3>${name}</h3><p>Now: ${desc(lv)}.</p>
      ${next ? `<p style="color:var(--bone)">Next: ${desc(lv+1)}.</p><div class="row"><span class="price">${fmt(next.price)} coins</span><button class="btn sm" data-tk="${k}" ${S.coins<next.price?'disabled':''}>Upgrade</button></div>`
             : `<div class="row"><span style="color:var(--bone-dim);font-size:12px">Fully upgraded</span></div>`}</div>`);
  }
  return `<div class="grid">${cards.join('')}</div>`;
}
function buyTackle(k){
  const pay = c => { if(S.coins < c) return false; S.coins -= c; return true; };
  if(k==='light'){ const nl = LIGHTS[S.light+1]; if(!nl || !pay(nl.price)) return; S.light++; toast(S.light ? `Upgraded to the ${nl.name}.` : `You fitted a ${nl.name}. It lights the water when you fish, and the way ahead when you sail at night.`); }
  else if(k==='net'){ const nx = NETS[S.net+1]; if(!nx || !pay(nx.price)) return; S.net++; toast(`You now have the ${nx.name}. Press 2 while fishing to use it.`); }
  else if(k==='stick1' || k==='stickfill'){
    const cap = DYN.bag[S.dyn.bag].v, n = k==='stick1' ? 1 : cap - S.dyn.count; if(n<=0 || !pay(n*DYN.stick)) return;
    S.dyn.count += n; toast(`Bought ${n} stick${n>1?'s':''} of dynamite. Press 3 while fishing to throw.`);
  }
  else if(k.startsWith('w:')){ const id = k.slice(2), w = WEAPONS[id], st = WS(id), nx = w.tiers[st.lvl+1]; if(!nx || !pay(nx.price)) return; const first = st.lvl < 0; st.lvl++; if(first) st.mag = magOf(id); toast(first ? `You bought the ${nx.name}. It comes loaded. Pick it from the tool wheel while fishing.` : `Upgraded to the ${nx.name}.`); }
  else if(k.startsWith('b1:') || k.startsWith('b2:')){ const id = k.slice(3), w = WEAPONS[id], st = WS(id), n = Math.min(k[1]==='1' ? w.packs2[0] : w.packs2[1], w.ammo2Max - st.ammo2); if(n<=0 || !pay(n*w.ammo2Price)) return; st.ammo2 += n; toast(`Bought ${n} ${w.ammo2Name.toLowerCase()}.`); }
  else if(k.startsWith('a1:') || k.startsWith('a2:')){ const id = k.slice(3), w = WEAPONS[id], st = WS(id), n = Math.min(k[1]==='1' ? w.packs[0] : w.packs[1], w.ammoMax - st.ammo); if(n<=0 || !pay(n*w.ammoPrice)) return; st.ammo += n; toast(`Bought ${n} ${w.ammoName.toLowerCase()}.`); }
  else { const next = DYN[k][S.dyn[k]+1]; if(!next || !pay(next.price)) return; S.dyn[k]++; toast('Upgraded.'); }
  save(); sfx('coin'); renderShop();
}
document.querySelectorAll('#shopDlg .tab').forEach(t=>t.onclick=()=>renderShop(t.dataset.tab));

/* ================== Admin ================== */
function syncTimeSlider(){ $('admTime').value = Math.round(S.clock); $('oTime').textContent = `${clockLabel(S.clock)}, ${periodNow().name.toLowerCase()}`; }
$('admTime').addEventListener('input', () => { S.clock = +$('admTime').value; clockKey = ''; $('oTime').textContent = `${clockLabel(S.clock)}, ${periodNow().name.toLowerCase()}`; });
$('admTime').addEventListener('change', () => save());
function renderAdmin(){ $('optSound').checked=S.sound; $('optShake').checked=S.shake; syncTimeSlider(); renderSaveStatus(); }
$('saveFile').onclick = saveToFile;
$('loadFile').onclick = () => $('loadInput').click();
$('loadInput').onchange = e => { const f = e.target.files[0]; if(f) readSaveFile(f); e.target.value=''; };
$('confirmLoad').onclick = applyPendingLoad;
$('reconnectFile').onclick = reconnectFile;
restoreFileHandle();
setInterval(() => { if(G.mode==='travel' && WORLD) saveWorld(); else save(); }, 20000);
$('optSound').onchange=e=>{ S.sound=e.target.checked; save(); };
$('optShake').onchange=e=>{ S.shake=e.target.checked; save(); };
$('admCoins').onclick=()=>{ S.coins+=1000; save(); sfx('coin'); toast('Added 1,000 coins.'); };
$('admSpawn').onclick=()=>{ if(G.mode!=='fish'){ toast('Start fishing first, then spawn a fish.'); return; } const f=spawnFish(null,true); toast(`Released a ${f.def.name} at ${f.depth.toFixed(0)} ft.`); };
$('admSummon').onclick=()=>{ if(G.mode!=='fish'){ toast('Start fishing first, then summon it.'); return; } if(M){ toast('The Saltwight is already here.'); return; } document.getElementById('adminDlg').close(); spawnSaltwight(); M.raidT = 4; };
$('admUnlock').onclick=()=>{ S.owned={rod:RODS.map((_,i)=>i), bait:BAITS.map((_,i)=>i), boat:BOATS.map((_,i)=>i)}; S.net=NETS.length-1; S.light=LIGHTS.length-1; S.dyn={count:DYN.bag[3].v, fuse:3, radius:3, bag:3}; for(const id of WEAPON_IDS){ const w = WEAPONS[id]; S.weapons[id] = Object.assign(S.weapons[id] || {}, {lvl:w.tiers.length-1, ammo:w.ammoMax, mag:w.tiers[w.tiers.length-1].shots || w.mag}); if(w.ammo2Max) S.weapons[id].ammo2 = w.ammo2Max; } save(); toast('All gear unlocked. Equip it at the harbor shop.'); };
$('admReveal').onclick=()=>{ if(!WORLD) return; WORLD.fog.fill(255); for(let i=0;i<WORLD.fog.length;i++) WORLD.fogImg.data[i*4+3]=0; WORLD.spots.forEach(s=>s.found=true); WORLD.fogDirty=true; saveWorld(); toast('Whole chart revealed.'); };
$('admNewMap').onclick=e=>{ const b=e.currentTarget;
  if(b.dataset.armed!=='1'){ b.dataset.armed='1'; b.textContent='Click again for a new map'; setTimeout(()=>{ b.dataset.armed=''; b.textContent='Chart a new map'; }, 3500); return; }
  b.dataset.armed=''; b.textContent='Chart a new map';
  G.mode='travel'; G.state='idle'; document.body.dataset.mode='travel'; S.world=null; WORLD=null; save(); askMapSize();
};
$('admReset').onclick=e=>{ const b=e.currentTarget;
  if(b.dataset.armed!=='1'){ b.dataset.armed='1'; b.textContent='Click again to erase everything'; setTimeout(()=>{ b.dataset.armed=''; b.textContent='Erase all progress'; }, 3500); return; }
  try{ localStorage.removeItem(SAVE_KEY); }catch(x){}
  S=defaults(); rebuildRegistry(); WORLD=null; fishes=[];
  G.mode='travel'; G.state='idle'; G.hooked=null; G.bite.fish=null; document.body.dataset.mode='travel';
  b.dataset.armed=''; b.textContent='Erase all progress';
  askMapSize();
};

/* ================== Layout & loop ================== */
const stage=$('stage');
function fit(){
  const vw = window.visualViewport ? visualViewport.width : innerWidth, vh = window.visualViewport ? visualViewport.height : innerHeight;
  const portrait = vh > vw*.8;
  document.body.classList.toggle('portrait', portrait);
  if(portrait){
    // full-screen stage; the scene spans the width and the HUD uses the space above and below it
    stage.style.width = vw+'px'; stage.style.height = vh+'px';
    const cw = Math.floor(vw), ch = Math.floor(vw*H/W);
    const top = Math.round((vh-ch)/2);
    cvs.style.width = cw+'px'; cvs.style.height = ch+'px'; cvs.style.top = top+'px';
    fxc.style.width = cw+'px'; fxc.style.height = ch+'px'; fxc.style.top = top+'px';
    stage.style.setProperty('--cv-top', top+'px'); stage.style.setProperty('--cv-bot', (top+ch)+'px');
  } else {
    const s = Math.min(vw/W, vh/H);
    stage.style.width = Math.floor(W*s)+'px'; stage.style.height = Math.floor(H*s)+'px';
    cvs.style.width = ''; cvs.style.height = ''; cvs.style.top = '';
    fxc.style.width = ''; fxc.style.height = ''; fxc.style.top = '';
  }
}
addEventListener('resize', fit); addEventListener('orientationchange', () => setTimeout(fit, 150));
if(window.visualViewport) visualViewport.addEventListener('resize', fit);
fit();
// no double-tap or pinch zoom anywhere in the game
document.addEventListener('dblclick', e => e.preventDefault(), {passive:false});
['gesturestart','gesturechange','gestureend'].forEach(ev => document.addEventListener(ev, e => e.preventDefault(), {passive:false}));
let lastTouchEnd = 0;
document.addEventListener('touchend', e => {
  // touch-action: manipulation already blocks double-tap zoom; this backs it up on the scene itself,
  // and never on buttons or form fields so quick taps on different controls always register
  const now = Date.now();
  if(now - lastTouchEnd < 320 && !e.target.closest('button, a, input, select, textarea, label, dialog')) e.preventDefault();
  lastTouchEnd = now;
}, {passive:false});
document.addEventListener('touchmove', e => { if(e.touches.length > 1) e.preventDefault(); }, {passive:false});
if(!POPOUT && IS_TOUCH && document.body.classList.contains('portrait') && !S.seen.rotate) setTimeout(() => { toast('Tip: turn your phone sideways for a bigger view.'); markSeen('rotate'); }, 1400);
/* ================== Islands: going ashore ==================
   Stop the boat next to an island and go ashore. The island becomes a side-scrolling walk:
   you start on the beach where you landed, each screen-wide panel takes you further inland,
   and the last panel is the beach on the far side. The walk follows the island on the chart:
   its length comes from how wide the island is, and its sand, grass, forest and rock come from
   the tiles along your path. The look comes from the biome around it. */
const WL = 160;                        // sea level on the beaches (screen y)
const HERO = {x:0, y:0, vx:0, vy:0, face:1, ground:true, coyote:0, jbuf:0, walkT:0, jumpHeld:false};
let ISL = null, camX = 0, LB = [], LO = [], LP = [];   // island, land bullets, land orbs (delayed cells), land particles
const ISL_THEMES = {
  tropical:{sand:['#e6d199','#d4bc82'], top:['#77b25c','#679f4f'], dirt:['#8a6a44','#6e5236','#553e28'], rock:['#8d8a7c','#6f6c60','#5a574c'], far:['#7aa8a0','#62948a'], sea:'#2f9ab4'},
  mangrove:{sand:['#b8a878','#9a8a5e'], top:['#4a7a3a','#3e6a32'], dirt:['#5a4a30','#463a24','#352a1a'], rock:['#6e6a58','#58544a','#45423a'], far:['#5a8a72','#4a7860'], sea:'#3f7a62'},
  volcanic:{sand:['#5a5050','#4a4244'], top:['#4e4448','#3e363a'], dirt:['#2e2629','#241e21','#1a1517'], rock:['#3a3438','#2c272b','#1e1a1d'], far:['#6a6070','#58506a'], sea:'#4a5a70'},
  frozen:{sand:['#eef6fa','#d6e6ee'], top:['#f4f9fc','#e0ecf2'], dirt:['#7890a0','#5e7484','#4a5e6c'], rock:['#8a9aa6','#6e7e8a','#56646e'], far:['#8eaec2','#7896ac'], sea:'#6aa8c4'},
  rocky:{sand:['#b8b0a0','#a0988a'], top:['#7a8a6a','#6a7a5a'], dirt:['#6a6458','#565046','#433e36'], rock:['#7e8278','#666a62','#50544c'], far:['#6a7a88','#586876'], sea:'#1f5a8a'},
};
const themeOf = b => b===B.frozen ? 'frozen' : b===B.volcanic ? 'volcanic' : b===B.mangrove ? 'mangrove' : b===B.deep || b===B.abyss ? 'rocky' : 'tropical';

// the nearest land tile within reach of the boat
function shoreTile(){
  if(!WORLD) return null;
  const N = WORLD.N, bx = T.x/TS, by = T.y/TS; let best = null, bd = 1e9;
  for(let y=Math.floor(by)-3; y<=Math.floor(by)+3; y++) for(let x=Math.floor(bx)-3; x<=Math.floor(bx)+3; x++){
    if(x<0||y<0||x>=N||y>=N) continue; const i = y*N+x; if(!WORLD.land[i]) continue;
    const d = Math.hypot(x+.5-bx, y+.5-by); if(d < bd){ bd = d; best = i; }
  }
  return bd <= 3.3 ? best : null;
}
const nearShore = () => stopped() && shoreTile() != null;
function tryGoAshore(){
  if(G.trans || G.mode!=='travel') return;
  if(!stopped()){ toast('Slow to a stop before you go ashore.'); return; }
  const i0 = shoreTile(); if(i0 == null) return;
  G.trans = {t:0, dur:1.1, to:'land', isl:readIsland(i0), switched:false};
  sfx('anchor');
}
// Flood-fill the island and read its tiles along a line from the landing spot across it
function readIsland(i0){
  const w = WORLD, N = w.N, seen = new Uint8Array(N*N), q = [i0]; seen[i0] = 1; let sx = 0, sy = 0, minI = i0;
  for(let h=0; h<q.length && q.length < 40000; h++){
    const i = q[h], x = i%N, y = (i/N)|0; sx += x; sy += y; if(i < minI) minI = i;
    for(const [nx,ny] of [[x+1,y],[x-1,y],[x,y+1],[x,y-1]]){ if(nx<0||ny<0||nx>=N||ny>=N) continue; const n = ny*N+nx; if(w.land[n] && !seen[n]){ seen[n] = 1; q.push(n); } }
  }
  const x0 = i0%N, y0 = (i0/N)|0, cx = sx/q.length, cy = sy/q.length;
  let dx = cx - x0, dy = cy - y0, L = Math.hypot(dx, dy);
  if(L < .8){ dx = Math.cos(T.ang); dy = Math.sin(T.ang); L = 1; }
  dx /= L; dy /= L;
  const prof = [];
  for(let s=0; s<500; s+=.5){ const x = Math.floor(x0+.5+dx*s), y = Math.floor(y0+.5+dy*s); if(x<0||y<0||x>=N||y>=N) break; const i = y*N+x; if(!w.land[i]){ if(prof.length > 1) break; continue; } prof.push(w.land[i]); }
  // the biome of the water around the island sets its look
  const cnt = {}; for(let k=0; k<q.length; k+=Math.max(1, q.length>>8)){ const i = q[k], x = i%N, y = (i/N)|0; for(const [nx,ny] of [[x+2,y],[x-2,y],[x,y+2],[x,y-2]]){ if(nx<0||ny<0||nx>=N||ny>=N) continue; const n = ny*N+nx; if(!w.land[n]) cnt[w.biome[n]] = (cnt[w.biome[n]]||0) + 1; } }
  let bio = B.shallows, bc = -1; for(const k in cnt) if(cnt[k] > bc){ bc = cnt[k]; bio = +k; }
  if(w.cold[i0]) bio = B.frozen;
  const tiles = prof.length/2, panels = clamp(Math.round(tiles/2.6), 2, 10);
  return {prof, panels, bio, theme:themeOf(bio), seed:(w.seed ^ Math.imul(minI+1, 2654435761)) >>> 0, size:q.length, home:Math.hypot(x0 - N/2, y0 - N/2) < 12};
}

/* ----- building the walk ----- */
const LEVEL_Y = {1:150, 2:138, 3:128, 4:110};
function buildIsland(info){
  const R0 = mulberry32(info.seed), R = (a,b) => a + R0()*(b-a), TH = ISL_THEMES[info.theme];
  const NW = info.panels*W, hgt = new Float32Array(NW), lvl = new Uint8Array(NW), prof = info.prof.length ? info.prof : [1,2,1];
  // raw height from the profile, then smoothed, plus some rolling noise
  const raw = new Float32Array(NW);
  for(let x=0;x<NW;x++){ const u = x/(NW-1), p = prof[Math.min(prof.length-1, Math.floor(u*prof.length))]; lvl[x] = p; raw[x] = LEVEL_Y[p] ?? 140; }
  const ph = [R(0,6), R(0,6), R(0,6)], rad = 28;
  let acc = 0; const pre = new Float32Array(NW+1); for(let x=0;x<NW;x++){ acc += raw[x]; pre[x+1] = acc; }
  for(let x=0;x<NW;x++){ const a = Math.max(0, x-rad), b = Math.min(NW, x+rad+1); let h = (pre[b]-pre[a])/(b-a);
    h += Math.sin(x*.021 + ph[0])*4 + Math.sin(x*.057 + ph[1])*2 + (lvl[x] >= 3 ? Math.sin(x*.013 + ph[2])*6 : 0);
    const ss = t => t<=0 ? 0 : t>=1 ? 1 : t*t*(3-2*t), eL = ss((x-14)/56), eR = ss((NW-1-x-14)/56), e = Math.min(eL, eR);
    hgt[x] = e < 1 ? lerp(WL + 14, h, e) : h;
    if(x < 90 || x > NW-90) lvl[x] = 1;
  }
  // one-way ledges to jump on, away from the beaches
  const plats = [];
  for(let p=1; p<info.panels-1; p++){ const n = R0() < .55 ? 2 : 1; for(let k=0;k<n;k++){ const w = Math.round(R(30, 58)), x = Math.round(p*W + R(30, W-30-w)), g = Math.min(hgt[x], hgt[x+w-1], hgt[x+(w>>1)]); plats.push({x, w, y:Math.round(g - R(20, 33))}); } }
  // the terrain canvas: ground, back decorations and ledges are drawn once
  const [terrC, g] = mk(NW, H), [frontC, fg] = mk(NW, H);
  const put = (gg, x, y, c) => { gg.fillStyle = c; gg.fillRect(Math.round(x), Math.round(y), 1, 1); };
  const rect = (gg, x, y, w, h, c) => { gg.fillStyle = c; gg.fillRect(Math.round(x), Math.round(y), w, h); };
  const deco = [], glows = [];
  for(let x=0;x<NW;x++){
    const top = Math.round(hgt[x]), L = lvl[x], sand = L===1, hh = hash2(x, info.seed & 1023);
    const surf = sand ? TH.sand : L===4 ? TH.rock : TH.top;
    rect(g, x, top, 1, 1, surf[hh%5===0 ? 1 : 0]); rect(g, x, top+1, 1, 1, surf[1]);
    for(let y=top+2; y<H; y++){ const d = y-top, c = sand ? (d < (info.theme==='frozen' ? 4 : 9) ? TH.sand[1] : TH.dirt[d < 20 ? 0 : 1]) : L===4 ? TH.rock[d < 14 ? 1 : 2] : TH.dirt[d < 8 ? 0 : d < 22 ? 1 : 2]; rect(g, x, y, 1, 1, (hash2(x, y) % 23 === 0) ? shade(c, .12) : c); }
    if(info.theme==='volcanic' && hash2(x, 77) % 41 === 0 && !sand) rect(g, x, top+2, 1, 3 + hash2(x,5)%5, '#ff6a2a');
  }
  // ledges
  for(const p of plats){
    const c = info.theme==='frozen' ? ['#e8f6fa','#a8d0e0','#8ab4c8'] : info.theme==='volcanic' ? ['#4a3e42','#2e262a','#1e181b'] : lvl[p.x] >= 3 ? ['#8a6a44','#6a4e30','#4e3820'] : ['#9a968a','#7a766a','#5a574c'];
    rect(g, p.x, p.y, p.w, 2, c[0]); rect(g, p.x, p.y+2, p.w, 3, c[1]); rect(g, p.x+2, p.y+5, p.w-4, 2, c[2]);
    if(info.theme==='frozen') for(let i=3;i<p.w-2;i+=4) rect(g, p.x+i, p.y+7, 1, 1 + hash2(i, p.x)%3, '#cfeaf4');
    if(lvl[p.x] >= 3 && info.theme!=='frozen' && info.theme!=='volcanic') for(let i=0;i<p.w;i+=6) rect(g, p.x+i, p.y+1, 1, 3, '#5a4028');
  }
  // trees, rocks and plants, chosen by the ground they stand on
  const tree = (x, base, kind, s) => {
    if(kind==='palm'){ const h = 24 + s*10, lean = R(-.25, .25); let tx = x;
      for(let i=0;i<h;i++){ tx = x + lean*i*.6 + Math.sin(i*.12)*1.2; rect(g, tx, base-i, 2, 1, i%4===0 ? '#8a6a3a' : '#a8844a'); }
      for(let k=0;k<6;k++){ const an = -Math.PI/2 + (k-2.5)*.55, L = 12 + R(0,5); for(let i=0;i<L;i++){ const fx = tx+1 + Math.cos(an)*i, fy = base-h + Math.sin(an)*i*.6 + i*i*.025; rect(g, fx, fy, 1, 1, i%3===0 ? '#4f8a3a' : '#5ea844'); rect(g, fx, fy+1, 1, 1, '#3e7030'); } }
      rect(g, tx, base-h+1, 2, 2, '#6a4a2a'); }
    else if(kind==='broad' || kind==='mangrove'){ const h = 14 + s*10, r = 8 + s*5;
      rect(g, x, base-h, 3, h, '#6a4a2e'); rect(g, x+2, base-h, 1, h, '#4e3620');
      if(kind==='mangrove') for(let k=-2;k<=2;k++) for(let i=0;i<7;i++){ rect(g, x+1 + k*i*.9, base - 7 + i, 1, 1, '#5a4632'); }
      const cols = kind==='mangrove' ? ['#2a5030','#356238','#3f7040'] : ['#3f7a46','#4e8f50','#5ea85a'];
      for(const [ox,oy,rr,ci] of [[-r*.6,-h-r*.2,r*.8,0],[r*.6,-h-r*.1,r*.75,0],[0,-h-r*.6,r,1],[-r*.2,-h-r*.9,r*.6,2]]) for(let yy=-rr; yy<=rr; yy++){ const ww = Math.round(Math.sqrt(rr*rr-yy*yy)); rect(g, x+1+ox-ww, base+oy+yy, ww*2, 1, cols[ci]); } }
    else if(kind==='pine'){ const h = 20 + s*14;
      rect(g, x, base-6, 2, 6, '#5a4030');
      for(let t=0;t<4;t++){ const ty = base - 6 - t*(h/5), w = (4-t)*3.5 + 3; for(let i=0;i<h/4;i++){ const ww = w*(1 - i/(h/4)); rect(g, x+1-ww, ty-i, ww*2, 1, i===0 ? '#e8f4f8' : '#2e5a48'); if(i%3===0) rect(g, x+1-ww, ty-i, 2, 1, '#f2f8fb'); } } }
    else if(kind==='dead'){ const h = 16 + s*12;
      rect(g, x, base-h, 2, h, '#2a2224');
      for(let k=0;k<4;k++){ const by = base - h*.4 - k*h*.15, dir = k%2 ? 1 : -1; for(let i=0;i<6+k;i++) rect(g, x + dir*i, by - i*.6, 1, 1, '#2a2224'); } }
  };
  for(let x=24; x<NW-24; x += Math.round(R(10, 30))){
    const L = lvl[x], base = Math.round(hgt[x]) + 1, s = R0();
    if(base > WL - 1) continue;           // under water
    const roll = R0(), th = info.theme;
    if(L===1){
      if(th==='tropical' && roll < .35) tree(x, base, 'palm', s);
      else if(th==='frozen' && roll < .28) tree(x, base, 'pine', s*.6);
      else if(th==='mangrove' && roll < .45) tree(x, base, 'mangrove', s);
      else if(roll < .6){ const k = Math.floor(R(0,3)); if(th==='frozen') rect(g, x, base-3, 5, 3, '#cfeaf4'); else if(th==='volcanic') { rect(g, x, base-2, 4, 2, '#2a2428'); } else if(k===0){ rect(g, x, base-1, 2, 1, '#f2e6d8'); rect(g, x+1, base-2, 1, 1, '#e8b8a8'); } else if(k===1){ rect(g, x, base-2, 12, 2, '#9a7a52'); rect(g, x, base-2, 12, 1, '#b8946a'); } else for(let i=0;i<3;i++) rect(fg, x+i*2, base-3-(i%2), 1, 3, '#a8a050'); }
    } else if(L===2 || L===3){
      const treeK = th==='frozen' ? 'pine' : th==='volcanic' ? 'dead' : th==='mangrove' ? 'mangrove' : (th==='rocky' ? 'pine' : 'broad');
      if(roll < (L===3 ? .62 : .32)) tree(x, base, treeK, s);
      else if(roll < .75){ const c = th==='frozen' ? '#dfeef4' : th==='volcanic' ? '#3a3236' : '#3e7a40'; for(let yy=-4;yy<=0;yy++){ const ww = Math.round(Math.sqrt(16-yy*yy)*1.3); rect(g, x-ww, base+yy, ww*2, 1, c); } if(th==='tropical' && R0()<.6){ rect(g, x-2, base-3, 1, 1, '#ff8ab8'); rect(g, x+2, base-2, 1, 1, '#ffd25e'); } }
      if(th!=='volcanic' && th!=='frozen') for(let i=0;i<4;i++) rect(fg, x+6+i*2, base-2-((i+x)%3), 1, 2 + (i%2), th==='mangrove' ? '#3a6a30' : '#5aa84a');
    } else {
      if(roll < .45){ const r = 4 + Math.round(s*5); for(let yy=-r; yy<=0; yy++){ const ww = Math.round(Math.sqrt(r*r-yy*yy)*1.3); rect(g, x-ww, base+yy, ww*2, 1, yy < -r*.5 ? TH.rock[0] : TH.rock[1]); } }
      else if(th==='volcanic' && roll < .7){ const w = 10 + Math.round(s*10); rect(g, x, base-1, w, 3, '#ff7a2a'); rect(g, x+1, base-1, w-2, 1, '#ffd27a'); glows.push({x:x + w/2, y:base, r:20 + w}); }
      else if(th==='frozen' && roll < .7) tree(x, base, 'pine', s);
    }
  }
  // far ridge for parallax: low near the beaches (the sea shows), higher inland
  const BW = W + Math.ceil(NW*.5), [backC, bg] = mk(BW, H);
  for(let x=0;x<BW;x++){ const u = clamp((x - W*.25)/(BW - W*.5), 0, 1), inland = Math.sin(Math.PI*u);
    const h1 = 112 - inland*22 + Math.sin(x*.03 + ph[0])*4 + Math.sin(x*.011)*5, h2 = 119 - inland*13 + Math.sin(x*.05 + ph[1])*3;
    rect(bg, x, h1, 1, H, TH.far[0]); rect(bg, x, h2, 1, H, TH.far[1]); }
  // things that move
  const crabs = info.theme==='frozen' || info.theme==='volcanic' ? [] : [{x:R(70,140), dir:1, minX:60, maxX:150}, {x:NW - R(70,140), dir:-1, minX:NW-150, maxX:NW-60}].map(c => ({...c, alive:true, t:R(0,3)}));
  const flies = Array.from({length:22}, () => ({x:R(0,NW), y:R(70,140), ph:R(0,6)}));
  return {...info, NW, hgt, lvl, plats, terrC, frontC, backC, glows, crabs, flies, TH};
}
const groundAt = x => { if(!ISL) return H; const i = clamp(Math.round(x), 0, ISL.NW-1); return ISL.hgt[i]; };
function enterIsland(info){
  ISL = buildIsland(info);
  HERO.x = 58; HERO.y = groundAt(58); HERO.vx = HERO.vy = 0; HERO.face = 1; HERO.ground = true; camX = 0;
  LB = []; LO = []; LP = []; G.bolts = []; G.orbs = []; fishes = []; M = null; G.state = 'idle';
  if(!isGun(G.tool)){ const g = WEAPON_IDS.find(id => WS(id).lvl >= 0); if(g) G.tool = g; }
  markSeen('ashore');
  toast(info.home ? 'You walk onto your home island.' : `You come ashore. ${info.panels} stretches to the far beach.`);
}

/* ----- update ----- */
function heroJump(){ HERO.jbuf = .14; }
function updateLand(dt){
  const H0 = HERO, k = T.keys;
  let dir = (k.right ? 1 : 0) - (k.left ? 1 : 0);
  if(T.joy){ const m = T.joy.dx/JOY_R; dir = Math.abs(m) > .2 ? clamp(m*1.3, -1, 1) : 0; if(T.joy.dy < -JOY_R*.55 && !T.joy.jumped){ T.joy.jumped = true; heroJump(); } if(T.joy.dy > -JOY_R*.3) T.joy.jumped = false; }
  if(G.trans || anyDialog()) dir = 0;
  const speed = 72;
  H0.vx += (dir*speed - H0.vx)*Math.min(1, dt*(H0.ground ? 14 : 6));
  H0.vy = Math.min(420, H0.vy + 600*dt);
  H0.coyote -= dt; H0.jbuf -= dt;
  if(H0.ground) H0.coyote = .1;
  if(H0.jbuf > 0 && H0.coyote > 0){ H0.vy = -212; H0.coyote = 0; H0.jbuf = 0; H0.ground = false; sfx('jump'); }
  if(!H0.jumpHeld && H0.vy < -90) H0.vy *= Math.pow(.02, dt);   // let go early for a short hop
  // walk: step up gentle slopes, stop at cliffs and the sea
  let nx = clamp(H0.x + H0.vx*dt, 10, ISL.NW - 10);
  const gN = groundAt(nx);
  if(H0.ground && gN < H0.y - 7 && !onPlat(H0)) nx = H0.x;
  if(gN > WL + 3 && nx < H0.x && nx < ISL.NW/2) nx = H0.x;   // the sea at the near beach (the boat is there)
  if(gN > WL + 3 && nx > H0.x && nx > ISL.NW/2) nx = H0.x;   // and at the far beach
  H0.x = nx;
  if(Math.abs(H0.vx) > 4) H0.face = Math.sign(H0.vx);
  // fall, land on the ground or on a ledge from above
  const ny = H0.y + H0.vy*dt, g = groundAt(H0.x); let landed = false;
  if(H0.vy >= 0) for(const p of ISL.plats){ if(H0.x >= p.x-2 && H0.x <= p.x+p.w+2 && H0.y <= p.y + .5 && ny >= p.y){ H0.y = p.y; H0.vy = 0; landed = true; break; } }
  if(!landed){ if(ny >= g){ H0.y = g; H0.vy = 0; landed = true; } else if(H0.ground && H0.vy >= 0 && g - H0.y < 5 && !onPlat(H0)){ H0.y = g; landed = true; } else H0.y = ny; }
  if(landed && !H0.ground && H0.vy === 0) for(let i=0;i<3;i++) LP.push({t:'dust', x:H0.x + rand(-3,3), y:H0.y-1, vx:rand(-14,14), vy:rand(-10,-2), life:.35});
  H0.ground = landed;
  H0.walkT += Math.abs(H0.vx)*dt;
  // the camera moves one panel at a time
  const panel = clamp(Math.floor(H0.x / W), 0, ISL.panels-1), tx = panel*W;
  camX += (tx - camX)*Math.min(1, dt*9); if(Math.abs(tx - camX) < .5) camX = tx;
  if(panel === ISL.panels-1 && !S.seen['farbeach:'+ISL.seed]){ markSeen('farbeach:'+ISL.seed); toast('You reached the far beach.'); }
  // aim: face the cursor when holding a gun
  const id = curGun(); if(id && T.hover){ const hx = H0.x, wx = T.hover.x + camX; if(Math.abs(wx - hx) > 2 && !T.joy) H0.face = wx > hx ? 1 : -1; }
  gunTimers(dt, true); updateLightning(dt); updateLandShots(dt);
  for(const c of ISL.crabs){ if(!c.alive) continue; c.t += dt; const near = Math.abs(c.x - H0.x) < 26; c.x += c.dir*(near ? 34 : 9)*dt*(Math.sin(c.t*3) > -.3 ? 1 : 0); if(c.x < c.minX || c.x > c.maxX) c.dir *= -1; if(near) c.dir = c.x > H0.x ? 1 : -1; c.x = clamp(c.x, c.minX, c.maxX); }
  for(const p of LP){ p.life -= dt; p.x += p.vx*dt; p.y += p.vy*dt; if(p.t==='debris') p.vy += 200*dt; }
  LP = LP.filter(p => p.life > 0);
  if(ISL.theme==='volcanic' && Math.random() < dt*6) LP.push({t:'ember', x:camX + rand(0,W), y:H+2, vx:rand(-6,6), vy:rand(-26,-12), life:rand(3,6)});
}
const onPlat = h => ISL.plats.some(p => h.x >= p.x-2 && h.x <= p.x+p.w+2 && Math.abs(h.y - p.y) < .6);

/* ----- weapons on land ----- */
const heroHand = () => ({x:HERO.x + HERO.face*2.5, y:HERO.y - 10});
function landAim(){ // angle in degrees relative to facing: negative is up
  const h = heroHand(); if(!T.hover) return 0;
  const wx = T.hover.x + camX, wy = T.hover.y;
  return clamp(Math.atan2(wy - h.y, Math.max(2, (wx - h.x)*HERO.face))*180/Math.PI, -80, 80);
}
function landMuzzle(id, aDeg){
  const h = heroHand(), a = aDeg*Math.PI/180, [mx, my] = GUN_ART[id].muzzle;
  return {x:h.x + HERO.face*(mx*Math.cos(a) - my*Math.sin(a))/GUN_K, y:h.y + (mx*Math.sin(a) + my*Math.cos(a))/GUN_K};
}
const landSolid = (x, y) => y >= groundAt(x) || ISL.plats.some(p => x >= p.x && x <= p.x+p.w && y >= p.y && y <= p.y+6);
function landFire(){
  const id = curGun(); if(!id || WS(id).lvl < 0 || !ISL) return;
  const g = G.gun, w = WEAPONS[id], t = wTier(id), st = WS(id);
  if(g.reload){ sfx('dry'); return; }
  if(g.cd > 0) return;
  g.aim = landAim(); const m = landMuzzle(id, g.aim), a = g.aim*Math.PI/180, dx = Math.cos(a)*HERO.face, dy = Math.sin(a);
  if(w.bolt && st.alt){
    if(st.ammo2 <= 0){ sfx('dry'); toast('Out of delayed power cells. Press T to switch back.'); return; }
    st.ammo2--; g.cd = t.reload; g.shotT = 0;
    const tx = T.hover ? T.hover.x + camX : m.x + dx*120, ty = T.hover ? T.hover.y : m.y + dy*120;
    LO.push({x:m.x, y:m.y, tx, ty, phase:'fly', t:0, tier:t}); sfx('hum'); save(); return;
  }
  if(st.mag <= 0){
    if(st.ammo <= 0){ sfx('dry'); toast(`Out of ${w.ammoName.toLowerCase()}. Buy more at the harbor shop.`); }
    else if(w.auto) startReload(); else { sfx('dry'); toast('Reload first: press R.'); }
    return;
  }
  st.mag--; g.cd = t.cool; g.shotT = 0; markSeen('gun:land');
  if(w.bolt){ // trace to the ground (or the end of its range), then crackle there
    const reach = t.range*FT*1.6; let x = m.x, y = m.y;
    for(let s=0; s<reach; s+=2){ x = m.x + dx*s; y = m.y + dy*s; if(landSolid(x, y) || y < -10) break; }
    const links = [{a:{x:m.x, y:m.y}, b:{x, y}, d:0, main:true}];
    for(let k=0;k<4;k++){ const an = rand(-Math.PI, 0), L = rand(6, 14); links.push({a:{x, y}, b:{x:x + Math.cos(an)*L, y:y + Math.sin(an)*L}, d:1, spoke:true}); }
    G.bolts.push({links, t:0, dur:.42, gen:-1}); G.zapFlash = .3; sfx('zap'); doShake(2.5);
    landHitCrabs(x, y, 10);
  } else {
    const n = t.pellets || 1, spread = (t.spread || 0)*Math.PI/180;
    for(let i=0;i<n;i++){ const off = n > 1 ? (-spread/2 + spread*(i + Math.random()*.8 + .1)/n) : 0, aa = a + off;
      LB.push({x:m.x, y:m.y, dx:Math.cos(aa)*HERO.face, dy:Math.sin(aa), spd:w.speed*(n > 1 ? rand(.88, 1.08) : 1), left:t.range*FT*1.6, kind:id, pierce:w.pierce}); }
    sfx(id==='shotgun' ? 'blast' : id==='sniper' ? 'rifle' : 'shot'); doShake(id==='revolver' ? 1.5 : 3);
  }
  LP.push({t:'flash', x:m.x, y:m.y, vx:0, vy:0, life:.08});
  if(st.mag === 0 && st.ammo > 0 && w.auto) g.pending = .3;
  save();
}
function landHitCrabs(x, y, r){ for(const c of ISL.crabs) if(c.alive && Math.hypot(c.x - x, groundAt(c.x) - 2 - y) < r){ c.alive = false; for(let i=0;i<6;i++) LP.push({t:'debris', x:c.x, y:groundAt(c.x)-2, vx:rand(-30,30), vy:rand(-60,-20), life:.6, c:'#e8573a'}); sfx('thunk'); } }
function updateLandShots(dt){
  for(const b of LB){
    let remain = b.spd*dt;
    while(remain > 0 && !b.dead){ const st = Math.min(3, remain); remain -= st; b.x += b.dx*st; b.y += b.dy*st; b.left -= st;
      if(b.left <= 0 || b.y < -20 || b.x < camX - 20 || b.x > camX + W + 20){ b.dead = true; break; }
      if(landSolid(b.x, b.y)){ b.dead = true; for(let i=0;i<4;i++) LP.push({t:'debris', x:b.x, y:b.y-1, vx:rand(-30,30), vy:rand(-50,-10), life:.4, c:ISL.TH.dirt[0]}); break; }
      landHitCrabs(b.x, b.y, 4);
    }
  }
  LB = LB.filter(b => !b.dead);
  for(const o of LO){
    o.t += dt;
    if(o.phase==='fly'){ const dx = o.tx - o.x, dy = o.ty - o.y, d = Math.hypot(dx, dy), sp = 260*dt;
      if(d <= sp){ o.x = o.tx; o.y = o.ty; o.phase = 'arm'; o.t = 0; sfx('hum'); } else { o.x += dx/d*sp; o.y += dy/d*sp; }
      if(landSolid(o.x, o.y)){ o.y = Math.min(o.y, groundAt(o.x) - 1); o.phase = 'arm'; o.t = 0; sfx('hum'); } }
    else if(o.phase==='arm' && o.t > .55){
      const R = o.tier.burst, links = []; for(let k=0;k<11;k++){ const an = k/11*Math.PI*2 + rand(-.2,.2), L = R*rand(.8,1.4); links.push({a:{x:o.x, y:o.y}, b:{x:o.x + Math.cos(an)*L, y:o.y + Math.sin(an)*L}, d:0, spoke:true}); }
      G.bolts.push({links, t:0, dur:.6, gen:-1, burst:{x:o.x, y:o.y, R}}); G.zapFlash = .5; sfx('zapboom'); doShake(5); landHitCrabs(o.x, o.y, R + 6); o.done = true; }
  }
  LO = LO.filter(o => !o.done);
}

/* ----- drawing ----- */
function drawHero(){
  const h = HERO, f = h.face, X = Math.round(h.x), Y = Math.round(h.y);
  const p = (dx, dy, w, hh, c) => { const x = f > 0 ? X + dx : X - dx - w; px(x, Y + dy, w, hh, c); };
  const step = h.ground && Math.abs(h.vx) > 8 ? Math.floor(h.walkT/5) % 4 : -1;
  // legs and boots
  const lA = step===0 ? 1 : step===2 ? -1 : 0, air = !h.ground;
  p(-2 + (air ? -1 : lA), -5, 2, air ? 3 : 4, '#3a4660'); p(1 + (air ? 1 : -lA), -5, 2, air ? 3 : 4, '#323d56');
  p(-2 + (air ? -1 : lA), air ? -2 : -1, 2, 1, '#2a2a30'); p(1 + (air ? 1 : -lA), air ? -2 : -1, 2, 1, '#2a2a30');
  // coat
  p(-3, -13, 6, 8, '#f2c14e'); p(2, -13, 1, 8, '#c99a2e'); p(-3, -9, 6, 1, '#c99a2e');
  // arm: forward when holding a gun, swinging otherwise
  if(curGun()) p(2, -11, 3, 2, '#f2c14e'); else p(-1 + (step===1 ? 1 : step===3 ? -1 : 0), -11, 2, 4, '#e0ae3e');
  // head, beard, eye, hat
  p(-2, -18, 5, 5, '#f0c39b'); p(-2, -15, 1, 2, '#8a5a3a'); p(-1, -14, 3, 1, '#8a5a3a'); p(1, -17, 1, 1, '#2a1a10');
  p(-2, -20, 5, 2, '#2f5d50'); p(-3, -18, 7, 1, '#244a40');
}
function drawLandGun(fade){
  const id = curGun(); if(!id || WS(id).lvl < 0 || !ISL) return;
  const art = GUN_ART[id]; if(!art.sheet.complete || !art.sheet.naturalWidth) return;
  const g = G.gun, h = heroHand(), C = art.cell, a = g.reload ? -30 : landAim(); g.aim += (a - g.aim)*.5;
  const row = g.shotT*18 < art.frames ? Math.floor(g.shotT*18) : art.frames - 1;
  let col = 0, best = 1e9; GUN_ANGLES.forEach((v, i) => { const d = Math.abs(v - g.aim); if(d < best){ best = d; col = i; } });
  const extra = (g.aim - GUN_ANGLES[col])*Math.PI/180;
  const sx = (h.x - Math.round(camX) + (G.shakeX||0))*GUN_K, sy = (h.y + (G.shakeY||0))*GUN_K;
  const drawIt = () => { fxx.save(); fxx.translate(Math.round(sx), Math.round(sy)); fxx.scale(HERO.face, 1); if(Math.abs(extra) > .01) fxx.rotate(extra); fxx.drawImage(art.sheet, col*C, Math.min(row, art.frames-1)*C, C, C, -C/2, -C/2, C, C); fxx.restore(); };
  fxx.globalAlpha = 1 - fade; drawIt(); fxx.globalAlpha = 1;
  const lc = lightNow();
  if(lc[0] < 253 || lc[1] < 253 || lc[2] < 253){ fxx.globalCompositeOperation = 'multiply'; fxx.fillStyle = `rgb(${lc})`; fxx.fillRect(sx - C, sy - C, C*2, C*2); fxx.globalCompositeOperation = 'destination-in'; fxx.globalAlpha = 1 - fade; drawIt(); fxx.globalCompositeOperation = 'source-over'; fxx.globalAlpha = 1; }
}
function renderLand(){
  const I = ISL, cx = Math.round(camX), sx = shake>0 ? Math.round(rand(-shake,shake)*.5) : 0, sy = shake>0 ? Math.round(rand(-shake,shake)*.5) : 0;
  G.shakeX = sx; G.shakeY = sy;
  ctx.setTransform(1,0,0,1,0,0);
  // sky (the shared side-view sky, lowered), clouds, the sea on the horizon and the far ridge
  const [ka] = skyBlend(); ctx.fillStyle = SKY_PAL[ka].sky[0]; ctx.fillRect(0, 0, W, 42);
  ctx.save(); ctx.translate(0, 40); drawSky(); for(const c of clouds) ctx.drawImage(c.img, Math.round(c.x), c.y); ctx.restore();
  const sea = ctx.createLinearGradient(0, 100, 0, H); sea.addColorStop(0, shade(I.TH.sea, .25)); sea.addColorStop(1, shade(I.TH.sea, -.35)); ctx.fillStyle = sea; ctx.fillRect(0, 100, W, H-100);
  for(let x=0; x<W; x+=1) if((x + Math.floor(time*6)) % 13 < 2) px(x, 102 + (x*7)%9, 2, 1, 'rgba(230,250,255,.35)');
  ctx.drawImage(I.backC, Math.round(camX*.5), 0, W, H, 0, 0, W, H);
  ctx.setTransform(1,0,0,1,sx - cx, sy);
  ctx.drawImage(I.terrC, cx, 0, W, H, cx, 0, W, H);
  // sea over the low ends of the beaches, with a little surf
  for(let x=cx; x<cx+W; x++){ const g = I.hgt[clamp(x,0,I.NW-1)]; if(g <= WL) continue; const s = WL + Math.round(Math.sin(x*.08 + time*2)*1); px(x, s, 1, H - s, 'rgba(47,140,170,.78)'); if((x + Math.floor(time*10)) % 9 < 2) px(x, s, 1, 1, '#d8f4f6'); }
  // your boat, pulled up at the near beach
  if(cx < 60){ const hull = boat().hull, bx = 4, by = WL - 3; for(let r=0;r<6;r++){ const l = bx + r, rr = bx + 36 - r*2; px(l, by + r, rr - l, 1, r===0 ? shade(hull,.28) : r%3===1 ? shade(hull,-.35) : hull); } px(bx+2, by-10, 1, 10, '#4a3420'); px(bx, by-10, 3, 1, '#4a3420'); px(bx-1, by-9, 3, 3, '#7a5a2a'); }
  for(const c of I.crabs) if(c.alive){ const y = Math.round(groundAt(c.x)) - 2, x = Math.round(c.x), legs = Math.floor(time*12) % 2; px(x-2, y, 5, 2, '#e8573a'); px(x-3, y-1, 1, 1, '#e8573a'); px(x+3, y-1, 1, 1, '#e8573a'); px(x-1, y-1, 1, 1, '#2a1a10'); px(x+1, y-1, 1, 1, '#2a1a10'); px(x-2 + legs, y+2, 1, 1, '#b8402a'); px(x+2 - legs, y+2, 1, 1, '#b8402a'); }
  drawHero();
  for(const b of LB){ ctx.fillStyle = 'rgba(255,244,210,.9)'; const n = b.kind==='sniper' ? 10 : b.kind==='shotgun' ? 3 : 6; for(let i=0;i<n;i++) ctx.fillRect(Math.round(b.x - b.dx*i*1.2), Math.round(b.y - b.dy*i*1.2), 1, 1); px(b.x, b.y, 1, 1, '#ffffff'); }
  for(const p of LP){ if(p.t==='dust') px(p.x, p.y, 1, 1, `rgba(220,210,190,${p.life*2})`); else if(p.t==='debris') px(p.x, p.y, 1, 1, p.c); else if(p.t==='flash') { ctx.fillStyle = 'rgba(255,240,190,.9)'; ctx.fillRect(Math.round(p.x)-1, Math.round(p.y)-1, 3, 3); } }
  ctx.drawImage(I.frontC, cx, 0, W, H, cx, 0, W, H);
  for(const o of LO){ const r = o.phase==='arm' ? 3 : 2; px(o.x - r/2, o.y - r/2, r, r, o.phase==='arm' && Math.floor(o.t*14)%2 ? '#ffb04a' : '#dff4ff'); }
  // time of day, then everything that glows
  applyDayTint();
  ctx.save(); ctx.setTransform(1,0,0,1,0,40); drawNightSky(); ctx.restore();
  const n = nightK();
  lanternGlow(HERO.x, HERO.y - 10, 34, n*.8);
  if(I.glows.length){ ctx.save(); ctx.globalCompositeOperation = 'lighter'; for(const g of I.glows){ if(g.x < cx - 40 || g.x > cx + W + 40) continue; const p = .75 + .25*Math.sin(time*2.4 + g.x); const gr = ctx.createRadialGradient(g.x, g.y, 1, g.x, g.y, g.r); gr.addColorStop(0, `rgba(255,120,50,${.45*p})`); gr.addColorStop(1, 'rgba(255,80,30,0)'); ctx.fillStyle = gr; ctx.fillRect(g.x - g.r, g.y - g.r, g.r*2, g.r*2); } ctx.restore(); }
  if(n > .2 && (I.theme==='tropical' || I.theme==='mangrove')){ ctx.save(); ctx.globalCompositeOperation = 'lighter'; for(const f of I.flies){ const x = f.x + Math.sin(time*.7 + f.ph)*10, y = f.y + Math.sin(time*1.1 + f.ph*2)*6, a = n*(.35 + .35*Math.sin(time*3 + f.ph)); if(a < .1 || x < cx-4 || x > cx+W+4) continue; ctx.fillStyle = `rgba(220,255,140,${a})`; ctx.fillRect(Math.round(x), Math.round(y), 1, 1); } ctx.restore(); }
  for(const p of LP) if(p.t==='ember'){ ctx.fillStyle = `rgba(255,140,60,${Math.min(1, p.life/2)})`; ctx.fillRect(Math.round(p.x), Math.round(p.y), 1, 1); }
  drawLightning();
  ctx.setTransform(1,0,0,1,0,0);
  if(I.theme==='frozen') for(let i=0;i<46;i++){ const x = (i*67.3 + time*(8 + i%5*3)*.6 + Math.sin(time*.8+i)*6) % W, y = (i*37.1 + time*(14 + i%4*4)) % H; ctx.fillStyle = 'rgba(250,252,255,.85)'; ctx.fillRect(Math.round((x+W)%W), Math.round(y), 1, 1); }
  // where you are on the island: a pip per stretch
  const pn = I.panels, cur = clamp(Math.floor(HERO.x/W), 0, pn-1), x0 = Math.round(W/2 - pn*4);
  for(let i=0;i<pn;i++) px(x0 + i*8, 5, 6, 2, i===cur ? '#ffd25e' : 'rgba(239,227,200,.35)');
  if(G.flashA > 0){ ctx.fillStyle = `rgba(255,246,220,${G.flashA})`; ctx.fillRect(0,0,W,H); }
  if(G.zapFlash > 0){ ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.fillStyle = `rgba(90,150,255,${G.zapFlash*.35})`; ctx.fillRect(0,0,W,H); ctx.restore(); }
  ctx.drawImage(vigC, 0, 0);
}

function update(dt){
  time += dt;
  shake = Math.max(0, shake - dt*18);
  if(G.trans) updateTrans(dt);
  updateClock(dt);
  if(WORLD){ if(G.mode==='travel') updateTravel(dt); else if(G.mode==='land'){ if(ISL) updateLand(dt); } else updateFishing(dt); }
  miniT -= dt; if(G.mode==='travel' && miniT <= 0){ miniT = .15; renderMini(); }
  updateHud();
}
function render(){
  if(!WORLD){ ctx.setTransform(1,0,0,1,0,0); ctx.fillStyle='#081222'; ctx.fillRect(0,0,W,H); return; }
  const tr = G.trans;
  // Transition: zoom into the boat and fade out, swap scenes, then fade back in
  let fade = 0, zoom = 1;
  if(tr){ const k = tr.t/tr.dur, a = k < .5 ? k/.5 : 1 - (k-.5)/.5; fade = ease(a); if(G.mode==='travel') zoom = 1 + fade*3; }
  if(G.mode==='travel') renderTravel(zoom); else if(G.mode==='land' && ISL) renderLand(); else renderFishing();
  if(fade > 0){ ctx.setTransform(1,0,0,1,0,0); ctx.fillStyle = `rgba(12,30,48,${fade})`; ctx.fillRect(0,0,W,H); }
  drawGunOverlay(fade);
}
let last=performance.now();
function loop(now){
  const dt = Math.min(.05, (now-last)/1000); last=now;
  if(POPPED){ requestAnimationFrame(loop); return; }
  update(dt); render();
  requestAnimationFrame(loop);
}
loadWorld();
if(!WORLD) askMapSize();
document.body.dataset.mode = G.mode;
requestAnimationFrame(loop);
window.__game = {G, T, S:()=>S, W:()=>WORLD, fishes:()=>fishes, cam:()=>camY, lake:()=>({LAKE_FT, ABYSS, ZONE, HOT})};
</script>
</body>
</html>

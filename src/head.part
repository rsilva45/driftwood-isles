<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0f2236">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Driftwood Isles">
<meta name="description" content="A pixel-art fishing game: sail a generated archipelago, fish the depths, net, blast and upgrade.">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" href="icons/favicon-32.png">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<title>Driftwood Isles: a pixel fishing game</title>
<style>
:root{
  --ink:#0f2236; --ink2:#17324d; --line:#2d5677; --bone:#efe3c8; --bone-dim:#b3a98f;
  --buoy:#ff6a3d; --buoy-dk:#b8401f; --good:#7bd389; --warn:#ffd25e; --bad:#ff5a5a;
  --r0:#c9d1d6; --r1:#7bd389; --r2:#5aa8ff; --r3:#b77bff; --r4:#ffb13b; --r5:#ff4f9a;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#071321;color:var(--bone);font-family:Verdana,Geneva,"DejaVu Sans",sans-serif;font-size:14px;overflow:hidden}
#stage{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);box-shadow:0 0 0 2px #000,0 12px 40px rgba(0,0,0,.5)}
#game{display:block;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;cursor:crosshair;touch-action:none}
:focus-visible{outline:2px solid var(--warn);outline-offset:2px}

/* HUD */
.hud{position:absolute;pointer-events:none;display:flex;gap:6px;align-items:center}
.hud > *{pointer-events:auto}
#hudL{left:10px;top:10px;flex-wrap:wrap;max-width:62%}
#hudR{right:10px;top:10px}
.chip{display:flex;align-items:center;gap:6px;background:rgba(15,34,54,.88);border:2px solid var(--line);padding:4px 9px;font-size:13px;line-height:18px;border-radius:2px;white-space:nowrap}
.chip b{color:var(--warn);font-weight:700}
.chip .lbl{color:var(--bone-dim)}
.chip.full{border-color:var(--bad)}
.chip.full b{color:var(--bad)}
.ibtn{width:40px;height:40px;display:grid;place-items:center;background:rgba(15,34,54,.9);border:2px solid var(--line);border-radius:2px;color:var(--bone);cursor:pointer;padding:0;position:relative}
.ibtn:hover{border-color:var(--bone)}
.ibtn svg{width:22px;height:22px;shape-rendering:crispEdges}
.ibtn kbd{position:absolute;right:1px;bottom:0;font:9px Verdana,sans-serif;color:var(--bone-dim)}
#hint{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);background:rgba(15,34,54,.9);border:2px solid var(--line);padding:6px 12px;font-size:13px;border-radius:2px;max-width:92%;text-align:center;pointer-events:none}
#hint.alert{border-color:var(--buoy);color:#fff;animation:pulse .5s steps(2) infinite}
@keyframes pulse{50%{background:rgba(120,40,20,.92)}}
#toast{position:absolute;left:50%;top:58px;bottom:auto;transform:translateX(-50%) translateY(8px);background:var(--bone);color:#16212d;padding:8px 14px;border:2px solid #16212d;font-size:13px;font-weight:700;opacity:0;transition:opacity .18s,transform .18s;pointer-events:none;max-width:90%;text-align:center;border-radius:2px}
#toast.show{opacity:1;transform:translateX(-50%)}

#hudR{align-items:flex-start}
#miniWrap{background:rgba(15,34,54,.9);border:2px solid var(--line);padding:3px;border-radius:2px}
#mini{width:132px;height:132px;image-rendering:pixelated;display:block;background:#08121f}
.minilbl{font-size:11px;line-height:16px;color:var(--bone-dim);text-align:center;margin-top:2px}
#btnSail{height:40px;display:flex;align-items:center;gap:8px;font-size:13px;background:rgba(15,34,54,.92)}
#btnSail kbd,#actions kbd{font:11px Verdana,sans-serif;border:1px solid currentColor;padding:0 4px;border-radius:2px;opacity:.8}
#actions{position:absolute;left:50%;bottom:48px;transform:translateX(-50%);display:flex;gap:8px}
#actions .btn{display:flex;align-items:center;gap:8px;white-space:nowrap}
body[data-mode="fish"] #miniWrap, body[data-mode="fish"] #actions{display:none}
body[data-mode="travel"] #btnSail, body[data-mode="travel"] #gauge{display:none}
.sizes{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.size{font:inherit;text-align:left;background:var(--ink2);color:var(--bone);border:2px solid var(--line);padding:14px;cursor:pointer;border-radius:2px;display:flex;flex-direction:column;gap:6px}
.size:hover{border-color:var(--bone)}
.size strong{font-size:16px}
.size span{font-size:12px;color:var(--bone-dim);line-height:1.5}
.size svg{width:100%;height:56px;shape-rendering:crispEdges}
@media (max-width:600px){.sizes{grid-template-columns:1fr}#mini{width:96px;height:96px}}
#tools{position:absolute;left:10px;bottom:10px;display:flex;gap:6px}
body[data-mode="travel"] #tools{display:none}
.tool{width:46px;height:46px;display:grid;place-items:center;background:rgba(15,34,54,.92);border:2px solid var(--line);border-radius:2px;cursor:pointer;position:relative;padding:0}
.tool:hover:not(:disabled){border-color:var(--bone)}
.tool img{width:32px;height:32px;image-rendering:pixelated}
.tool[aria-pressed="true"]{border-color:var(--warn);box-shadow:inset 0 0 0 1px var(--warn)}
.tool:disabled{opacity:.38;cursor:not-allowed}
.tool kbd{position:absolute;left:3px;top:1px;font:9px Verdana,sans-serif;color:var(--bone-dim)}
.tool .badge{position:absolute;right:-7px;top:-7px;background:var(--buoy);color:#1d0d05;font:700 10px Verdana,sans-serif;padding:1px 4px;border:2px solid #1d0d05;border-radius:2px}
.cardicon{width:40px;height:40px;image-rendering:pixelated}
.pips{display:flex;gap:3px}.pips i{width:10px;height:6px;border:1px solid var(--line);display:block}.pips i.on{background:var(--warn);border-color:var(--warn)}
@media (max-width:600px){#hint{bottom:62px}}
/* ---------- touch and small screens ---------- */
html,body{touch-action:manipulation;overscroll-behavior:none;-webkit-tap-highlight-color:transparent;-webkit-text-size-adjust:100%}
#stage{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
#stage img{-webkit-user-drag:none;pointer-events:none}
#game{position:relative}
body.portrait #stage{left:0;top:0;transform:none;box-shadow:none}
body.portrait #game{position:absolute;left:0}
#hudL{left:calc(10px + env(safe-area-inset-left));top:calc(10px + env(safe-area-inset-top))}
#hudR{right:calc(10px + env(safe-area-inset-right));top:calc(10px + env(safe-area-inset-top))}
#tools{left:calc(10px + env(safe-area-inset-left));bottom:calc(10px + env(safe-area-inset-bottom))}
#hint{bottom:calc(10px + env(safe-area-inset-bottom))}
#touchPad{position:absolute;right:calc(12px + env(safe-area-inset-right));bottom:calc(12px + env(safe-area-inset-bottom));display:none;flex-direction:column;align-items:flex-end;gap:8px}
#touchPad.on{display:flex}
.pad{width:60px;height:60px;display:grid;place-items:center;background:rgba(15,34,54,.92);border:2px solid var(--line);border-radius:2px;color:var(--bone);font:700 22px Verdana,sans-serif;touch-action:none}
.pad.down{border-color:var(--warn);color:var(--warn)}
.pad[hidden]{display:none}
.pad.wide{width:auto;padding:0 14px;font-size:14px}
body[data-mode="travel"] #touchPad{display:none}
@media (pointer:coarse){
  .ibtn{width:48px;height:48px}.ibtn svg{width:26px;height:26px}
  .ibtn kbd,.tool kbd,#btnSail kbd,#actions kbd{display:none}
  #btnSail{height:48px;font-size:14px;padding:0 14px}
  .tool{width:58px;height:58px}.tool img{width:40px;height:40px}
  #actions .btn{min-height:54px;font-size:16px;padding:10px 20px}
  #actions{bottom:calc(56px + env(safe-area-inset-bottom))}
  .btn{min-height:44px}.btn.sm{min-height:42px;padding:8px 14px;font-size:13px}
  .x{width:44px;height:44px}
  .tab{padding:12px 14px;white-space:nowrap}
  .tabs{overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}.tabs::-webkit-scrollbar{display:none}
  input[type=text],select{font-size:16px;min-height:44px}
  input[type=range]{height:34px}
  input[type=checkbox]{width:22px;height:22px}
  input[type=file]{font-size:14px;min-height:44px}
  .lab{min-height:44px}
  .size{min-height:120px}
  body[data-mode="fish"] #hint{left:calc(84px + env(safe-area-inset-left));right:calc(84px + env(safe-area-inset-right));transform:none;max-width:none}
  .chip{padding:5px 9px}
}
@media (pointer:coarse) and (max-height:500px){
  /* landscape phones: a little tighter so the scene stays visible */
  .chip{font-size:11px;padding:3px 7px;line-height:16px}
  #mini{width:96px;height:96px}
  .minilbl{display:none}
  .tool{width:52px;height:52px}.tool img{width:36px;height:36px}
  .pad{width:54px;height:54px}
  body[data-mode="fish"] #hint{left:calc(78px + env(safe-area-inset-left))}
}
body.touch #hudL{max-width:calc(100% - 300px)}
body.portrait #hudL{max-width:calc(100% - 20px)}
body.portrait #hudR{top:auto;bottom:calc(100% - var(--cv-top, 0px) + 8px)}
body.portrait #toast{top:calc(var(--cv-top, 58px) + 8px)}
body.portrait.touch #hint{left:50%;right:auto;transform:translateX(-50%);max-width:92%;bottom:calc(84px + env(safe-area-inset-bottom))}
body.portrait.touch #actions{bottom:calc(140px + env(safe-area-inset-bottom))}
@media (max-width:720px), (max-height:520px){
  dialog{width:100vw;max-width:100vw;max-height:100dvh;margin:auto;border-radius:0;border-left:0;border-right:0}
  .db{max-height:calc(100dvh - 120px);padding:14px calc(14px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(14px + env(safe-area-inset-left))}
  #catchDlg{width:100vw}
}
@media (max-width:520px){ .grid{grid-template-columns:1fr} .dex{grid-template-columns:repeat(auto-fill,minmax(84px,1fr))} .fishrow{flex-wrap:wrap} }
#strikeBtn{position:absolute;left:50%;top:30%;transform:translateX(-50%);font-size:20px;padding:12px 26px;min-height:56px;display:flex;align-items:center;gap:10px;background:var(--warn);box-shadow:inset 0 -3px 0 #b8901f,0 0 0 3px rgba(255,210,94,.35);animation:pulse .3s steps(2) infinite}
#strikeBtn[hidden]{display:none}
#strikeBtn kbd{font:11px Verdana,sans-serif;border:1px solid currentColor;padding:0 4px;border-radius:2px}
.chip[hidden]{display:none}
.invstat{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}.invstat .chip{font-size:14px}
body.touch[data-mode=travel],body.touch[data-mode=land]{touch-action:none}
body[data-mode="land"] #miniWrap, body[data-mode="land"] #gauge, body[data-mode="land"] #touchPad{display:none}
#landPad{position:absolute;right:calc(12px + env(safe-area-inset-right));bottom:calc(12px + env(safe-area-inset-bottom));display:none;flex-direction:column;align-items:flex-end;gap:8px}
body.touch[data-mode="land"] #landPad{display:flex}
#landPad .pad.big{width:76px;height:76px;font-size:16px}
#landPad .pad.down{background:rgba(40,70,100,.95)}
#joy{position:fixed;width:108px;height:108px;margin:-54px 0 0 -54px;border-radius:50%;border:2px solid rgba(239,227,200,.35);background:rgba(15,34,54,.25);z-index:40;pointer-events:none;opacity:0;transition:opacity .15s}
#joy.on{opacity:1}#joy[hidden]{display:none}
#joy i{position:absolute;left:50%;top:50%;width:46px;height:46px;border-radius:50%;background:rgba(239,227,200,.45);border:2px solid rgba(239,227,200,.6);transform:translate(-50%,-50%)}
.restbox{max-width:420px;margin:0 auto;text-align:center;display:flex;flex-direction:column;gap:14px}
.restbox p{font-size:13px;margin:0;line-height:1.5}
.restpick{display:flex;align-items:center;justify-content:center;gap:14px;padding:16px;border:2px solid var(--line);background:rgba(15,34,54,.6)}
.restpick strong{display:block;font-size:22px;color:var(--bone);text-align:left}.restpick span{display:block;font-size:12px;color:var(--bone-dim);text-align:left}
.cico.big{width:40px;height:40px}.cico.big svg{width:40px;height:40px}
#sleepFade{position:fixed;inset:0;background:#000;opacity:0;pointer-events:none;transition:opacity .8s ease;z-index:9999;display:flex;align-items:center;justify-content:center}
#sleepFade.on{opacity:1;pointer-events:auto}
#sleepFade span{color:var(--bone);font-size:16px;letter-spacing:.04em}
.card.locked{opacity:.7}
.gunchip.swap{cursor:pointer}
.cico{display:inline-flex;width:14px;height:14px}.cico svg{width:14px;height:14px;shape-rendering:crispEdges}
@media (max-width:600px){#clockVal{display:none}}
.chip.threat{border-color:var(--bad)}
.chip.threat .lbl{color:#ff9a9a}
.chip.threat .pips i.on{background:var(--bad);border-color:var(--bad)}
body.touch #strikeBtn kbd{display:none}
@media (pointer:coarse){#strikeBtn{font-size:22px;min-height:64px;padding:14px 32px}}
#fx{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;image-rendering:pixelated;image-rendering:crisp-edges}
body.portrait #fx{position:absolute;left:0}
.gunchip img{width:18px;height:18px;image-rendering:pixelated}
.cyl{display:flex;gap:2px}.cyl i{width:4px;height:9px;background:#3b4656;display:block;border-radius:1px}.cyl i.on{background:var(--warn)}
.gunchip .rbar{display:none;width:44px;height:6px;border:1px solid var(--line);position:relative;background:#0a1a2a}
.gunchip.reloading .rbar{display:block}.gunchip .rbar i{position:absolute;left:0;top:0;bottom:0;background:var(--good)}
.equip{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}
.eqi{display:flex;align-items:center;gap:6px;border:2px solid var(--line);background:var(--ink2);padding:4px 8px;font-size:12px;border-radius:2px}
.eqi img{width:20px;height:20px;image-rendering:pixelated}
.tool img[src*="data:image/png"]{image-rendering:pixelated}
/* tool wheel */
#wheelDlg{background:transparent;border:0;box-shadow:none;width:fit-content;height:fit-content;max-width:none;max-height:none;overflow:visible;padding:0;margin:auto;inset:0;border-radius:50%}
#wheelDlg::backdrop{background:rgba(4,10,20,.5)}
.wheel{--r:min(130px,32vmin);position:relative;width:calc(var(--r)*2 + 92px);height:calc(var(--r)*2 + 92px);border-radius:50%;
  background:radial-gradient(circle,rgba(15,34,54,.96) 0 calc(var(--r) - 38px),rgba(23,50,77,.94) calc(var(--r) - 37px) calc(var(--r) + 46px),transparent calc(var(--r) + 47px));
  border:2px solid var(--line)}
.wheel-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:calc(var(--r)*1.15);text-align:center;display:flex;flex-direction:column;gap:4px;pointer-events:none}
.wheel-center strong{font-size:15px;color:var(--bone)}
.wheel-center span{font-size:12px;color:var(--bone-dim)}
.wslot{position:absolute;left:50%;top:50%;width:84px;height:72px;margin:-36px 0 0 -42px;transform:rotate(var(--a)) translate(var(--r)) rotate(calc(-1 * var(--a)));
  background:var(--ink);border:2px solid var(--line);border-radius:3px;color:var(--bone);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:4px;font:12px Verdana,sans-serif}
.wslot:hover:not(:disabled),.wslot:focus-visible{border-color:var(--warn)}
.wslot.cur{border-color:var(--warn);box-shadow:inset 0 0 0 1px var(--warn)}
.wslot:disabled{opacity:.38;cursor:not-allowed}
.wslot img{width:32px;height:32px;image-rendering:pixelated;object-fit:contain}
.wslot img.wide{width:62px;height:32px}
.wslot em{position:absolute;right:-7px;top:-7px;background:var(--buoy);color:#1d0d05;font:700 10px Verdana,sans-serif;font-style:normal;padding:1px 4px;border:2px solid #1d0d05;border-radius:2px}
.wslot kbd{position:absolute;left:3px;top:1px;font:9px Verdana,sans-serif;color:var(--bone-dim)}
body.touch .wslot kbd{display:none}
#toolBtn img.wide{width:40px;height:21px;object-fit:contain}
.cardicon.wide{width:80px;height:40px;object-fit:contain}
.eqi img.wide{width:40px;height:20px;object-fit:contain}
/* Tension gauge */
#gauge{position:absolute;right:14px;top:50%;transform:translateY(-50%);display:none;flex-direction:column;align-items:center;gap:6px;pointer-events:none}
#gauge.on{display:flex}
.gbar{width:26px;height:min(46vh,190px);border:2px solid var(--bone);background:linear-gradient(to top,rgba(123,211,137,.22) 0 60%,rgba(255,210,94,.25) 60% 85%,rgba(255,90,90,.3) 85% 100%);position:relative;border-radius:2px}
.gfill{position:absolute;left:2px;right:2px;bottom:2px;height:0;background:var(--good)}
.gmark{position:absolute;left:-6px;right:-6px;height:2px;background:var(--bone)}
.glabel{font-size:12px;background:rgba(15,34,54,.9);padding:3px 6px;border:2px solid var(--line);text-align:center;line-height:1.35}
#slack{color:var(--warn);font-weight:700;visibility:hidden}
#slack.on{visibility:visible}

/* Dialogs */
dialog{background:var(--ink);color:var(--bone);border:2px solid var(--bone);padding:0;width:min(760px,94vw);max-height:90vh;box-shadow:6px 6px 0 rgba(0,0,0,.55);border-radius:3px;overflow:hidden}
dialog::backdrop{background:rgba(4,10,20,.62)}
.dh{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-bottom:2px solid var(--line);background:var(--ink2)}
.dh h2{margin:0;font-size:18px;letter-spacing:.02em}
.db{padding:16px;overflow:auto;max-height:calc(90vh - 64px)}
.x{background:none;border:2px solid var(--line);color:var(--bone);width:32px;height:32px;cursor:pointer;font-size:16px;border-radius:2px}
.x:hover{border-color:var(--bone)}
.btn{font:inherit;font-weight:700;background:var(--buoy);color:#1d0d05;border:2px solid #1d0d05;padding:8px 14px;box-shadow:inset 0 -3px 0 var(--buoy-dk);cursor:pointer;border-radius:2px}
.btn:hover{filter:brightness(1.08)}
.btn:active{transform:translateY(1px);box-shadow:inset 0 -1px 0 var(--buoy-dk)}
.btn.ghost{background:transparent;color:var(--bone);border-color:var(--line);box-shadow:none}
.btn.ghost:hover{border-color:var(--bone)}
.btn.danger{background:#3a1414;color:#ffb3b3;border-color:var(--bad);box-shadow:none}
.btn:disabled{opacity:.42;cursor:not-allowed;filter:none;transform:none}
.btn.sm{padding:5px 10px;font-size:12px}
.tabs{display:flex;gap:4px;padding:10px 16px 0;background:var(--ink2);border-bottom:2px solid var(--line)}
.tab{font:inherit;background:transparent;color:var(--bone-dim);border:2px solid transparent;border-bottom:none;padding:8px 12px;cursor:pointer;margin-bottom:-2px;border-radius:2px 2px 0 0}
.tab[aria-selected="true"]{color:var(--bone);background:var(--ink);border-color:var(--line)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
.card{border:2px solid var(--line);background:var(--ink2);padding:12px;display:flex;flex-direction:column;gap:6px;border-radius:2px}
.card.eq{border-color:var(--warn)}
.card h3{margin:0;font-size:15px}
.card p{margin:0;color:var(--bone-dim);font-size:12px;line-height:1.45}
.stats{margin:2px 0 4px;padding:0;list-style:none;font-size:12px;line-height:1.6}
.stats li span{color:var(--warn)}
.card .row{display:flex;justify-content:space-between;align-items:center;margin-top:auto;gap:8px}
.price{font-weight:700;color:var(--warn);display:flex;align-items:center;gap:4px}
.fishrow{display:flex;align-items:center;gap:10px;border:2px solid var(--line);background:var(--ink2);padding:8px 10px;border-radius:2px}
.fishrow img{width:56px;height:32px;object-fit:contain;image-rendering:pixelated;background:#0b2a40;border:1px solid var(--line)}
.fishrow .meta{flex:1;min-width:0;font-size:12px;line-height:1.45}
.fishrow .meta strong{font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.list{display:flex;flex-direction:column;gap:6px}
.r0{color:var(--r0)}.r1{color:var(--r1)}.r2{color:var(--r2)}.r3{color:var(--r3)}.r4{color:var(--r4)}
.r5{color:var(--r5);animation:shimmer 1.2s steps(6) infinite}
@keyframes shimmer{0%,100%{color:#ff4f9a}33%{color:#ffd25e}66%{color:#7ff0e0}}
.bar{height:10px;border:2px solid var(--line);background:#0a1a2a;position:relative;border-radius:2px}
.bar i{position:absolute;left:0;top:0;bottom:0;background:var(--good)}
.summary{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;font-size:12px}
.summary label{display:block;margin-bottom:4px;color:var(--bone-dim)}
.empty{border:2px dashed var(--line);padding:22px;text-align:center;color:var(--bone-dim);line-height:1.6;border-radius:2px}
.dex{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:8px;margin-top:8px}
.dex div{border:2px solid var(--line);padding:6px;text-align:center;font-size:11px;background:var(--ink2);border-radius:2px}
.dex img{width:64px;height:34px;object-fit:contain;image-rendering:pixelated;display:block;margin:0 auto 4px}
.dex .unk img{filter:brightness(0) opacity(.55)}
h4{margin:18px 0 6px;font-size:14px}
.toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}

/* Catch card */
#catchDlg{width:min(380px,92vw)}
.catch{padding:18px;text-align:center}
.catch .pad{background:linear-gradient(#1f7a99,#14466e);border:2px solid var(--line);height:130px;display:grid;place-items:center;margin-bottom:12px;position:relative;border-radius:2px}
.catch .pad img{max-width:80%;max-height:100px;image-rendering:pixelated;min-width:96px}
.catch .new{position:absolute;top:8px;left:8px;background:var(--warn);color:#1d1405;font-size:11px;font-weight:700;padding:2px 6px;border-radius:2px}
.catch h2{margin:0 0 2px;font-size:20px}
.catch dl{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin:14px 0}
.catch dl div{border:2px solid var(--line);padding:6px;background:var(--ink2);border-radius:2px}
.catch dt{font-size:11px;color:var(--bone-dim)}
.catch dd{margin:2px 0 0;font-weight:700;font-size:15px}
.catch .warn{color:var(--warn);font-size:12px;margin:0 0 12px;line-height:1.5}
.catch .acts{display:flex;gap:8px;justify-content:center}

/* Admin form */
.form{display:grid;grid-template-columns:1fr 1fr;gap:12px 16px}
.f{display:flex;flex-direction:column;gap:4px;font-size:12px}
.f.wide{grid-column:1/-1}
.f > label{color:var(--bone)}
.f small{color:var(--bone-dim);line-height:1.4}
.f output{color:var(--warn);font-weight:700}
input[type=text],select{font:inherit;background:#0a1a2a;color:var(--bone);border:2px solid var(--line);padding:7px 8px;border-radius:2px}
input[type=range]{accent-color:var(--buoy);width:100%}
input[type=file]{font-size:12px;color:var(--bone-dim)}
input[type=color]{width:48px;height:30px;border:2px solid var(--line);background:none;padding:0}
.err{color:var(--bad);font-size:12px;min-height:1em}
.thumbs{display:flex;gap:6px;flex-wrap:wrap;min-height:40px}
.thumbs img{height:40px;image-rendering:pixelated;background:#0b2a40;border:1px solid var(--line);padding:2px}
.lab{display:flex;align-items:center;gap:6px;cursor:pointer}
.section{border-top:2px solid var(--line);margin-top:18px;padding-top:14px}
.flexw{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
@media (max-width:600px){.form{grid-template-columns:1fr}.summary{grid-template-columns:1fr}#hudL{max-width:70%}.chip{font-size:11px;padding:3px 6px}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body data-mode="travel">
<div id="stage">
  <canvas id="game" width="320" height="180" aria-label="Fishing scene. Hold click or Space to cast."></canvas>
  <canvas id="fx" aria-hidden="true"></canvas>

  <div class="hud" id="hudL">
    <div class="chip" id="coinChip" hidden title="Coins"><svg viewBox="0 0 8 8" width="14" height="14" style="shape-rendering:crispEdges"><rect x="2" y="0" width="4" height="8" fill="#ffd25e"/><rect x="0" y="2" width="8" height="4" fill="#ffd25e"/><rect x="1" y="1" width="6" height="6" fill="#ffd25e"/><rect x="3" y="2" width="2" height="4" fill="#c9962a"/></svg><b id="coinVal">0</b></div>
    <div class="chip full" id="holdChip" hidden title="Your hold is full"><span class="lbl">Hold full</span><span id="holdVal">0/8</span></div>
    <div class="chip" id="wChip" hidden title="Weight in your boat's hold"><span class="lbl">Load</span><span id="wVal">0/30 lb</span></div>
    <div class="chip threat" id="threatChip" hidden title="Saltwight hits left"><span class="lbl">Saltwight</span><span class="pips" id="threatVal"></span></div>
    <div class="chip gunchip" id="gunChip" hidden title="Revolver ammo"><img src="" alt="" id="ammoIcon"><span class="cyl" id="cylPips"></span><span id="ammoVal"></span><span class="rbar" aria-label="Reloading"><i id="rbarFill"></i></span></div>
    <div class="chip" id="clockChip" hidden title="Time of day. Some rare fish only appear at certain times."><span class="cico" id="clockIco"></span><span class="lbl" id="clockName">Morning</span><span id="clockVal">8:00 AM</span></div>
    <div class="chip" id="depthChip" hidden title="Water depth and lure"><span class="lbl" id="depthLbl">Water</span><span id="depthVal">dry</span></div>
  </div>

  <div class="hud" id="hudR">
    <button class="btn ghost" id="btnSail" title="Return to sailing (Esc)">Return to sail <kbd>Esc</kbd></button>
    <button class="ibtn" id="btnInv" aria-label="Open inventory (I)" title="Inventory (I): coins, time, hold">
      <svg viewBox="0 0 11 11"><rect x="3" y="1" width="5" height="1" fill="#efe3c8"/><rect x="2" y="2" width="1" height="2" fill="#efe3c8"/><rect x="8" y="2" width="1" height="2" fill="#efe3c8"/><rect x="1" y="4" width="9" height="6" fill="#c98a4b"/><rect x="1" y="4" width="9" height="1" fill="#e8b06e"/><rect x="4" y="6" width="3" height="2" fill="#6b4422"/></svg><kbd>I</kbd></button>
    
    <button class="ibtn" id="btnAdmin" aria-label="Open settings and admin (G)" title="Settings and admin (G)">
      <svg viewBox="0 0 11 11"><rect x="4" y="0" width="3" height="11" fill="#b3a98f"/><rect x="0" y="4" width="11" height="3" fill="#b3a98f"/><rect x="1" y="1" width="2" height="2" fill="#b3a98f"/><rect x="8" y="1" width="2" height="2" fill="#b3a98f"/><rect x="1" y="8" width="2" height="2" fill="#b3a98f"/><rect x="8" y="8" width="2" height="2" fill="#b3a98f"/><rect x="2" y="2" width="7" height="7" fill="#efe3c8"/><rect x="4" y="4" width="3" height="3" fill="#0f2236"/></svg><kbd>G</kbd></button>
    <div id="miniWrap"><canvas id="mini" width="132" height="132" aria-label="Mini-map"></canvas><div class="minilbl" id="miniLbl">Chart</div></div>
  </div>

  <div id="gauge" aria-hidden="true">
    <div class="glabel">Tension</div>
    <div class="gbar"><div class="gfill" id="gfill"></div><div class="gmark" style="bottom:60%"></div><div class="gmark" style="bottom:85%"></div></div>
    <div class="glabel"><span id="gDepth">0 ft deep</span><br><span id="gLine">0 ft out</span><br><span id="slack">Slack!</span></div>
  </div>

  <div id="actions"></div>
  <div id="tools">
    <button class="tool" id="toolBtn" aria-haspopup="dialog"><img alt=""><kbd>Q</kbd><span class="badge" id="toolBadge" hidden>0</span></button>
  </div>
  <button class="btn" id="strikeBtn" hidden>Strike! <kbd>Space</kbd></button>
  <div id="landPad" aria-label="Island controls"><button class="pad wide" id="padReload2">Reload</button><button class="pad big" id="padJump">Jump</button></div>
  <div id="touchPad" aria-label="Depth controls">
    <button class="pad wide" id="padReel">Reel in</button>
    <button class="pad wide" id="padReload" hidden>Reload</button>
    <button class="pad wide" id="padAmmo" hidden>Cells</button>
    <button class="pad" id="padUp" aria-label="Shallower">▲</button>
    <button class="pad" id="padDown" aria-label="Deeper">▼</button>
  </div>
  <div id="hint" role="status" aria-live="polite"></div>
  <div id="toast" role="status" aria-live="assertive"></div>
</div>

<!-- Map size -->
<dialog id="mapDlg" aria-labelledby="mapTitle">
  <div class="dh"><h2 id="mapTitle">Choose your waters</h2></div>
  <div class="db">
    <p style="margin:0 0 14px;color:var(--bone-dim);font-size:13px;line-height:1.55">Every map is generated fresh. You start in the shallows beside the harbor, and the water gets deeper the farther you sail.</p>
    <div class="sizes">
      <button class="size" data-size="small"><svg viewBox="0 0 30 10"><rect width="30" height="10" fill="#1f6499"/><rect x="12" y="3" width="6" height="4" fill="#3aa9bf"/><rect x="14" y="4" width="2" height="2" fill="#77b25c"/></svg><strong>Small</strong><span>A tight cluster of islands. Water reaches about 200 ft at the edges.</span></button>
      <button class="size" data-size="medium"><svg viewBox="0 0 30 10"><rect width="30" height="10" fill="#16457b"/><rect x="8" y="2" width="14" height="6" fill="#1f6499"/><rect x="12" y="3" width="6" height="4" fill="#3aa9bf"/><rect x="14" y="4" width="2" height="2" fill="#77b25c"/><rect x="9" y="3" width="1" height="1" fill="#77b25c"/></svg><strong>Medium</strong><span>Longer voyages and deep sea past 350 ft.</span></button>
      <button class="size" data-size="large"><svg viewBox="0 0 30 10"><rect width="30" height="10" fill="#020409"/><rect x="4" y="1" width="22" height="8" fill="#16457b"/><rect x="8" y="2" width="14" height="6" fill="#1f6499"/><rect x="12" y="3" width="6" height="4" fill="#3aa9bf"/><rect x="14" y="4" width="2" height="2" fill="#77b25c"/><rect x="6" y="7" width="1" height="1" fill="#77b25c"/></svg><strong>Large</strong><span>A sprawling archipelago. Sail far enough and the bottom disappears.</span></button>
    </div>
  </div>
</dialog>

<!-- Catch -->
<dialog id="catchDlg" aria-labelledby="cName">
  <div class="catch">
    <div class="pad"><span class="new" id="cNew" hidden>New species</span><img id="cImg" alt=""></div>
    <h2 id="cName">Fish</h2>
    <div id="cRar" class="r0">Common</div>
    <dl>
      <div><dt>Weight</dt><dd id="cW">0 lb</dd></div>
      <div><dt>Value</dt><dd id="cV">0</dd></div>
      <div><dt>Depth</dt><dd id="cD">0 ft</dd></div>
    </dl>
    <p class="warn" id="cWarn" hidden></p>
    <div class="acts"><button class="btn ghost" id="cRelease">Release</button><button class="btn" id="cKeep">Keep in hold</button></div>
  </div>
</dialog>

<!-- Tool wheel -->
<dialog id="wheelDlg" aria-label="Choose a tool">
  <div class="wheel" id="wheel">
    <div class="wheel-center"><strong id="wheelName"></strong><span id="wheelInfo"></span></div>
  </div>
</dialog>

<!-- Net / dynamite haul -->
<dialog id="haulDlg" aria-labelledby="haulTitle">
  <div class="dh"><h2 id="haulTitle">Haul</h2></div>
  <div class="db"><div id="haulBody"></div><div style="display:flex;justify-content:flex-end;margin-top:14px"><button class="btn" id="haulDone">Back to fishing</button></div></div>
</dialog>

<!-- Inventory -->
<dialog id="invDlg" aria-labelledby="invTitle">
  <div class="dh"><h2 id="invTitle">Inventory</h2><button class="x" data-close aria-label="Close">✕</button></div>
  <div class="db" id="invBody"></div>
</dialog>

<!-- Shop -->
<div id="joy" hidden><i></i></div>
<div id="sleepFade" aria-hidden="true"><span></span></div>
<dialog id="shopDlg" aria-labelledby="shopTitle">
  <div class="dh"><h2 id="shopTitle">Harbor shop</h2><div class="flexw"><span class="price" id="shopCoins"></span><button class="x" data-close aria-label="Close">✕</button></div></div>
  <div class="tabs" role="tablist">
    <button class="tab" role="tab" data-tab="sell">Sell catch</button>
    <button class="tab" role="tab" data-tab="rod">Rods</button>
    <button class="tab" role="tab" data-tab="bait">Bait and lures</button>
    <button class="tab" role="tab" data-tab="boat">Boats</button>
    <button class="tab" role="tab" data-tab="tackle">Gear</button>
    <button class="tab" role="tab" data-tab="weapons">Weapons</button>
    <button class="tab" role="tab" data-tab="ammo">Ammo</button>
    <button class="tab" role="tab" data-tab="rest">Rest</button>
  </div>
  <div class="db" id="shopBody"></div>
</dialog>

<!-- Admin -->
<dialog id="adminDlg" aria-labelledby="admTitle">
  <div class="dh"><h2 id="admTitle">Settings and admin</h2><button class="x" data-close aria-label="Close">✕</button></div>
  <div class="db">
    <div class="flexw">
      <label class="lab"><input type="checkbox" id="optSound"> Sound effects</label>
      <label class="lab"><input type="checkbox" id="optShake"> Screen shake</label>
    </div>

    <div class="section">
      <h3 style="margin:0 0 4px;font-size:16px">Save file</h3>
      <p style="margin:0 0 10px;color:var(--bone-dim);font-size:12px;line-height:1.5">Your progress saves in this browser as you play. Save a copy to your computer so clearing browser data or switching browsers can't wipe it. In Chrome and Edge, the file keeps itself updated while you play.</p>
      <div class="flexw">
        <button class="btn sm" id="saveFile">Save to a file</button>
        <button class="btn ghost sm" id="loadFile">Load a save file</button>
        <button class="btn ghost sm" id="reconnectFile" hidden>Reconnect save file</button>
        <button class="btn danger sm" id="confirmLoad" hidden>Replace my progress with this file</button>
        <input type="file" id="loadInput" accept=".json,application/json" hidden>
      </div>
      <p id="saveStatus" role="status" style="margin:10px 0 0;font-size:12px;color:var(--bone-dim);line-height:1.5"></p>
    </div>

    <div class="section">
      <h3 style="margin:0 0 4px;font-size:16px">Time of day</h3>
      <p style="margin:0 0 10px;color:var(--bone-dim);font-size:12px;line-height:1.5">Drag to set the clock. A full day takes 15 real minutes.</p>
      <div class="f"><label for="admTime">Clock <output id="oTime"></output></label><input type="range" id="admTime" min="0" max="1439" step="10" value="480"></div>
    </div>

    <div class="section">
      <h3 style="margin:0 0 8px;font-size:16px">Admin tools</h3>
      <div class="flexw">
        <button class="btn ghost sm" id="admCoins">Add 1,000 coins</button>
        <button class="btn ghost sm" id="admSpawn">Spawn a random fish</button>
        <button class="btn ghost sm" id="admSummon">Summon the Saltwight</button>
        <button class="btn ghost sm" id="admUnlock">Unlock all gear</button>
        <button class="btn ghost sm" id="admReveal">Reveal the whole chart</button>
        <button class="btn ghost sm" id="admNewMap">Chart a new map</button>
        <button class="btn danger sm" id="admReset">Erase all progress</button>
      </div>
    </div>
  </div>
</dialog>

